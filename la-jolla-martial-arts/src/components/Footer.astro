---
const year = new Date().getFullYear();
---

<footer class="footer site-footer">
  <div class="footer-content">
    <div class="footer-logo">
      <img src="/assets/LJ-martial-arts-logo.PNG" alt="La Jolla Martial Arts" />
    </div>
    <div class="footer-info">
      <p class="footer-contact">
        <span>7680 Girard Ave, Basement, La Jolla, CA 92037</span>
        <span class="footer-sep" aria-hidden="true">•</span>
        <a href="tel:8583610961">(858) 361-0961</a>
        <span class="footer-sep" aria-hidden="true">•</span>
        <a href="mailto:LJBULLYPROOF@GMAIL.COM">LJBULLYPROOF@GMAIL.COM</a>
      </p>
      <p class="footer-copyright">© {year} La Jolla Martial Arts. All rights reserved.</p>
    </div>
    <div class="footer-social">
      <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.55l.38-2.97h-2.93V8.64c0-.86.24-1.45 1.48-1.45h1.58V4.53A21 21 0 0 0 14.27 4.4c-2.28 0-3.84 1.39-3.84 3.94v2.19H8v2.97h2.43V21z"/></svg>
      </a>
      <a href="https://lajollatkd.com/" target="_blank" rel="noopener" aria-label="Website">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
      </a>
    </div>
  </div>
</footer>

<style is:global>
  footer.site-footer {
    background: #141414;
    padding: 2.5rem 4rem;
    border-top: 1px solid #3a3a3a;
  }
  footer.site-footer .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  footer.site-footer .footer-logo {
    display: inline-flex;
    align-items: center;
  }
  footer.site-footer .footer-logo img {
    display: block;
    height: 64px;
    width: auto;
    object-fit: contain;
  }
  footer.site-footer .footer-info {
    text-align: center;
    flex: 1;
  }
  footer.site-footer .footer-info p {
    font-size: 0.8rem;
    color: #6B6B6B;
    line-height: 1.6;
  }
  footer.site-footer .footer-info a {
    color: #f5f5f0;
    text-decoration: none;
  }
  footer.site-footer .footer-info a:hover { color: #29BEE2; }
  footer.site-footer .footer-copyright { margin-top: 0.5rem; }
  footer.site-footer .footer-social {
    display: flex;
    gap: 0.75rem;
  }
  footer.site-footer .footer-social a {
    width: 40px;
    height: 40px;
    background: #3a3a3a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #f5f5f0;
    text-decoration: none;
    transition: background 0.3s ease;
  }
  footer.site-footer .footer-social a:hover { background: #29BEE2; }
  footer.site-footer .footer-social svg { width: 18px; height: 18px; }

  @media (max-width: 768px) {
    footer.site-footer {
      padding: 2.25rem 1.5rem 2.5rem;
    }
    footer.site-footer .footer-content {
      flex-direction: column;
      gap: 1.75rem;
      text-align: center;
    }
    footer.site-footer .footer-logo img {
      height: 56px;
    }
    footer.site-footer .footer-info {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    footer.site-footer .footer-info p {
      font-size: 0.82rem;
      line-height: 1.65;
    }
    footer.site-footer .footer-contact {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    footer.site-footer .footer-sep {
      display: none;
    }
    footer.site-footer .footer-copyright {
      margin-top: 0;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: #6B6B6B;
    }
    footer.site-footer .footer-social {
      gap: 0.9rem;
    }
  }
</style>
