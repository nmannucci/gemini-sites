---
/**
 * LpLayout — dedicated Google Ads PPC landing-page shell.
 * Mirrors the lajollatkd.com homepage design system (site-theme.css):
 * dark hero + light sections, cyan (#29BEE2) accent, Bebas Neue + Archivo, square corners.
 * Stripped: no site Nav, no Footer links. One CTA (free-week form / tap-to-call).
 * Reuses the live /api/lead pipeline; redirects to /thank-you (fires conversion).
 */
import '../styles/site-theme.css';

export interface Props {
  title: string;
  description: string;
  leadSource: string;
  ogImage?: string;
}
const { title, description, leadSource, ogImage = '/assets/EMA%20-%20Post.jpg' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,follow" />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <!-- Google tag (gtag.js) — same Google Ads ID as the main site -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18166558698"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18166558698');
    gtag('config', 'G-2G50L1RC7D');
  </script>

  <!-- PPC-specific pieces, built in the homepage's visual language -->
  <style is:global>
    /* Stripped header (replaces site nav) — not sticky; the promo banner sticks instead */
    .lp-header { position:relative; z-index:900; background:#fff;
      box-shadow:0 2px 20px rgba(0,0,0,.08); }
    .lp-header .inner { display:flex; align-items:center; justify-content:space-between;
      padding:0.6rem 2rem; max-width:1400px; margin:0 auto; }
    .lp-header img { height:46px; width:auto; display:block; }
    .lp-call { display:inline-flex; align-items:center; gap:0.55rem; background:var(--blood-red);
      color:var(--bone-white); padding:0.65rem 1.15rem; font-weight:700; text-transform:uppercase;
      letter-spacing:0.08em; font-size:0.8rem; transition:opacity .2s ease; }
    .lp-call:hover { opacity:0.9; }
    .lp-call .lab { display:flex; flex-direction:column; line-height:1.05; align-items:flex-start; }
    .lp-call .lab small { font-size:0.58rem; letter-spacing:0.12em; opacity:.85; }

    /* Section background helpers (match homepage: light / alt / dark) */
    .sec-light { background:var(--light-bg); color:var(--dark-text); }
    .sec-alt { background:var(--light-bg-alt); color:var(--dark-text); }
    .sec-dark { background:var(--off-black); color:var(--bone-white); }
    .sec-dark .section-title, .sec-dark .lp-head h2 { color:var(--bone-white); }
    .lp-head { text-align:center; max-width:760px; margin:0 auto 3rem; }
    .lp-head .section-label { display:block; }
    .lp-head p { color:var(--muted-text); margin-top:0.5rem; }
    .sec-dark .lp-head p { color:rgba(245,245,240,.7); }

    /* Card base (matches program/review cards: white, subtle border + shadow, square) */
    .lp-card { background:#fff; color:var(--dark-text); border:1px solid var(--light-bg-alt);
      box-shadow:0 8px 28px rgba(0,0,0,.06); padding:1.75rem; }

    /* Us vs Them */
    .lp-vs { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; max-width:1000px; margin:0 auto; }
    .lp-vs h3 { font-family:'Bebas Neue',sans-serif; font-size:1.6rem; text-transform:uppercase; margin-bottom:1rem; letter-spacing:0.02em; }
    .lp-vs ul { list-style:none; }
    .lp-vs li { display:flex; gap:0.6rem; align-items:flex-start; padding:0.55rem 0; font-size:0.98rem;
      border-top:1px solid rgba(0,0,0,.07); }
    .lp-vs li:first-of-type { border-top:none; }
    .lp-vs .ic { flex:none; width:21px; height:21px; margin-top:1px; }
    .lp-vs .them { border-top:3px solid #c0392b; }
    .lp-vs .us { border-top:3px solid var(--blood-red); }
    .lp-vs .them .ic { color:#c0392b; } .lp-vs .us .ic { color:var(--blood-red); }

    /* Steps */
    .lp-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
    .lp-step .n { font-family:'Bebas Neue',sans-serif; font-size:3rem; line-height:1; color:var(--blood-red); }
    .lp-step h3 { font-family:'Bebas Neue',sans-serif; font-size:1.5rem; text-transform:uppercase; margin:0.4rem 0 0.4rem; letter-spacing:0.02em; }
    .lp-step p { color:var(--muted-text); font-size:0.96rem; }

    /* Feature cards */
    .lp-features { display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
    .lp-feature .ci { width:48px; height:48px; background:var(--blood-red); color:#fff;
      display:flex; align-items:center; justify-content:center; margin-bottom:0.9rem; }
    .lp-feature h3 { font-family:'Bebas Neue',sans-serif; font-size:1.45rem; text-transform:uppercase; letter-spacing:0.02em; }
    .lp-feature p { color:var(--muted-text); font-size:0.94rem; margin-top:0.3rem; }

    /* Why us (stat-style, on dark) */
    .lp-why { display:grid; grid-template-columns:repeat(5,1fr); gap:1.5rem; text-align:center; }
    .lp-why .ic { color:var(--blood-red); margin:0 auto 0.6rem; }
    .lp-why .big { font-family:'Bebas Neue',sans-serif; font-size:2.4rem; line-height:1; }
    .lp-why .lab { color:rgba(245,245,240,.7); font-size:0.84rem; margin-top:0.3rem; }

    /* FAQ */
    .lp-faq { max-width:800px; margin:0 auto; }
    .lp-faq details { background:#fff; border:1px solid var(--light-bg-alt); margin-bottom:0.6rem; padding:0 1.25rem; }
    .lp-faq summary { list-style:none; cursor:pointer; padding:1.1rem 0; font-weight:700; font-size:1.02rem;
      display:flex; justify-content:space-between; gap:1rem; align-items:center; color:var(--dark-text); }
    .lp-faq summary::-webkit-details-marker { display:none; }
    .lp-faq summary .pl { color:var(--blood-red); font-size:1.5rem; line-height:1; flex:none; }
    .lp-faq details[open] summary .pl { transform:rotate(45deg); }
    .lp-faq p { color:var(--muted-text); padding:0 0 1.1rem; font-size:0.96rem; }

    /* Final CTA grid */
    .lp-final { display:grid; grid-template-columns:1.05fr 0.95fr; gap:3rem; align-items:center; max-width:1100px; margin:0 auto; }
    .lp-final .pts { list-style:none; margin-top:1.2rem; }
    .lp-final .pts li { display:flex; gap:0.6rem; align-items:center; padding:0.55rem 0; font-size:1.05rem;
      border-top:1px solid rgba(255,255,255,.12); }
    .lp-final .pts li:first-child { border-top:none; }
    .lp-final .pts .ic { color:var(--blood-red); flex:none; }

    /* Form error + tracking */
    .form-err { display:none; margin-top:0.7rem; padding:0.6rem 0.75rem; background:rgba(192,57,43,.1);
      border-left:3px solid #c0392b; color:#902319; font-size:0.82rem; }
    .or-call { text-align:center; margin-top:0.8rem; font-size:0.88rem; color:var(--muted-text); }
    .or-call a { color:var(--blood-red); font-weight:700; }

    /* Stripped footer */
    .lp-footer { background:var(--deep-black); color:rgba(245,245,240,.6); padding:2.25rem 2rem; font-size:0.85rem; text-align:center; }
    .lp-footer a { color:rgba(245,245,240,.85); text-decoration:underline; }
    .lp-footer .row { display:flex; gap:1.2rem; justify-content:center; flex-wrap:wrap; margin-bottom:0.6rem; }

    /* Gallery: reserve row height so lazy images don't collapse / cause CLS */
    .gallery-grid { grid-auto-rows:240px; }
    .gallery-grid .gallery-item img { width:100%; height:100%; object-fit:cover; }

    /* Anchor scroll offset under the sticky banner + nav (desktop) */
    [id] { scroll-margin-top:104px; }

    /* ── CTA color: orange buttons complementing the cyan brand ── */
    :root { --orange:#FF6A1A; --orange-dark:#E2560A; }
    .form-submit { background:var(--orange) !important; }
    .form-submit:hover { background:var(--orange-dark) !important; }
    .btn-primary { background:var(--orange) !important; }
    .btn-primary:hover { background:var(--orange-dark) !important; }

    /* Larger, more readable hero form */
    .hero-form-badge { font-size:0.72rem; padding:0.42rem 0.78rem; }
    .hero-form-title { font-size:2.1rem; }
    .hero-form-subtitle { font-size:0.98rem; line-height:1.5; }
    .hero-form .form-label { font-size:0.8rem; }
    .hero-form .form-input, .hero-form .form-select { font-size:0.95rem; padding:0.95rem; }
    .hero-form .form-submit { font-size:0.9rem; padding:1.1rem; }

    /* Red urgency tag on the form: "respond in under 60 seconds" */
    .resp-tag { display:inline-flex; align-items:center; gap:0.4rem; background:#D8232A; color:#fff;
      font-weight:800; text-transform:uppercase; letter-spacing:0.03em; font-size:0.78rem;
      padding:0.45rem 0.75rem; margin:0.15rem 0 0.7rem; }
    .resp-tag [data-lucide] { width:15px; height:15px; }

    /* Mobile-only hero photo (hidden on desktop; desktop uses the background image) */
    .hero-photo-mobile { display:none; }

    /* Heavier callout/tagline above the headline */
    .hero .tagline { font-weight:800; }

    /* Desktop hero: trim the homepage's tall top padding (it was clearing a fixed nav) */
    .hero-container { padding-top:3.5rem; padding-bottom:4rem; }

    /* Promo banner */
    /* Desktop: banner + nav stick together. Mobile (below): banner only. */
    .lp-topstick { position:sticky; top:0; z-index:1100; }
    .promo-banner { background:var(--blood-red); color:#fff; text-align:center; font-weight:700;
      text-transform:uppercase; letter-spacing:0.07em; font-size:0.82rem; padding:0.55rem 1rem; }
    .promo-banner strong { font-weight:800; }

    /* Utility strip above header (address + phone) */
    .util-strip { background:var(--off-black); color:rgba(245,245,240,.82); font-size:0.8rem; }
    .util-strip .inner { max-width:1400px; margin:0 auto; padding:0.45rem 2rem; display:flex;
      justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; }
    .util-strip a { color:rgba(245,245,240,.92); }
    .util-strip .it { display:inline-flex; align-items:center; gap:0.4rem; }
    .util-strip .it [data-lucide] { width:15px; height:15px; color:var(--blood-red); }

    /* Header schedule CTA */
    .lp-header .actions { display:flex; align-items:center; gap:0.6rem; }
    .lp-sched { display:inline-flex; align-items:center; gap:0.45rem; background:var(--orange); color:#fff;
      padding:0.75rem 1.35rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; font-size:0.85rem; }
    .lp-sched:hover { background:var(--orange-dark); }

    /* Benefits / why martial arts */
    .benefits-wrap { max-width:980px; margin:0 auto; }
    .benefits-lead { font-size:1.12rem; line-height:1.75; color:var(--dark-text); margin-bottom:1rem; }
    .sec-dark .benefits-lead { color:rgba(245,245,240,.85); }
    .benefits-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.4rem 2rem; margin-top:1.4rem; list-style:none; }
    .benefits-grid li { display:flex; gap:0.6rem; align-items:flex-start; padding:0.55rem 0; }
    .benefits-grid .ic { color:var(--blood-red); flex:none; width:22px; height:22px; margin-top:1px; }

    /* Map embed */
    .map-wrap { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1.25fr; gap:1.75rem; align-items:center; }
    .map-card { border:1px solid var(--light-bg-alt); box-shadow:0 10px 30px rgba(0,0,0,.08); overflow:hidden; background:#fff; }
    .map-card iframe { display:block; width:100%; height:380px; border:0; }
    .map-info h3 { font-family:'Bebas Neue',sans-serif; font-size:1.9rem; text-transform:uppercase; letter-spacing:0.02em; }
    .map-info .it { display:flex; gap:0.55rem; align-items:flex-start; padding:0.4rem 0; }
    .map-info .it .ic { color:var(--blood-red); flex:none; margin-top:2px; }
    .map-info .it span { color:var(--muted-text); }

    /* Reviews expander + widget */
    .reviews-extra { display:none; }
    .reviews-extra.open { display:grid; }
    .reviews-more { text-align:center; margin-top:1.6rem; }
    .reviews-more button { background:var(--off-black); color:#fff; border:none; cursor:pointer;
      padding:0.85rem 1.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; font-size:0.8rem; }
    .reviews-widget { max-width:1040px; margin:1.6rem auto 0; }

    /* Mobile sticky call bar */
    .call-bar { display:none; }
    @media (max-width:820px) {
      .lp-topstick { position:static; }
      .promo-banner { position:sticky; top:0; z-index:1100; }
      [id] { scroll-margin-top:56px; }
      .lp-vs, .lp-steps, .lp-features, .lp-final, .benefits-grid, .map-wrap { grid-template-columns:1fr; }
      .lp-why { grid-template-columns:1fr 1fr; }
      .gallery-grid { grid-template-columns:1fr 1fr; grid-auto-rows:160px; }
      .gallery-grid .gallery-item--wide { grid-column:span 2; }
      .section { padding:3.25rem 1.25rem; }

      /* Hero on mobile: headline + offer (solid bg) → photo → form */
      .hero { min-height:auto; align-items:flex-start; padding:0; background:#fff; color:var(--dark-text); }
      .hero-background { display:none; }
      .hero-container { padding:2.75rem 1.25rem 2rem; }
      .hero .tagline { margin:0 0 1rem; color:var(--orange); }
      .hero-title { line-height:1.05; margin-bottom:1.3rem; color:var(--dark-text); }
      .hero-title .accent { color:var(--orange); }
      .hero-subtitle { margin-bottom:0.7rem; line-height:1.6; color:var(--dark-text); }
      .hero .stats { margin-top:1.85rem; padding-top:1.85rem; gap:1.5rem 2rem; border-top-color:rgba(0,0,0,.12); }
      .hero .stat-item h3 { color:var(--orange); }
      .hero .stat-item p { color:var(--muted-text); }
      .hero-photo-mobile { display:block; margin-top:1.85rem; }
      .hero-photo-mobile img { width:100%; height:240px; object-fit:cover; object-position:center top; }
      .hero-right { margin-top:1.6rem; }

      .lp-header .inner { padding:0.55rem 1rem; }
      .lp-header img { height:40px; }
      .lp-sched { font-size:0.72rem; padding:0.6rem 0.9rem; gap:0.35rem; }
      .lp-call .lab small { display:none; }

      /* Sticky bottom bar: extra bottom padding + iOS safe area so corners aren't cut off */
      body { padding-bottom:calc(90px + env(safe-area-inset-bottom)); }
      .call-bar { display:flex; gap:0.6rem; position:fixed; left:0; right:0; bottom:0; z-index:1200;
        background:#fff; box-shadow:0 -4px 16px rgba(0,0,0,.18);
        padding:0.6rem 0.9rem calc(0.6rem + env(safe-area-inset-bottom)); }
      .call-bar a { flex:1; display:flex; align-items:center; justify-content:center; gap:0.4rem;
        color:#fff; font-weight:800; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.02em; padding:0.95rem 0.5rem; }
      .call-bar .cb-sched { background:var(--orange); }
      .call-bar .cb-call { background:var(--off-black); }
    }
    @media (max-width:520px) { .lp-why { grid-template-columns:1fr; } }
  </style>
</head>
<body data-lead-source={leadSource}>
  <slot />

  <div class="call-bar">
    <a href="#schedule" class="cb-sched"><i data-lucide="calendar"></i> See Schedule</a>
    <a href="tel:8583610961" data-call-cta class="cb-call"><i data-lucide="phone"></i> Call</a>
  </div>

  <script is:inline>
    if (window.lucide) lucide.createIcons();

    // Capture gclid + UTM into hidden fields
    (function () {
      var p = new URLSearchParams(window.location.search);
      ['gclid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) {
        var v = p.get(k); if (!v) return;
        document.querySelectorAll('input[name="' + k + '"]').forEach(function (el) { el.value = v; });
      });
    })();

    // Lead form: POST /api/lead, fold tracking into message, redirect to /thank-you
    (function () {
      var src = document.body.getAttribute('data-lead-source') || window.location.pathname;
      document.querySelectorAll('form[data-lead-form]').forEach(function (form) {
        var btn = form.querySelector('button[type="submit"], .form-submit');
        var orig = btn ? btn.textContent : '';
        var err = form.querySelector('.form-err');
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          if (err) { err.style.display='none'; err.textContent=''; }
          if (!form.checkValidity()) { form.reportValidity(); return; }
          var d = Object.fromEntries(new FormData(form).entries());
          var track = ['gclid','utm_source','utm_medium','utm_campaign','utm_term','utm_content']
            .map(function (k){ return d[k] ? k + '=' + d[k] : null; }).filter(Boolean).join('; ');
          var body = {
            firstName: d.firstName, lastName: d.lastName, email: d.email, phone: d.phone,
            program: d.program || 'kids', source: src,
            message: 'PPC landing page: ' + src + (track ? ' | ' + track : '')
          };
          if (btn) { btn.disabled=true; btn.textContent='Sending…'; }
          try {
            var res = await fetch('/api/lead', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
            var j = await res.json().catch(function(){return {};});
            if (!res.ok || !j.ok) throw new Error(j.error || 'Something went wrong. Please call (858) 361-0961.');
            window.location.href = '/thank-you';
          } catch (ex) {
            if (err) { err.textContent = ex.message || 'Network error. Please try again.'; err.style.display='block'; }
            if (btn) { btn.disabled=false; btn.textContent=orig; }
          }
        });
      });
    })();

    // Tap-to-call conversion hook (paste your call-conversion label to enable)
    // window.__CALL_CONV = 'AW-18166558698/XXXXXXXX';
    (function () {
      document.querySelectorAll('a[data-call-cta], a[href^="tel:"]').forEach(function (a) {
        a.addEventListener('click', function () {
          if (window.__CALL_CONV && typeof gtag === 'function') gtag('event', 'conversion', { send_to: window.__CALL_CONV });
        });
      });
    })();
  </script>
  <slot name="scripts" />
</body>
</html>
