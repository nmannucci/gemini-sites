---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  programPageCss?: boolean;
  bodyClass?: string;
}

const {
  title = 'La Jolla Martial Arts | Learn Taekwondo Martial Arts in La Jolla, California',
  description = "La Jolla Martial Arts offers world-class Taekwondo training for all ages. Build discipline, confidence, and self-defense skills at our family-owned dojo with 40+ years of teaching experience.",
  canonical,
  ogImage = '/assets/EMA%20-%20Post.jpg',
  ogType = 'website',
  programPageCss = false,
  bodyClass,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://lajollatkd.com').toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={canonicalUrl} />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://lajollatkd.com').toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://lajollatkd.com').toString()} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet" />
  {programPageCss && <link rel="stylesheet" href="/program-page.css" />}
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18166558698"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18166558698');
    gtag('config', 'G-2G50L1RC7D');
</script>

  <slot name="head" />
</head>
<body class={bodyClass}>
  <Nav />
  <slot />
  <Footer />

  <script is:inline>
    // Initialize Lucide icons
    if (window.lucide) lucide.createIcons();

    // Scroll behavior for nav
    const nav = document.getElementById('nav');
    if (nav) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 100) nav.classList.add('scrolled');
        else nav.classList.remove('scrolled');
      });
    }
  </script>

  <script is:inline>
    /* Robust in-page anchor scrolling.
       The page has late-loading sections below the fold (the reviews iframe,
       which sets its own height after load, and lazy gallery images). A plain
       hash jump lands on the target's pre-shift position, then those sections
       expand and push the target away — leaving you stranded in reviews/gallery.
       This animates to the target while RECOMPUTING its position every frame,
       then keeps it pinned for a short settle window as content loads in. */
    (function () {
      var navEl = document.getElementById('nav');
      function navOffset() {
        // Fixed nav overlays content; offset so the target heading isn't hidden.
        return (navEl ? navEl.offsetHeight : 0) + 12;
      }
      function targetY(el) {
        return window.scrollY + el.getBoundingClientRect().top - navOffset();
      }
      function clamp(y) {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        return Math.max(0, Math.min(y, max));
      }
      function ease(t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }

      var cancelActive = null;

      function scrollToEl(el) {
        if (cancelActive) cancelActive();

        var startY = window.scrollY;
        var startTime = null;
        var settleStart = null;
        var interrupted = false;
        var DURATION = 550;   // animate to target
        var SETTLE = 1800;    // then hold the target as the page settles

        function onUserScroll() { interrupted = true; }
        function onKey(e) {
          if (['ArrowUp','ArrowDown','PageUp','PageDown','Home','End',' ','Spacebar'].indexOf(e.key) !== -1) interrupted = true;
        }
        window.addEventListener('wheel', onUserScroll, { passive: true });
        window.addEventListener('touchstart', onUserScroll, { passive: true });
        window.addEventListener('keydown', onKey);

        function cleanup() {
          window.removeEventListener('wheel', onUserScroll);
          window.removeEventListener('touchstart', onUserScroll);
          window.removeEventListener('keydown', onKey);
          cancelActive = null;
        }
        cancelActive = function () { interrupted = true; cleanup(); };

        function go(y) { window.scrollTo({ top: clamp(y), behavior: 'auto' }); }

        function frame(ts) {
          if (interrupted) return cleanup();
          if (startTime === null) startTime = ts;
          var t = Math.min(1, (ts - startTime) / DURATION);
          var dest = targetY(el); // recomputed each frame absorbs shifts mid-animation
          go(startY + (dest - startY) * ease(t));
          if (t < 1) { requestAnimationFrame(frame); return; }
          if (settleStart === null) settleStart = ts;
          if (Math.abs(window.scrollY - dest) > 2) go(dest); // re-pin as content loads
          if (ts - settleStart < SETTLE) requestAnimationFrame(frame);
          else cleanup();
        }
        requestAnimationFrame(frame);
      }

      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="#"]');
        if (!a) return;
        var hash = a.getAttribute('href');
        if (!hash || hash === '#' || hash.length < 2) return;
        var el;
        try { el = document.querySelector(hash); } catch (_) { return; }
        if (!el) return;
        e.preventDefault();

        // Close the mobile menu if the tapped link lives inside it.
        var toggle = document.querySelector('.nav-toggle');
        var menu = document.getElementById('mobileMenu');
        if (toggle && menu && menu.getAttribute('data-open') === 'true') {
          toggle.setAttribute('aria-expanded', 'false');
          menu.setAttribute('data-open', 'false');
        }

        if (window.history && history.pushState) history.pushState(null, '', hash);
        scrollToEl(el);
      });
    })();
  </script>
  <script is:inline>
    (function () {
      var t = document.querySelector('.nav-toggle');
      var m = document.getElementById('mobileMenu');
      if (!t || !m) return;
      t.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = t.getAttribute('aria-expanded') === 'true';
        t.setAttribute('aria-expanded', String(!open));
        m.setAttribute('data-open', String(!open));
      });
      m.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          t.setAttribute('aria-expanded', 'false');
          m.setAttribute('data-open', 'false');
        });
      });
      document.addEventListener('click', function (e) {
        if (!t.contains(e.target) && !m.contains(e.target) && m.getAttribute('data-open') === 'true') {
          t.setAttribute('aria-expanded', 'false');
          m.setAttribute('data-open', 'false');
        }
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var forms = document.querySelectorAll('form[data-lead-form]');
      if (!forms.length) return;

      var SUCCESS_HTML =
        '<div style="text-align:center;padding:2.25rem 1rem 1.5rem;">' +
          '<div style="width:60px;height:60px;margin:0 auto 1.1rem;border-radius:50%;background:rgba(41,190,226,0.12);border:1.5px solid #29BEE2;display:flex;align-items:center;justify-content:center;color:#29BEE2;">' +
            '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' +
          '</div>' +
          '<h3 style="font-family:\'Bebas Neue\',sans-serif;font-size:1.9rem;text-transform:uppercase;letter-spacing:0.02em;color:#1a1a1a;margin:0 0 0.55rem;">You\'re All Set</h3>' +
          '<p style="font-size:0.95rem;color:#5A5A5A;line-height:1.55;max-width:360px;margin:0 auto;">Thanks — we got your free trial request. Our team will reach out within one business day to get you scheduled.</p>' +
        '</div>';

      forms.forEach(function (form) {
        if (form.dataset.leadBound === '1') return;
        form.dataset.leadBound = '1';

        var submitBtn = form.querySelector('button[type="submit"], .form-submit');
        var originalLabel = submitBtn ? submitBtn.textContent : '';

        var errorBox = document.createElement('div');
        errorBox.setAttribute('role', 'alert');
        errorBox.style.cssText = 'display:none;margin-top:0.85rem;padding:0.7rem 0.85rem;background:rgba(220,50,50,0.08);border-left:3px solid #DC3232;color:#8a1f1f;font-size:0.8rem;line-height:1.45;';
        if (submitBtn && submitBtn.parentNode) {
          submitBtn.parentNode.insertBefore(errorBox, submitBtn.nextSibling);
        } else {
          form.appendChild(errorBox);
        }

        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          errorBox.textContent = '';
          errorBox.style.display = 'none';

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          var data = Object.fromEntries(new FormData(form).entries());
          if (!data.source) {
            data.source = form.dataset.leadSource || window.location.pathname;
          }

          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

          try {
            var res = await fetch('/api/lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            var payload = await res.json().catch(function () { return {}; });
            if (!res.ok || !payload.ok) {
              throw new Error(payload.error || 'Something went wrong. Please try again or call (858) 361-0961.');
            }

            form.innerHTML = SUCCESS_HTML;
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } catch (err) {
            errorBox.textContent = (err && err.message) || 'Network error. Please try again.';
            errorBox.style.display = 'block';
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
          }
        });
      });
    })();
  </script>

  <slot name="scripts" />
</body>
</html>
