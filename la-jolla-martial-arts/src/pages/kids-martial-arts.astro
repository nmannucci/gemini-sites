---
import Layout from '../layouts/Layout.astro';
import ScheduleMobile from '../components/ScheduleMobile.astro';

// TODO: confirm typical drive times from Clairemont, Bay Ho, Pacific Beach, Bay Park, and UTC/University City to 7680 Girard Ave, Basement before publishing minute estimates.
const kidsFaqs = [
  {
    question: 'Can martial arts help if my child is out of control?',
    answer: 'Yes. Self-control is a core part of martial arts training. Kids practice listening, regulating their actions, and learning that discipline helps them succeed both on and off the mat.',
  },
  {
    question: 'Will martial arts make my child more aggressive?',
    answer: 'No. The program teaches self-defense, respect, and restraint. Kids learn that violence is not the answer and that confidence should help them avoid conflict, not seek it out.',
  },
  {
    question: 'What if my child does not like traditional sports?',
    answer: 'Martial arts often works well for kids who do not connect with team sports. It is active and challenging, but it also feels personal, skill-based, and motivating in a different way.',
  },
  {
    question: 'What school-related skills can martial arts build?',
    answer: 'Training reinforces focus, discipline, patience, self-control, and respect. Those habits can support better classroom behavior, stronger effort, and more confidence when school feels challenging.',
  },
  {
    question: 'What if my child is not physically coordinated?',
    answer: 'That is completely okay. Kids start at different levels, and instructors help them improve balance, coordination, and control step by step in a supportive environment.',
  },
  {
    question: 'Can martial arts help my child believe in themselves?',
    answer: 'Yes. Small wins matter. As kids learn techniques, handle challenges, and earn progress, they start to trust themselves more and carry that confidence into other parts of life.',
  },
  {
    question: 'What ages is kids martial arts in La Jolla for?',
    answer: 'Weekday Kids Martial Arts is for ages 7–12, Monday through Thursday from 4:30pm to 5:15pm. Children ages 3–6 train in Little Ninjas. Teens ages 13 and up train in the evening class. Saturday from 9:00am to 9:45am is a mixed-age class for ages 3–12.',
  },
  {
    question: 'Do you teach kids karate or kids taekwondo in La Jolla?',
    answer: 'La Jolla Martial Arts teaches Taekwondo. We do not run a separate karate curriculum. Parents searching for kids karate in La Jolla usually want beginner martial arts for children, and that is what the Kids Martial Arts class is: Taekwondo basics, focus, respect, and self-defense for ages 7–12.',
  },
  {
    question: 'Can my child start kids martial arts as a beginner?',
    answer: 'Yes. Beginners are welcome in the first class, and no experience is required. Start with a free week so you can see the kids class before you decide.',
  },
  {
    question: 'How do families from Clairemont, Pacific Beach, Bay Ho, Bay Park, and University City get to class?',
    answer: 'Everyone trains at the La Jolla studio, 7680 Girard Ave, Basement, La Jolla, CA 92037. Families come from Clairemont, Bay Ho, Pacific Beach, Bay Park, UTC and University City, and other parts of San Diego. The weekday kids class is after school, and Saturday morning is another option. Call (858) 361-0961 if you want help choosing a class time.',
  },
  {
    question: 'What is the kids martial arts schedule in La Jolla?',
    answer: 'Kids Martial Arts meets Monday through Thursday from 4:30pm to 5:15pm. Friday is private lessons by appointment. Saturday from 9:00am to 9:45am is a mixed Little Ninjas and Kids class for ages 3–12. Sunday is closed.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: kidsFaqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer,
    },
  })),
};
---

<Layout
  title={`Kids Martial Arts in La Jolla | Taekwondo for Ages 7–12`}
  description={`Kids martial arts and kids taekwondo in La Jolla for ages 7–12. Beginner classes for parents comparing kids karate. Free week at 7680 Girard Ave.`}
  canonical={`https://lajollatkd.com/kids-martial-arts`}
  ogImage={`/assets/ema-post-2-optimized.webp`}
  programPageCss
>
  <Fragment slot="head">
<style is:global>

    .hero-media img {
      object-fit: cover !important;
      object-position: center !important;
    }
    .hero-media::after {
      background:
        linear-gradient(
          100deg,
          rgba(8, 8, 8, 0.95) 0%,
          rgba(8, 8, 8, 0.85) 45%,
          rgba(8, 8, 8, 0.6) 75%,
          rgba(8, 8, 8, 0.45) 100%
        ) !important;
    }

    .hero-copy {
      max-width: 820px;
    }

    .hero-title {
      font-size: clamp(3.75rem, 8vw, 6.4rem);
    }

    .hero-title span {
      display: block;
    }

    .hero-subtitle {
      padding: 0.95rem 1.25rem;
      font-size: 0.95rem;
      margin-top: 1.2rem;
      margin-bottom: 0.85rem;
    }

    .hero-details {
      margin-top: 2.65rem;
    }

    .hero-benefits {
      gap: 1rem;
    }

    .hero-benefits li {
      grid-template-columns: 20px minmax(0, 1fr);
      column-gap: 1rem;
    }

    .hero-benefits strong {
      font-size: 1.18rem;
      font-weight: 700;
      line-height: 1.4;
      color: rgba(255, 255, 255, 0.98);
      text-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    }

    .hero-benefits span {
      display: none;
    }

    .hero-actions {
      margin-top: 3.4rem;
      gap: 1.1rem;
    }

    .btn-primary,
    .btn-secondary {
      padding: 1.1rem 1.95rem;
      font-size: 0.9rem;
    }

    .section-title .program-highlight {
      color: var(--blood-red);
      -webkit-text-stroke: 0;
    }

    .schedule-section {
      overflow: hidden;
    }

    .schedule-head {
      margin-bottom: 2rem;
    }

    .schedule-board {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(245, 245, 240, 0.94));
      border: 1px solid rgba(20, 20, 20, 0.08);
      box-shadow: 0 24px 60px rgba(10, 10, 10, 0.1);
      padding: 1rem;
    }

    .schedule-board-scroll {
      overflow-x: auto;
    }

    .schedule-grid {
      min-width: 980px;
      display: grid;
      grid-template-columns: 180px repeat(7, minmax(112px, 1fr));
      gap: 0.85rem;
    }

    .schedule-corner,
    .schedule-day,
    .schedule-time,
    .schedule-slot {
      min-height: 104px;
      padding: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .schedule-corner,
    .schedule-day {
      min-height: 72px;
      font-family: "Bebas Neue", sans-serif;
      font-size: 1.05rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .schedule-corner {
      background: #ecebe7;
      color: var(--dark-text);
    }

    .schedule-day {
      background: var(--blood-red);
      color: var(--bone-white);
    }

    .schedule-time {
      background: #ecebe7;
      color: var(--dark-text);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.3;
    }

    .schedule-slot {
      position: relative;
      background: rgba(234, 234, 229, 0.6);
      border: 1px solid rgba(20, 20, 20, 0.05);
      color: var(--dark-text);
    }

    .schedule-slot strong {
      display: block;
      font-family: "Bebas Neue", sans-serif;
      font-size: 1.35rem;
      line-height: 1;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    .schedule-slot span {
      display: block;
      font-size: 0.82rem;
      line-height: 1.45;
      color: rgba(26, 26, 26, 0.78);
    }

    .schedule-slot--live {
      background: linear-gradient(180deg, #d8f3ef, #b8ebe3);
      border-color: rgba(15, 118, 110, 0.15);
    }
    .schedule-slot--private {
      background: linear-gradient(180deg, #fde7d2, #f8c98e);
      border-color: rgba(176, 96, 18, 0.25);
      color: #5a3210;
    }
    .schedule-slot--private strong { color: #5a3210; }
    .schedule-slot--private span { color: rgba(90, 50, 16, 0.85); }


    .schedule-slot--closed {
      background:
        linear-gradient(135deg, rgba(20, 20, 20, 0.025) 25%, transparent 25%, transparent 50%, rgba(20, 20, 20, 0.025) 50%, rgba(20, 20, 20, 0.025) 75%, transparent 75%, transparent),
        #f1f1ed;
      background-size: 20px 20px;
      color: rgba(26, 26, 26, 0.52);
    }

    .schedule-slot--closed strong {
      margin-bottom: 0;
      font-size: 1.15rem;
    }

    @media (max-width: 820px) {
      .schedule-board-scroll {
        display: none;
      }
    }

    /* ---------- Photo strip ---------- */
    .photo-strip {
      padding: 0;
      background: var(--dark-text, #141414);
    }

    .photo-strip-inner {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2px;
    }

    .photo-strip figure {
      position: relative;
      margin: 0;
      aspect-ratio: 4 / 5;
      overflow: hidden;
    }

    .photo-strip img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.15) contrast(1.05);
      transition: transform 0.8s ease, filter 0.6s ease;
    }

    .photo-strip figure:hover img {
      transform: scale(1.06);
      filter: grayscale(0) contrast(1.05);
    }

    .photo-strip figcaption {
      position: absolute;
      left: 1rem;
      bottom: 0.85rem;
      font-family: "Bebas Neue", sans-serif;
      font-size: 0.95rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bone-white, #fdfbf5);
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
      padding: 0.2rem 0.55rem;
      border-left: 3px solid var(--blood-red, #b9121b);
    }

    @media (max-width: 900px) {
      .photo-strip-inner {
        grid-template-columns: repeat(2, 1fr);
      }
      .photo-strip figure:nth-child(5) { display: none; }
    }

    /* ---------- Split spotlight ---------- */
    .spotlight-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .spotlight-media {
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      box-shadow: 0 30px 70px rgba(10, 10, 10, 0.35);
    }

    .spotlight-media::after {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      pointer-events: none;
    }

    .spotlight-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .spotlight-tag {
      position: absolute;
      top: 1.2rem;
      left: -0.6rem;
      background: var(--blood-red, #b9121b);
      color: var(--bone-white, #fdfbf5);
      font-family: "Bebas Neue", sans-serif;
      letter-spacing: 0.18em;
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
    }

    .spotlight-copy h2 { margin-bottom: 1rem; }

    .spotlight-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
      display: grid;
      gap: 0.9rem;
    }

    .spotlight-list li {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 1.02rem;
      line-height: 1.55;
    }

    .spotlight-list li::before {
      content: "";
      width: 14px;
      height: 14px;
      margin-top: 0.45rem;
      background: var(--blood-red, #b9121b);
      transform: rotate(45deg);
    }

    @media (max-width: 860px) {
      .spotlight-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
  
</style>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  </Fragment>
<header class="hero">
    <div class="hero-media">
      <img width="1600" height="1200" src="/assets/ema-post-optimized.webp" alt="Kids martial arts students training at La Jolla Martial Arts">
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title font-display">
          <span>Kids Martial Arts</span>
          <span>in La Jolla</span>
        </h1>
        <p class="hero-subtitle">For Ages 7-12</p>

        <div class="hero-details" aria-label="Program overview">
          <ul class="hero-benefits">
            <li>
              <strong>Builds focus and self-control</strong>
            </li>
            <li>
              <strong>Grows confidence through real progress</strong>
            </li>
            <li>
              <strong>Develops discipline, respect, and resilience</strong>
            </li>
          </ul>
        </div>

        <div class="hero-actions">
          <a href="#contact" class="btn-primary">Claim Free Week</a>
          <a href="#faq" class="btn-secondary">View FAQ</a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="section section-light" id="proof">
      <div class="section-inner">
        <p class="section-label">Trust Proof</p>
        <h2 class="section-title font-display">
          Why Families Choose <span class="program-highlight">Kids Martial Arts</span>
        </h2>
        <div class="copy-links">
          <p>
            Parents usually are not looking for just another after-school activity. They want kids martial arts
            in La Jolla that helps a child focus, grow in confidence, and use energy in a positive way. This
            class is Taekwondo for ages 7–12: beginner-friendly, structured, and built around progress kids can feel.
          </p>
          <p>
            Younger children start in <a href="/little-ninjas">Little Ninjas (ages 3–6)</a>. Older students move to
            <a href="/teen-martial-arts">teen martial arts</a>. See the <a href="/schedule">weekly schedule</a> or
            <a href="#contact">claim a free week</a> when you are ready to visit.
          </p>
        </div>

        <div class="proof-bar">
          <article class="proof-card">
            <strong>40+</strong>
            <span>Years of teaching experience from our head instructor</span>
          </article>
          <article class="proof-card">
            <strong>300+</strong>
            <span>Black belts trained over a long teaching career</span>
          </article>
          <article class="proof-card">
            <strong>4.8<span class="proof-star" aria-hidden="true">★</span></strong>
            <span>Rated across 39 Google reviews — one of La Jolla's most-loved martial arts schools</span>
          </article>
          <article class="proof-card">
            <strong>7-12</strong>
            <span>Age-focused classes for growing kids and beginners</span>
          </article>
        </div>
      </div>
    </section>

    <section class="photo-strip" aria-label="Training moments">
      <div class="photo-strip-inner">
        <figure>
          <img width="1600" height="1200" src="/assets/ema-post-optimized.webp" alt="Kids martial arts students training at La Jolla Martial Arts">
          <figcaption>Focus</figcaption>
        </figure>
        <figure>
          <img width="1200" height="1500" src="/assets/ema-post-2-optimized.webp" alt="Kids practicing Taekwondo drills">
          <figcaption>Discipline</figcaption>
        </figure>
        <figure>
          <img width="960" height="720" src="/assets/EMA - Post 6.jpg" alt="Head instructor working with a young student">
          <figcaption>Mastery</figcaption>
        </figure>
        <figure>
          <img width="1600" height="1200" src="/assets/ema-post-12-optimized.webp" alt="Belt ceremony for kids martial arts students">
          <figcaption>Growth</figcaption>
        </figure>
        <figure>
          <img width="1600" height="1043" src="/assets/img-8330-5592456-optimized.webp" alt="Kids martial arts student demonstrating a technique">
          <figcaption>Respect</figcaption>
        </figure>
      </div>
    </section>

    <section class="section section-alt" id="training">
      <div class="section-inner">
        <p class="section-label">The Class</p>
        <h2 class="section-title font-display">
          Kids Taekwondo In <span class="program-highlight">La Jolla</span>
        </h2>
        <div class="copy-links">
          <p>
            La Jolla Martial Arts teaches kids taekwondo at 7680 Girard Ave, Basement. The weekday Kids Martial Arts
            class is for ages 7–12. It runs 45 minutes, Monday through Thursday from 4:30pm to 5:15pm, with Taekwondo
            technique, focus drills, and habits kids can use at school and at home.
          </p>
          <p>
            Parents searching for kids karate in La Jolla are usually looking for that same beginner class. This school
            does not teach a separate karate curriculum. A kids karate search lands here because the training is martial
            arts for children: listening, respect, kicks and stances, and self-defense through Taekwondo. Your child
            would train Taekwondo in this kids program, not a second style.
          </p>
          <p>
            Ages 3–6 start in <a href="/little-ninjas">Little Ninjas</a>. Ages 13 and up move to
            <a href="/teen-martial-arts">teen martial arts</a>. Compare options on the
            <a href="/programs">programs page</a>, check the <a href="/schedule">schedule</a>, then
            <a href="#contact">claim a free week</a> if you want to see a class before you decide.
          </p>
        </div>

        <div class="benefits-grid">
          <article class="benefit-card">
            <h3 class="font-display">Ages 7–12</h3>
            <p>Weekday kids martial arts is for ages 7–12. Little Ninjas covers ages 3–6. The evening class is for ages 13 and up. Saturday 9:00am–9:45am mixes Little Ninjas and kids, ages 3–12.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Beginner Training</h3>
            <p>No experience is required. Beginners are welcomed in the first class. The free week is how families try kids taekwondo in La Jolla before making a longer commitment.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">What Parents Want</h3>
            <p>Families choose this class for focus, confidence, respect, self-control, and a structured after-school outlet. Training is physical, and it is also a place to practice listening and follow-through.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">A Free Week To Start</h3>
            <p>Visit the La Jolla studio, meet the instructor, and watch how your child handles a first class. Call (858) 361-0961 or use the form on this page to claim one week of free classes.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dark" id="benefits">
      <div class="section-inner">
        <p class="section-label">Benefits</p>
        <h2 class="section-title font-display">
          What <span class="program-highlight">Kids Martial Arts</span> Is Built To Develop
        </h2>
        <p class="section-intro">
          The current program messaging is strongest around confidence, concentration, character, and positive physical
          development. These classes are designed to help kids grow mentally and physically in a way that feels clear,
          supportive, and age-appropriate.
        </p>

        <div class="benefits-grid">
          <article class="benefit-card">
            <h3 class="font-display">Focus On Self-Improvement</h3>
            <p>Martial arts teaches kids to pay attention to their own growth. Instead of comparing themselves to others, they learn to improve their form, effort, self-control, and confidence one class at a time.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Develops Patience</h3>
            <p>Progress in Taekwondo happens through repetition and consistency. Kids learn how to stay with a challenge, listen carefully, and trust the process instead of expecting instant results.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Supports Better School Habits</h3>
            <p>Discipline, concentration, respect, and follow-through are all reinforced in class. Those same habits can carry into the classroom and help kids approach schoolwork with more confidence and focus.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Builds Strength And Endurance</h3>
            <p>Classes give kids a fun, high-energy outlet that improves balance, strength, and stamina. It is a strong fit for children who need movement and may not connect with traditional sports.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Promotes Positivity</h3>
            <p>Kids who feel shy, frustrated, or unsure of themselves often respond well to the structure of martial arts. Training helps them feel capable, supported, and proud of what they can do.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Teaches Respect And Self-Control</h3>
            <p>Students practice how to respond with discipline instead of impulse. That means more respect at home and in class, along with better emotional control and decision-making over time.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-light" id="spotlight">
      <div class="section-inner">
        <div class="spotlight-grid">
          <div class="spotlight-media">
            <span class="spotlight-tag">Inside The Dojo</span>
            <img width="839" height="1024" src="/assets/kids-martial-arts-1.webp" alt="Kids Martial Arts class in session at La Jolla Martial Arts">
          </div>
          <div class="spotlight-copy">
            <p class="section-label">A Closer Look</p>
            <h2 class="section-title font-display">
              Step Onto <span class="program-highlight">The Mat</span>
            </h2>
            <p class="section-intro">
              Kids Martial Arts is a 45-minute class built around focus drills, Taekwondo technique, and small character lessons that kids can actually use at home and at school. Our head instructor runs the floor with a calm, direct style that keeps students engaged without being harsh.
            </p>
            <ul class="spotlight-list">
              <li>Small class sizes so every child gets coaching and encouragement</li>
              <li>Beginners are welcomed in their very first class, no experience needed</li>
              <li>A clear belt progression kids can see, earn, and feel proud of</li>
              <li>A supportive culture parents notice in how their child talks about class</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="neighborhoods">
      <div class="section-inner">
        <p class="section-label">Nearby Neighborhoods</p>
        <h2 class="section-title font-display">
          Kids Classes For Clairemont, Pacific Beach, <span class="program-highlight">And San Diego</span>
        </h2>
        <div class="copy-links">
          <p>
            There is one studio. Kids from Clairemont, Bay Ho, Pacific Beach, Bay Park, UTC, University City, and the
            rest of San Diego train at 7680 Girard Ave, Basement, La Jolla, CA 92037. La Jolla Martial Arts does not
            have a second dojo in Clairemont, Pacific Beach, Bay Park, Bay Ho, or University City.
          </p>
          <p>
            Clairemont and Bay Ho families use the after-school kids martial arts class or the Saturday morning class.
            Pacific Beach and Bay Park parents use that same La Jolla schedule. UTC and University City students come
            to Girard Avenue for kids taekwondo. San Diego families who want a La Jolla school, rather than a class in
            another neighborhood, can start with a <a href="#contact">free week</a> and then choose
            <a href="/little-ninjas">Little Ninjas</a>, this kids class, or
            <a href="/teen-martial-arts">teen martial arts</a>.
          </p>
        </div>
        <ul class="spotlight-list">
          <li>Clairemont: weekday 4:30pm kids martial arts, or Saturday 9:00am for ages 3–12, at the La Jolla studio.</li>
          <li>Bay Ho: the same La Jolla kids taekwondo schedule, with weekday classes for ages 7–12.</li>
          <li>Pacific Beach: kids martial arts in La Jolla. Families drive to Girard Avenue. There is no Pacific Beach location.</li>
          <li>Bay Park: kids classes are at 7680 Girard Ave, Basement, not in Bay Park.</li>
          <li>UTC and University City: after-school Taekwondo at the La Jolla dojo, Monday through Thursday.</li>
          <li>San Diego: one school for kids martial arts, with Little Ninjas and teen classes under the same roof.</li>
        </ul>
        <div class="copy-links">
          <p>
            Class times are on the <a href="/schedule">schedule</a>. Call (858) 361-0961 if you want help matching a neighborhood drive to a class time.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-light schedule-section" id="schedule">
      <div class="section-inner">
        <div class="schedule-head">
          <div>
            <p class="section-label">Schedule</p>
            <h2 class="section-title font-display">
              See The Weekly Rhythm For <span class="program-highlight">Kids Martial Arts</span>
            </h2>
            <p class="section-intro">
              Kids Martial Arts runs after school Monday through Thursday, with an additional Saturday morning option.
              Fridays are reserved for private lessons by appointment. Sundays closed.
