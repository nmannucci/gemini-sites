---
import Layout from '../layouts/Layout.astro';
import ScheduleMobile from '../components/ScheduleMobile.astro';

// TODO: confirm typical drive times from Clairemont, Bay Ho, Pacific Beach, Bay Park, and UTC/University City to 7680 Girard Ave, Basement before publishing minute estimates.
const kidsFaqs = [
  {
    question: 'Can martial arts help if my child is out of control?',
    answer: 'Yes. Your child practices listening and self-control in every class. Discipline here is something they can use at home and at school, not only on the mat.',
  },
  {
    question: 'Will martial arts make my child more aggressive?',
    answer: 'No. The class teaches self-defense, respect, and restraint. Your child learns that violence is not the answer, and that confidence should help them avoid conflict, not look for it.',
  },
  {
    question: 'What if my child does not like traditional sports?',
    answer: 'This class often fits kids who have not connected with team sports. It is active, and the goal is their own progress: better form, more focus, and a skill they can feel getting stronger.',
  },
  {
    question: 'What will this do for my child at school?',
    answer: 'Class reinforces focus, discipline, patience, self-control, and respect. Those habits can support better classroom behavior, stronger effort, and more confidence when school feels hard.',
  },
  {
    question: 'What if my child is not coordinated?',
    answer: 'That is completely okay. Kids start at different levels. Instructors help your child improve balance, coordination, and control step by step.',
  },
  {
    question: 'Can this help my child believe in themselves?',
    answer: 'Yes. Small wins matter. As your child learns techniques, handles a hard drill, and earns the next step, they start to trust themselves. That confidence can show up at home and at school.',
  },
  {
    question: 'What ages is the kids class?',
    answer: 'The weekday kids class is for ages 7–12, Monday through Thursday from 4:30pm to 5:15pm. Ages 3–6 train in Little Ninjas. Ages 13 and up train in the evening class. Saturday from 9:00am to 9:45am is a mixed class for ages 3–12.',
  },
  {
    question: 'What will my child learn in the kids class?',
    answer: 'Your child learns Taekwondo: kicks, stances, and self-defense taught with respect and restraint. They also practice focus, listening, and staying with a challenge. Beginners start in the first class. No experience is required.',
  },
  {
    question: 'Can my child start as a beginner?',
    answer: 'Yes. Beginners are welcome in the first class, and no experience is required. Start with a free week so you can see how your child handles the class before you decide.',
  },
  {
    question: 'When does the kids class meet?',
    answer: 'Monday through Thursday from 4:30pm to 5:15pm. Friday is private lessons by appointment. Saturday from 9:00am to 9:45am is a mixed Little Ninjas and kids class for ages 3–12. Sunday is closed.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: kidsFaqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer,
    },
  })),
};
---

<Layout
  title={`Kids Martial Arts in La Jolla | Taekwondo for Ages 7–12`}
  description={`Kids martial arts and kids taekwondo in La Jolla for ages 7–12. Beginner classes for parents comparing kids karate. Free week at 7680 Girard Ave.`}
  canonical={`https://lajollatkd.com/kids-martial-arts`}
  ogImage={`/assets/ema-post-2-optimized.webp`}
  programPageCss
>
  <Fragment slot="head">
<style is:global>

    .hero-media img {
      object-fit: cover !important;
      object-position: center !important;
    }
    .hero-media::after {
      background:
        linear-gradient(
          100deg,
          rgba(8, 8, 8, 0.95) 0%,
          rgba(8, 8, 8, 0.85) 45%,
          rgba(8, 8, 8, 0.6) 75%,
          rgba(8, 8, 8, 0.45) 100%
        ) !important;
    }

    .hero-copy {
      max-width: 820px;
    }

    .hero-title {
      font-size: clamp(3.75rem, 8vw, 6.4rem);
    }

    .hero-title span {
      display: block;
    }

    .hero-subtitle {
      padding: 0.95rem 1.25rem;
      font-size: 0.95rem;
      margin-top: 1.2rem;
      margin-bottom: 0.85rem;
    }

    .hero-details {
      margin-top: 2.65rem;
    }

    .hero-benefits {
      gap: 1rem;
    }

    .hero-benefits li {
      grid-template-columns: 20px minmax(0, 1fr);
      column-gap: 1rem;
    }

    .hero-benefits strong {
      font-size: 1.18rem;
      font-weight: 700;
      line-height: 1.4;
      color: rgba(255, 255, 255, 0.98);
      text-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    }

    .hero-benefits span {
      display: none;
    }

    .hero-actions {
      margin-top: 3.4rem;
      gap: 1.1rem;
    }

    .btn-primary,
    .btn-secondary {
      padding: 1.1rem 1.95rem;
      font-size: 0.9rem;
    }

    .section-title .program-highlight {
      color: var(--blood-red);
      -webkit-text-stroke: 0;
    }

    .schedule-section {
      overflow: hidden;
    }

    .schedule-head {
      margin-bottom: 2rem;
    }

    .schedule-board {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(245, 245, 240, 0.94));
      border: 1px solid rgba(20, 20, 20, 0.08);
      box-shadow: 0 24px 60px rgba(10, 10, 10, 0.1);
      padding: 1rem;
    }

    .schedule-board-scroll {
      overflow-x: auto;
    }

    .schedule-grid {
      min-width: 980px;
      display: grid;
      grid-template-columns: 180px repeat(7, minmax(112px, 1fr));
      gap: 0.85rem;
    }

    .schedule-corner,
    .schedule-day,
    .schedule-time,
    .schedule-slot {
      min-height: 104px;
      padding: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .schedule-corner,
    .schedule-day {
      min-height: 72px;
      font-family: "Bebas Neue", sans-serif;
      font-size: 1.05rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .schedule-corner {
      background: #ecebe7;
      color: var(--dark-text);
    }

    .schedule-day {
      background: var(--blood-red);
      color: var(--bone-white);
    }

    .schedule-time {
      background: #ecebe7;
      color: var(--dark-text);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.3;
    }

    .schedule-slot {
      position: relative;
      background: rgba(234, 234, 229, 0.6);
      border: 1px solid rgba(20, 20, 20, 0.05);
      color: var(--dark-text);
    }

    .schedule-slot strong {
      display: block;
      font-family: "Bebas Neue", sans-serif;
      font-size: 1.35rem;
      line-height: 1;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    .schedule-slot span {
      display: block;
      font-size: 0.82rem;
      line-height: 1.45;
      color: rgba(26, 26, 26, 0.78);
    }

    .schedule-slot--live {
      background: linear-gradient(180deg, #d8f3ef, #b8ebe3);
      border-color: rgba(15, 118, 110, 0.15);
    }
    .schedule-slot--private {
      background: linear-gradient(180deg, #fde7d2, #f8c98e);
      border-color: rgba(176, 96, 18, 0.25);
      color: #5a3210;
    }
    .schedule-slot--private strong { color: #5a3210; }
    .schedule-slot--private span { color: rgba(90, 50, 16, 0.85); }


    .schedule-slot--closed {
      background:
        linear-gradient(135deg, rgba(20, 20, 20, 0.025) 25%, transparent 25%, transparent 50%, rgba(20, 20, 20, 0.025) 50%, rgba(20, 20, 20, 0.025) 75%, transparent 75%, transparent),
        #f1f1ed;
      background-size: 20px 20px;
      color: rgba(26, 26, 26, 0.52);
    }

    .schedule-slot--closed strong {
      margin-bottom: 0;
      font-size: 1.15rem;
    }

    @media (max-width: 820px) {
      .schedule-board-scroll {
        display: none;
      }
    }

    /* ---------- Photo strip ---------- */
    .photo-strip {
      padding: 0;
      background: var(--dark-text, #141414);
    }

    .photo-strip-inner {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2px;
    }

    .photo-strip figure {
      position: relative;
      margin: 0;
      aspect-ratio: 4 / 5;
      overflow: hidden;
    }

    .photo-strip img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.15) contrast(1.05);
      transition: transform 0.8s ease, filter 0.6s ease;
    }

    .photo-strip figure:hover img {
      transform: scale(1.06);
      filter: grayscale(0) contrast(1.05);
    }

    .photo-strip figcaption {
      position: absolute;
      left: 1rem;
      bottom: 0.85rem;
      font-family: "Bebas Neue", sans-serif;
      font-size: 0.95rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bone-white, #fdfbf5);
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
      padding: 0.2rem 0.55rem;
      border-left: 3px solid var(--blood-red, #b9121b);
    }

    @media (max-width: 900px) {
      .photo-strip-inner {
        grid-template-columns: repeat(2, 1fr);
      }
      .photo-strip figure:nth-child(5) { display: none; }
    }

    /* ---------- Split spotlight ---------- */
    .spotlight-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .spotlight-media {
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      box-shadow: 0 30px 70px rgba(10, 10, 10, 0.35);
    }

    .spotlight-media::after {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      pointer-events: none;
    }

    .spotlight-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .spotlight-tag {
      position: absolute;
      top: 1.2rem;
      left: -0.6rem;
      background: var(--blood-red, #b9121b);
      color: var(--bone-white, #fdfbf5);
      font-family: "Bebas Neue", sans-serif;
      letter-spacing: 0.18em;
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
    }

    .spotlight-copy h2 { margin-bottom: 1rem; }

    .spotlight-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
      display: grid;
      gap: 0.9rem;
    }

    .spotlight-list li {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 1.02rem;
      line-height: 1.55;
    }

    .spotlight-list li::before {
      content: "";
      width: 14px;
      height: 14px;
      margin-top: 0.45rem;
      background: var(--blood-red, #b9121b);
      transform: rotate(45deg);
    }

    @media (max-width: 860px) {
      .spotlight-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
  
</style>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  </Fragment>
<header class="hero">
    <div class="hero-media">
      <img width="1600" height="1200" src="/assets/ema-post-optimized.webp" alt="Kids martial arts students training at La Jolla Martial Arts">
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title font-display">
          <span>Kids Martial Arts</span>
          <span>in La Jolla</span>
        </h1>
        <p class="hero-subtitle">For Ages 7-12</p>

        <div class="hero-details" aria-label="Program overview">
          <ul class="hero-benefits">
            <li>
              <strong>Builds focus and self-control</strong>
            </li>
            <li>
              <strong>Grows confidence through real progress</strong>
            </li>
            <li>
              <strong>Develops discipline, respect, and resilience</strong>
            </li>
          </ul>
        </div>

        <div class="hero-actions">
          <a href="#contact" class="btn-primary">Claim Free Week</a>
          <a href="#faq" class="btn-secondary">View FAQ</a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="section section-light" id="proof">
      <div class="section-inner">
        <p class="section-label">Why Parents Choose Us</p>
        <h2 class="section-title font-display">
          Why Families Choose <span class="program-highlight">Kids Martial Arts</span>
        </h2>
        <div class="copy-links">
          <p>
            You want your child to come home steadier. More focused. More sure of themselves.
            This class is Taekwondo for ages 7–12. Beginners are welcome, and the progress is
            something your child can feel.
          </p>
          <p>
            Younger children start in <a href="/little-ninjas">Little Ninjas (ages 3–6)</a>. Older students move to
            <a href="/teen-martial-arts">teen martial arts</a>. See the <a href="/schedule">weekly schedule</a> or
            <a href="#contact">claim a free week</a> when you are ready to visit.
          </p>
        </div>

        <div class="proof-bar">
          <article class="proof-card">
            <strong>40+</strong>
            <span>Years of teaching experience from our head instructor</span>
          </article>
          <article class="proof-card">
            <strong>300+</strong>
            <span>Black belts trained over a long teaching career</span>
          </article>
          <article class="proof-card">
            <strong>4.8<span class="proof-star" aria-hidden="true">★</span></strong>
            <span>Rated across 39 Google reviews — one of La Jolla's most-loved martial arts schools</span>
          </article>
          <article class="proof-card">
            <strong>7-12</strong>
            <span>Age-focused classes for growing kids and beginners</span>
          </article>
        </div>
      </div>
    </section>

    <section class="photo-strip" aria-label="Training moments">
      <div class="photo-strip-inner">
        <figure>
          <img width="1600" height="1200" src="/assets/ema-post-optimized.webp" alt="Kids martial arts students training at La Jolla Martial Arts">
          <figcaption>Focus</figcaption>
        </figure>
        <figure>
          <img width="1200" height="1500" src="/assets/ema-post-2-optimized.webp" alt="Kids practicing Taekwondo drills">
          <figcaption>Discipline</figcaption>
        </figure>
        <figure>
          <img width="960" height="720" src="/assets/EMA - Post 6.jpg" alt="Head instructor working with a young student">
          <figcaption>Mastery</figcaption>
        </figure>
        <figure>
          <img width="1600" height="1200" src="/assets/ema-post-12-optimized.webp" alt="Belt ceremony for kids martial arts students">
          <figcaption>Growth</figcaption>
        </figure>
        <figure>
          <img width="1600" height="1043" src="/assets/img-8330-5592456-optimized.webp" alt="Kids martial arts student demonstrating a technique">
          <figcaption>Respect</figcaption>
        </figure>
      </div>
    </section>

    <section class="section section-alt" id="training">
      <div class="section-inner">
        <p class="section-label">The Class</p>
        <h2 class="section-title font-display">
          Kids Taekwondo In <span class="program-highlight">La Jolla</span>
        </h2>
        <div class="copy-links">
          <p>
            Your child trains Taekwondo at 7680 Girard Ave, Basement, in La Jolla. The weekday class
            is 45 minutes, Monday through Thursday, 4:30–5:15pm. They practice technique, focus, and
            habits you can see at school and at home.
          </p>
          <p>
            Self-defense is taught with respect and restraint. Confidence here is meant to help your
            child avoid a fight, not look for one. Listening, kicks, and stances come with that same idea.
          </p>
          <p>
            Ages 3–6 start in <a href="/little-ninjas">Little Ninjas</a>. Ages 13 and up move to
            <a href="/teen-martial-arts">teen martial arts</a>. Compare options on the
            <a href="/programs">programs page</a>, check the <a href="/schedule">schedule</a>, then
            <a href="#contact">claim a free week</a> if you want to see a class before you decide.
          </p>
        </div>

        <div class="benefits-grid">
          <article class="benefit-card">
            <h3 class="font-display">Ages 7–12</h3>
            <p>The weekday class is for your child at ages 7–12. Little Ninjas is for ages 3–6. The evening class is for ages 13 and up. Saturday, 9:00–9:45am, mixes Little Ninjas and kids, ages 3–12.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Beginner Training</h3>
            <p>No experience is required. Beginners are welcome in the first class. A free week lets you watch your child try it before you commit.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">What Parents Want</h3>
            <p>Parents choose this class for focus, confidence, respect, and self-control. It is a structured after-school hour, and it is practice at listening and follow-through.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">A Free Week To Start</h3>
            <p>Come to the studio, meet the head instructor, and see how your child handles a first class. Call (858) 361-0961 or use the form on this page to claim one week of free classes.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dark" id="benefits">
      <div class="section-inner">
        <p class="section-label">Benefits</p>
        <h2 class="section-title font-display">
          What <span class="program-highlight">Kids Martial Arts</span> Is Built To Develop
        </h2>
        <p class="section-intro">
          Your child leaves class with something you can see. More confidence. Better focus.
          A calmer way to handle a hard moment at school or at home.
        </p>

        <div class="benefits-grid">
          <article class="benefit-card">
            <h3 class="font-display">Confidence</h3>
            <p>Your child builds confidence by doing hard things in class. Small wins add up. That confidence is meant to help them avoid conflict, not look for it.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Focus And Discipline</h3>
            <p>They practice paying attention, following directions, and finishing what they start. Those habits can show up as stronger effort and better focus on schoolwork.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Respect And Self-Control</h3>
            <p>Class teaches respect, restraint, and self-defense. Your child practices answering with discipline instead of impulse. At home, that can look like more respect and better self-control. The anti-bullying skills are the same idea: confidence used to avoid a fight, not start one.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Patience And Resilience</h3>
            <p>Taekwondo gets better through repetition. Your child learns to stay with a challenge and try again. That patience and resilience can carry into homework and into a tough day at home.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">Fitness, Balance, Coordination</h3>
            <p>Class is a physical outlet. Your child works on balance, coordination, strength, and stamina. It fits kids who need to move, including kids who have not connected with team sports.</p>
          </article>
          <article class="benefit-card">
            <h3 class="font-display">A Belt To Work Toward</h3>
            <p>There is a clear belt progression your child can see, earn, and feel proud of. Each step is a goal they can name. The pride of earning it is part of the confidence you see at home.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-light" id="spotlight">
      <div class="section-inner">
        <div class="spotlight-grid">
          <div class="spotlight-media">
            <span class="spotlight-tag">Inside The Dojo</span>
            <img width="839" height="1024" src="/assets/kids-martial-arts-1.webp" alt="Kids Martial Arts class in session at La Jolla Martial Arts">
          </div>
          <div class="spotlight-copy">
            <p class="section-label">A Closer Look</p>
            <h2 class="section-title font-display">
              Step Onto <span class="program-highlight">The Mat</span>
            </h2>
            <p class="section-intro">
              Your child steps into a 45-minute Taekwondo class. Focus drills, technique, and short lessons they can use at home and at school. The head instructor keeps the floor calm and direct: engaged, without being harsh.
            </p>
            <ul class="spotlight-list">
              <li>Small class sizes so every child gets coaching and encouragement</li>
              <li>Beginners are welcomed in their very first class, no experience needed</li>
              <li>A clear belt progression kids can see, earn, and feel proud of</li>
              <li>A supportive culture parents notice in how their child talks about class</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="service-area">
      <div class="section-inner">
        <p class="section-label">Service Area</p>
        <h2 class="section-title font-display">
          Kids Martial Arts Serving <span class="program-highlight">La Jolla And Nearby Areas</span>
        </h2>
        <p class="section-intro">
          The studio at 7680 Girard Ave, Basement, La Jolla, CA 92037 serves kids from these areas.
        </p>
        <ul class="service-areas">
          <li>La Jolla</li>
          <li>Clairemont</li>
          <li>Bay Ho</li>
          <li>Pacific Beach</li>
          <li>Bay Park</li>
          <li>UTC</li>
          <li>University City</li>
          <li>San Diego</li>
        </ul>
        <div class="service-map">
          <iframe
            src="https://maps.google.com/maps?width=100%25&amp;height=380&amp;hl=en&amp;q=7680%20Girard%20Ave,%20La%20Jolla,%20CA%2092037&amp;t=&amp;z=15&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            width="100%"
            title="Map showing La Jolla Martial Arts at 7680 Girard Ave, Basement, La Jolla, CA 92037"
          ></iframe>
        </div>
        <p class="section-intro">
          See the <a href="/schedule">schedule</a>, <a href="/little-ninjas">Little Ninjas</a>, <a href="/teen-martial-arts">teen martial arts</a>, or start with a <a href="#contact">free week</a>.
        </p>
      </div>
    </section>

    <section class="section section-light schedule-section" id="schedule">
      <div class="section-inner">
        <div class="schedule-head">
          <div>
            <p class="section-label">Schedule</p>
            <h2 class="section-title font-display">
              See The Weekly Rhythm For <span class="program-highlight">Kids Martial Arts</span>
            </h2>
            <p class="section-intro">
              Kids Martial Arts runs after school Monday through Thursday, with an additional Saturday morning option.
              Fridays are reserved for private lessons by appointment. Sundays closed.
            </p>
          </div>
        </div>

        <div class="schedule-board">
          <div class="schedule-board-scroll">
            <div class="schedule-grid" role="table" aria-label="Kids Martial Arts weekly schedule">
              <div class="schedule-corner" role="columnheader">Time</div>
              <div class="schedule-day" role="columnheader">Mon</div>
              <div class="schedule-day" role="columnheader">Tue</div>
              <div class="schedule-day" role="columnheader">Wed</div>
              <div class="schedule-day" role="columnheader">Thu</div>
              <div class="schedule-day" role="columnheader">Fri</div>
              <div class="schedule-day" role="columnheader">Sat</div>
              <div class="schedule-day" role="columnheader">Sun</div>

              <div class="schedule-time" role="rowheader">4:30pm - 5:15pm</div>
              <div class="schedule-slot schedule-slot--live" role="cell">
                <div>
                  <strong>Kids Martial Arts</strong>
                  <span>Ages 7-12</span>
                </div>
              </div>
              <div class="schedule-slot schedule-slot--live" role="cell">
                <div>
                  <strong>Kids Martial Arts</strong>
                  <span>Ages 7-12</span>
                </div>
              </div>
              <div class="schedule-slot schedule-slot--live" role="cell">
                <div>
                  <strong>Kids Martial Arts</strong>
