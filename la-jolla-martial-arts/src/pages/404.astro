---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | La Jolla Martial Arts"
  description="The requested page could not be found. Explore La Jolla Martial Arts programs or contact our team."
  robots="noindex,follow"
  canonical="https://lajollatkd.com/404"
>
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1>That Page Is Off The Mat</h1>
    <p>The page may have moved. Choose a current program or contact us and we’ll point you in the right direction.</p>
    <div class="actions">
      <a class="primary" href="/#programs">View Programs</a>
      <a class="secondary" href="/contact">Contact Us</a>
    </div>
  </main>
</Layout>

<style>
  .not-found { min-height:70vh; padding:9rem 1.5rem 5rem; text-align:center; display:grid; place-content:center; background:#f5f5f0; color:#151515; }
  .eyebrow { color:#d32f2f; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
  h1 { font-family:'Bebas Neue',sans-serif; font-size:clamp(3rem,8vw,6rem); line-height:.95; margin:.5rem 0 1rem; text-transform:uppercase; }
  .not-found > p:not(.eyebrow) { max-width:620px; margin:0 auto; color:#5a5a5a; line-height:1.65; }
  .actions { display:flex; justify-content:center; gap:.75rem; flex-wrap:wrap; margin-top:2rem; }
  .actions a { padding:.9rem 1.25rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; }
  .primary { background:#ea580c; color:#fff; }
  .secondary { border:1px solid #151515; color:#151515; }
</style>
