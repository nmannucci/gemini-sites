  <!-- Get Started Section -->
  <section class="section get-started" id="get-started">
    <div class="get-started-container">
      <div class="get-started-content">
        <p class="section-label">How to Get Started</p>
        <h2 class="section-title font-display">
          Begin Your <span class="accent">Journey</span>
        </h2>
        <p>
          Starting martial arts training is easier than you think. Join hundreds of
          families who have discovered the life-changing benefits of Taekwondo at
          La Jolla Martial Arts.
        </p>

        <div class="steps">
          <div class="step">
            <div class="step-number font-display">1</div>
            <div class="step-content">
              <h3>Claim Your Free Week</h3>
              <p>
                Sign up for our complimentary 1-week trial. No commitment required—just
                come experience what La Jolla Martial Arts is all about.
              </p>
            </div>
          </div>

          <div class="step">
            <div class="step-number font-display">2</div>
            <div class="step-content">
              <h3>Tour The Dojo</h3>
              <p>
                Tour our facility, meet our instructors, and find the right program for
                you or your child. We'll answer all your questions.
              </p>
            </div>
          </div>

          <div class="step">
            <div class="step-number font-display">3</div>
            <div class="step-content">
              <h3>Start Training</h3>
              <p>
                Join our family of martial artists and begin your path to discipline,
                confidence, and black belt mastery.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="get-started-form-container">
        <form class="get-started-form" action="/api/lead" method="POST" novalidate data-lead-form data-lead-source="home-bottom-cta">
          <div class="get-started-form-header">
            <span class="offer-badge">Limited Time Offer</span>
            <h3 class="font-display">Claim Your Free Week of Classes</h3>
            <p>Experience world-class Taekwondo training with no commitment.</p>
          </div>

            <div class="form-row">
              <div class="form-group">
              <label class="form-label" for="firstNameBottom">First Name</label>
              <input type="text" id="firstNameBottom" name="firstName" class="form-input" placeholder="John" required>
              </div>
              <div class="form-group">
              <label class="form-label" for="lastNameBottom">Last Name</label>
              <input type="text" id="lastNameBottom" name="lastName" class="form-input" placeholder="Smith" required>
              </div>
            </div>

          <div class="form-group">
            <label class="form-label" for="emailBottom">Email Address</label>
            <input type="email" id="emailBottom" name="email" class="form-input" placeholder="john@example.com" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="phoneBottom">Phone Number</label>
            <input type="tel" id="phoneBottom" name="phone" class="form-input" placeholder="(858) 555-0123" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="programBottom">Program Interest</label>
            <select id="programBottom" name="program" class="form-select" required>
              <option value="" disabled selected>Select a program</option>
              <option value="little-ninjas">Little Ninjas (Ages 3–6)</option>
              <option value="kids">Kids Martial Arts (Ages 7–12)</option>
              <option value="teen-adult">Teen &amp; Adult (Ages 13+)</option>
              <option value="zumba">Zumba Classes</option>
            </select>
          </div>

          <button type="submit" class="form-submit">Claim Your Free Week</button>

          <div class="form-divider">
            <span>or</span>
          </div>

          <a href={`tel:${site.phoneTel}`} class="btn-call">
            <i data-lucide="phone"></i>
            Call {site.phoneDisplay}
          </a>

          <p class="form-disclaimer">
            By submitting, you agree to receive emails and texts about your trial.
            We respect your privacy and will never share your information.
          </p>
        </form>

        <div class="contact-info-bottom">
          <div class="contact-item-bottom">
            <i data-lucide="home"></i>
            <p>{site.brand}</p>
          </div>
          <div class="contact-item-bottom">
            <i data-lucide="map-pin"></i>
            <p>{site.address}</p>
          </div>
          <div class="contact-item-bottom">
            <i data-lucide="phone"></i>
            <p><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p>
          </div>
          <div class="contact-item-bottom">
            <i data-lucide="clock"></i>
            <p>{site.hoursOneLine}</p>
          </div>
          <div class="contact-item-bottom">
            <i data-lucide="mail"></i>
            <p>{site.email}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->

</Layout>
