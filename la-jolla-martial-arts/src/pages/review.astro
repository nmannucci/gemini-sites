---
import Layout from '../layouts/Layout.astro';
import '../styles/site-theme.css';

const GOOGLE_REVIEW_URL =
  'https://search.google.com/local/writereview?placeid=ChIJ5XqIvZcD3IARJiAnQzFXmXY';
---

<Layout
  title="Rate Your Experience | La Jolla Martial Arts"
  description="Share how your visit to La Jolla Martial Arts went, then pick up $25 off in the on-site equipment shop."
  robots="noindex,nofollow"
  canonical="https://lajollatkd.com/review"
  bodyClass="review-funnel"
>
  <main class="review-page">
    <section class="review-panel" id="review-prompt" data-review-step="prompt">
      <p class="review-kicker">La Jolla Martial Arts</p>
      <h1 class="review-title font-display">
        How would you rate your experience at La Jolla Martial Arts?
      </h1>
      <p class="review-lede">Tap a star to send your rating.</p>

      <div
        class="review-stars"
        id="review-stars"
        role="group"
        aria-label="Rate your experience from 1 to 5 stars"
      >
        {[1, 2, 3, 4, 5].map((rating) => (
          <button
            type="button"
            class="review-star"
            data-rating={rating}
            aria-label={`${rating} star${rating === 1 ? '' : 's'}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.6l2.7 5.8 6.3.7-4.7 4.3 1.3 6.3L12 16.8 6.4 19.7l1.3-6.3-4.7-4.3 6.3-.7L12 2.6z" />
            </svg>
            <span class="review-star-num">{rating}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="review-panel" id="review-thanks" data-review-step="thanks" hidden>
      <p class="review-kicker">Thanks</p>
      <h2 class="review-title font-display">Thanks for your rating.</h2>
      <p class="review-lede">
        You earned $25 off in the La Jolla Martial Arts equipment shop. Show this code at the
        front desk. Google should open so you can leave a review too.
      </p>
      <div class="review-code" aria-label="Equipment shop discount code">
        <span class="review-code-label">Front desk code</span>
        <strong class="review-code-value">REVIEW25</strong>
        <span class="review-code-note">$25 off in the on-site shop</span>
      </div>
      <a
        class="btn-primary review-google"
        id="review-google"
        href={GOOGLE_REVIEW_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Leave a Google review
      </a>
    </section>
  </main>
</Layout>

<style is:global>
  body.review-funnel {
    background: var(--light-bg);
    color: var(--dark-text);
  }

  .review-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem 1.25rem 4rem;
    background:
      radial-gradient(ellipse at 50% -8%, rgba(41, 190, 226, 0.12), transparent 55%),
      var(--light-bg);
  }

  .review-panel {
    width: 100%;
    max-width: 34rem;
    background: #fff;
    border: 1px solid rgba(20, 20, 20, 0.06);
    box-shadow: 0 18px 44px rgba(10, 10, 10, 0.08);
    padding: 2rem 1.35rem 2.15rem;
    text-align: center;
  }

  .review-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--blood-red);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .review-kicker::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .review-title {
    margin: 1rem 0 0.85rem;
    color: var(--dark-text);
    font-size: clamp(2.15rem, 9vw, 3.15rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .review-lede {
    color: var(--muted-text);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 28rem;
    margin: 0 auto 1.5rem;
  }

  .review-stars {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .review-star {
    flex: 1 1 0;
    min-width: 0;
    min-height: 5.5rem;
    padding: 0.55rem 0.15rem 0.45rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border: 1px solid rgba(20, 20, 20, 0.08);
    background: #fff;
    color: #c4c4bc;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .review-star svg {
    width: 2.15rem;
    height: 2.15rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.6;
  }

  .review-star-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted-text);
  }

  .review-star:hover,
  .review-star:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .review-star.is-active,
  .review-star.is-preview {
    color: #d97706;
    background: rgba(217, 119, 6, 0.08);
    border-color: rgba(217, 119, 6, 0.35);
  }

  .review-star.is-active .review-star-num,
  .review-star.is-preview .review-star-num {
    color: #b45309;
  }

  .review-star:focus-visible {
    box-shadow: 0 0 0 3px rgba(41, 190, 226, 0.35);
  }

  .review-code {
    margin: 0 0 1.35rem;
    padding: 1.15rem 1rem 1.2rem;
    background: var(--light-bg);
    border: 1px dashed rgba(20, 20, 20, 0.18);
  }

  .review-code-label,
  .review-code-note {
    display: block;
    color: var(--muted-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .review-code-value {
    display: block;
    margin: 0.4rem 0 0.35rem;
    color: var(--dark-text);
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.4rem, 10vw, 3.4rem);
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .review-google {
    width: 100%;
    text-align: center;
  }

  @media (min-width: 640px) {
    .review-page {
      padding: 8rem 2rem 5rem;
    }

    .review-panel {
      padding: 2.6rem 2.4rem 2.5rem;
    }

    .review-stars {
      gap: 0.65rem;
    }

    .review-star {
      min-height: 6.25rem;
    }

    .review-star svg {
      width: 2.5rem;
      height: 2.5rem;
    }

    .review-google {
      width: auto;
    }
  }
</style>

<script is:inline>
  (function () {
    var GOOGLE_REVIEW_URL =
      'https://search.google.com/local/writereview?placeid=ChIJ5XqIvZcD3IARJiAnQzFXmXY';
    var POPUP_FALLBACK_MS = 700;

    var promptEl = document.getElementById('review-prompt');
    var thanksEl = document.getElementById('review-thanks');
    var starsEl = document.getElementById('review-stars');
    if (!promptEl || !thanksEl || !starsEl) return;

    var buttons = Array.prototype.slice.call(starsEl.querySelectorAll('.review-star'));

    function parseRating(value) {
      var n = Number(value);
      return n >= 1 && n <= 5 && n === Math.floor(n) ? n : null;
    }

    function ratingFromUrl() {
      try {
        return parseRating(new URL(window.location.href).searchParams.get('rating'));
      } catch (_) {
        return null;
      }
    }

    function persistRating(rating) {
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('rating', String(rating));
        url.searchParams.delete('step');
        if (window.history && history.replaceState) {
          history.replaceState(null, '', url.pathname + url.search + url.hash);
        }
      } catch (_) {}
    }

    function paintStars(rating, preview) {
      buttons.forEach(function (btn) {
        var value = Number(btn.getAttribute('data-rating'));
        btn.classList.toggle('is-active', !preview && rating != null && value <= rating);
        btn.classList.toggle('is-preview', preview && rating != null && value <= rating);
        btn.setAttribute('aria-pressed', String(!preview && rating != null && value === rating));
      });
    }

    function showThanks() {
      promptEl.hidden = true;
      thanksEl.hidden = false;
      var heading = thanksEl.querySelector('h2');
      if (heading) heading.setAttribute('tabindex', '-1');
      if (heading && heading.focus) heading.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    function logEvent(name, params) {
      if (typeof gtag === 'function') gtag('event', name, params || {});
    }

    function popupBlocked(win) {
      return !win || win.closed || typeof win.closed === 'undefined';
    }

    function sendToGoogle() {
      var opened = null;
      try {
        opened = window.open(GOOGLE_REVIEW_URL, '_blank', 'noopener,noreferrer');
      } catch (_) {
        opened = null;
      }

      if (!popupBlocked(opened)) {
        try { opened.opener = null; } catch (_) {}
        logEvent('review_google_open', { method: 'new_tab', page_path: window.location.pathname + window.location.search });
        return;
      }

      logEvent('review_google_open', { method: 'same_tab_fallback', page_path: window.location.pathname + window.location.search });
      window.setTimeout(function () {
        window.location.assign(GOOGLE_REVIEW_URL);
      }, POPUP_FALLBACK_MS);
    }

    function completeRating(rating, fromTap) {
      persistRating(rating);
      paintStars(rating, false);
      showThanks();
      if (fromTap) {
        logEvent('review_rating', {
          rating: rating,
          page_path: '/review?rating=' + rating,
        });
        sendToGoogle();
      }
    }

    var current = ratingFromUrl();
    if (current) {
      paintStars(current, false);
      showThanks();
    } else {
      paintStars(null, false);
    }

    starsEl.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.review-star');
      if (!btn) return;
      var rating = parseRating(btn.getAttribute('data-rating'));
      if (!rating) return;
      completeRating(rating, true);
    });

    starsEl.addEventListener('pointerover', function (e) {
      var btn = e.target.closest && e.target.closest('.review-star');
      if (!btn) return;
      paintStars(parseRating(btn.getAttribute('data-rating')), true);
    });

    starsEl.addEventListener('pointerout', function (e) {
      if (e.relatedTarget && starsEl.contains(e.relatedTarget)) return;
      paintStars(ratingFromUrl(), false);
    });

    starsEl.addEventListener('focusin', function (e) {
      var btn = e.target.closest && e.target.closest('.review-star');
      if (!btn) return;
      paintStars(parseRating(btn.getAttribute('data-rating')), true);
    });

    starsEl.addEventListener('focusout', function (e) {
      if (e.relatedTarget && starsEl.contains(e.relatedTarget)) return;
      paintStars(ratingFromUrl(), false);
    });
  })();
</script>
