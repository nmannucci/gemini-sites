---
import Layout from '../layouts/Layout.astro';
import '../styles/site-theme.css';

const GOOGLE_REVIEW_URL =
  'https://search.google.com/local/writereview?placeid=ChIJ5XqIvZcD3IARJiAnQzFXmXY';
---

<Layout
  title="Rate Your Experience | La Jolla Martial Arts"
  description="Share how your visit to La Jolla Martial Arts went, then leave a Google review for $25 off in the on-site equipment shop."
  robots="noindex,nofollow"
  canonical="https://lajollatkd.com/review"
  bodyClass="review-funnel"
>
  <main class="review-page">
    <section class="review-panel" id="review-prompt" data-review-step="prompt">
      <p class="review-kicker">La Jolla Martial Arts</p>
      <h1 class="review-title font-display">
        How would you rate your experience at La Jolla Martial Arts?
      </h1>
      <p class="review-lede">Tap a star to send your rating.</p>

      <div
        class="review-stars"
        id="review-stars"
        role="group"
        aria-label="Rate your experience from 1 to 5 stars"
      >
        {[1, 2, 3, 4, 5].map((rating) => (
          <button
            type="button"
            class="review-star"
            data-rating={rating}
            aria-label={`${rating} star${rating === 1 ? '' : 's'}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.6l2.7 5.8 6.3.7-4.7 4.3 1.3 6.3L12 16.8 6.4 19.7l1.3-6.3-4.7-4.3 6.3-.7L12 2.6z" />
            </svg>
            <span class="review-star-num">{rating}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="review-panel" id="review-google-step" data-review-step="google" hidden>
      <p class="review-kicker">Thanks</p>
      <h2 class="review-title font-display">Thanks for your rating.</h2>
      <p class="review-lede">
        Leave a Google review and you get $25 off in the La Jolla Martial Arts equipment shop.
        We'll show the front-desk code on this page after you go write that review.
      </p>
      <a
        class="btn-primary review-google"
        id="review-google"
        href={GOOGLE_REVIEW_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Leave a Google review
      </a>
    </section>

    <section class="review-panel" id="review-confirm-step" data-review-step="confirm" hidden>
      <p class="review-kicker">Google review</p>
      <h2 class="review-title font-display">After you post, come back here.</h2>
      <p class="review-lede">
        After you post, come back to this tab and tap below. We can't tell when a Google review
        goes live, so this just unlocks your shop code.
      </p>
      <button type="button" class="review-secondary" id="review-confirm">
        I left my review
      </button>
    </section>

    <section class="review-panel" id="review-code-step" data-review-step="code" hidden>
      <p class="review-kicker">Equipment shop</p>
      <h2 class="review-title font-display">Your front-desk code</h2>
      <p class="review-lede">
        Show this at the front desk for $25 off in the La Jolla Martial Arts equipment shop.
      </p>
      <div class="review-code" aria-label="Equipment shop discount code">
        <span class="review-code-label">Front desk code</span>
        <strong class="review-code-value">REVIEW25</strong>
        <span class="review-code-note">$25 off in the on-site shop</span>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  body.review-funnel {
    background: var(--light-bg);
    color: var(--dark-text);
  }

  .review-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem 1.25rem 4rem;
    background:
      radial-gradient(ellipse at 50% -8%, rgba(41, 190, 226, 0.12), transparent 55%),
      var(--light-bg);
  }

  .review-panel {
    width: 100%;
    max-width: 34rem;
    background: #fff;
    border: 1px solid rgba(20, 20, 20, 0.06);
    box-shadow: 0 18px 44px rgba(10, 10, 10, 0.08);
    padding: 2rem 1.35rem 2.15rem;
    text-align: center;
  }

  .review-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--blood-red);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .review-kicker::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .review-title {
    margin: 1rem 0 0.85rem;
    color: var(--dark-text);
    font-size: clamp(2.15rem, 9vw, 3.15rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .review-lede {
    color: var(--muted-text);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 28rem;
    margin: 0 auto 1.5rem;
  }

  .review-stars {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .review-star {
    flex: 1 1 0;
    min-width: 0;
    min-height: 5.5rem;
    padding: 0.55rem 0.15rem 0.45rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border: 1px solid rgba(20, 20, 20, 0.08);
    background: #fff;
    color: #c4c4bc;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .review-star svg {
    width: 2.15rem;
    height: 2.15rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.6;
  }

  .review-star-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted-text);
  }

  .review-star:hover,
  .review-star:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .review-star.is-active,
  .review-star.is-preview {
    color: #d97706;
    background: rgba(217, 119, 6, 0.08);
    border-color: rgba(217, 119, 6, 0.35);
  }

  .review-star.is-active .review-star-num,
  .review-star.is-preview .review-star-num {
    color: #b45309;
  }

  .review-star:focus-visible {
    box-shadow: 0 0 0 3px rgba(41, 190, 226, 0.35);
  }

  .review-code {
    margin: 0.25rem 0 0;
    padding: 1.15rem 1rem 1.2rem;
    background: var(--light-bg);
    border: 1px dashed rgba(20, 20, 20, 0.18);
  }

  .review-code-label,
  .review-code-note {
    display: block;
    color: var(--muted-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .review-code-value {
    display: block;
    margin: 0.4rem 0 0.35rem;
    color: var(--dark-text);
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.4rem, 10vw, 3.4rem);
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .review-google,
  .review-secondary {
    width: 100%;
    text-align: center;
  }

  .review-secondary {
    padding: 1.15rem 1.5rem;
    background: transparent;
    color: var(--dark-text);
    border: 2px solid var(--dark-text);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .review-secondary:hover,
  .review-secondary:focus-visible {
    background: var(--dark-text);
    color: var(--bone-white);
    outline: none;
  }

  .review-secondary:focus-visible {
    box-shadow: 0 0 0 3px rgba(41, 190, 226, 0.35);
  }

  @media (min-width: 640px) {
    .review-page {
      padding: 8rem 2rem 5rem;
    }

    .review-panel {
      padding: 2.6rem 2.4rem 2.5rem;
    }

    .review-stars {
      gap: 0.65rem;
    }

    .review-star {
      min-height: 6.25rem;
    }

    .review-star svg {
      width: 2.5rem;
      height: 2.5rem;
    }

    .review-google,
    .review-secondary {
      width: auto;
    }
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_CLICKED = 'ljma_review_google_clicked';
    var STORAGE_UNLOCKED = 'ljma_review_code_unlocked';

    var promptEl = document.getElementById('review-prompt');
    var googleEl = document.getElementById('review-google-step');
    var confirmEl = document.getElementById('review-confirm-step');
    var codeEl = document.getElementById('review-code-step');
    var starsEl = document.getElementById('review-stars');
    var googleLink = document.getElementById('review-google');
    var confirmBtn = document.getElementById('review-confirm');
    if (!promptEl || !googleEl || !confirmEl || !codeEl || !starsEl || !googleLink || !confirmBtn) return;

    var panels = {
      prompt: promptEl,
      google: googleEl,
      confirm: confirmEl,
      code: codeEl,
    };
    var buttons = Array.prototype.slice.call(starsEl.querySelectorAll('.review-star'));
    var step = 'prompt';
    var leftTabAfterGoogle = false;
    var returnUnlockBound = false;

    function parseRating(value) {
      var n = Number(value);
      return n >= 1 && n <= 5 && n === Math.floor(n) ? n : null;
    }

    function readStore(key) {
      try { return sessionStorage.getItem(key) === '1'; } catch (_) { return false; }
    }

    function writeStore(key) {
      try { sessionStorage.setItem(key, '1'); } catch (_) {}
    }

    function urlState() {
      try {
        var url = new URL(window.location.href);
        return {
          rating: parseRating(url.searchParams.get('rating')),
          step: url.searchParams.get('step'),
        };
      } catch (_) {
        return { rating: null, step: null };
      }
    }

    function persist(rating, nextStep) {
      try {
        var url = new URL(window.location.href);
        if (rating) url.searchParams.set('rating', String(rating));
        if (nextStep && nextStep !== 'prompt' && nextStep !== 'google') {
          url.searchParams.set('step', nextStep);
        } else {
          url.searchParams.delete('step');
        }
        if (window.history && history.replaceState) {
          history.replaceState(null, '', url.pathname + url.search + url.hash);
        }
      } catch (_) {}
    }

    function paintStars(rating, preview) {
      buttons.forEach(function (btn) {
        var value = Number(btn.getAttribute('data-rating'));
        btn.classList.toggle('is-active', !preview && rating != null && value <= rating);
        btn.classList.toggle('is-preview', preview && rating != null && value <= rating);
        btn.setAttribute('aria-pressed', String(!preview && rating != null && value === rating));
      });
    }

    function showStep(nextStep) {
      step = nextStep;
      Object.keys(panels).forEach(function (name) {
        panels[name].hidden = name !== nextStep;
      });
      var heading = panels[nextStep].querySelector('h1, h2');
      if (heading) heading.setAttribute('tabindex', '-1');
      if (heading && heading.focus) heading.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    function logEvent(name, params) {
      if (typeof gtag === 'function') gtag('event', name, params || {});
    }

    function revealCode(reason) {
      if (step === 'code') return;
      if (!readStore(STORAGE_CLICKED)) return;
      writeStore(STORAGE_UNLOCKED);
      persist(urlState().rating, 'code');
      showStep('code');
      logEvent('review_code_revealed', {
        rating: urlState().rating,
        unlock: reason || 'confirm',
        page_path: window.location.pathname + window.location.search,
      });
    }

    function bindReturnUnlock() {
      if (returnUnlockBound) return;
      returnUnlockBound = true;

      function maybeUnlock() {
        if (step !== 'confirm') return;
        if (!readStore(STORAGE_CLICKED)) return;
        if (!leftTabAfterGoogle) return;
        revealCode('tab-return');
      }

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) leftTabAfterGoogle = true;
        else maybeUnlock();
      });
      window.addEventListener('focus', maybeUnlock);
      window.addEventListener('pageshow', maybeUnlock);
    }

    function goGoogleStep(rating, fromTap) {
      persist(rating, 'google');
      paintStars(rating, false);
      showStep('google');
      if (fromTap) {
        logEvent('review_rating', {
          rating: rating,
          page_path: '/review?rating=' + rating,
        });
      }
    }

    function goConfirmStep() {
      writeStore(STORAGE_CLICKED);
      persist(urlState().rating, 'confirm');
      showStep('confirm');
      bindReturnUnlock();
    }

    var initial = urlState();
    var clicked = readStore(STORAGE_CLICKED);
    var unlocked = readStore(STORAGE_UNLOCKED);

    if (initial.rating && unlocked && clicked) {
      paintStars(initial.rating, false);
      persist(initial.rating, 'code');
      showStep('code');
    } else if (initial.rating && clicked && initial.step === 'confirm') {
      paintStars(initial.rating, false);
      persist(initial.rating, 'confirm');
      showStep('confirm');
      bindReturnUnlock();
    } else if (initial.rating) {
      goGoogleStep(initial.rating, false);
    } else {
      paintStars(null, false);
    }

    starsEl.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.review-star');
      if (!btn) return;
      var rating = parseRating(btn.getAttribute('data-rating'));
      if (!rating) return;
      goGoogleStep(rating, true);
    });

    starsEl.addEventListener('pointerover', function (e) {
      var btn = e.target.closest && e.target.closest('.review-star');
      if (!btn) return;
      paintStars(parseRating(btn.getAttribute('data-rating')), true);
    });

    starsEl.addEventListener('pointerout', function (e) {
      if (e.relatedTarget && starsEl.contains(e.relatedTarget)) return;
      paintStars(urlState().rating, false);
    });

    starsEl.addEventListener('focusin', function (e) {
      var btn = e.target.closest && e.target.closest('.review-star');
      if (!btn) return;
      paintStars(parseRating(btn.getAttribute('data-rating')), true);
    });

    starsEl.addEventListener('focusout', function (e) {
      if (e.relatedTarget && starsEl.contains(e.relatedTarget)) return;
      paintStars(urlState().rating, false);
    });

    googleLink.addEventListener('click', function () {
      logEvent('review_google_click', {
        rating: urlState().rating,
        page_path: '/review?rating=' + (urlState().rating || '') + '&step=confirm',
      });
      goConfirmStep();
    });

    confirmBtn.addEventListener('click', function () {
      revealCode('confirm');
    });
  })();
</script>
