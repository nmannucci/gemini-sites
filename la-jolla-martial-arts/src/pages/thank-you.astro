---
// Conversion confirmation page for PPC landing pages.
// Fires the Google Ads "Submit lead form" conversion on load.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thank You | La Jolla Martial Arts</title>
  <meta name="description" content="Confirmation page for La Jolla Martial Arts trial and class-information requests." />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18166558698"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18166558698');
    gtag('config', 'G-2G50L1RC7D');

    // Fire once only after a successful landing-page submission. Direct visits
    // and reloads must not create duplicate leads or ad conversions.
    try {
      if (sessionStorage.getItem('ljma_confirmed_lead') === '1') {
        sessionStorage.removeItem('ljma_confirmed_lead');
        gtag('event', 'generate_lead', {
          form_id: 'ppc-landing-page-form',
          lead_source: 'ppc-landing-page',
        });
        gtag('event', 'conversion', { send_to: 'AW-18166558698/waUoCJyf_a0cEOrfvtZD' });
      }
    } catch (_) {}
  </script>

  <style is:global>
    :root { --bg:#F5F5F0; --ink:#141414; --muted:#5A5A5A; --red:#D32F2F; --teal:#29BEE2; --orange:#EA580C; --teal-soft:rgba(41,190,226,.12); }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Archivo',system-ui,sans-serif; background:var(--bg); color:var(--ink);
      min-height:100vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:1.5rem;
      background:radial-gradient(ellipse at 50% -10%, var(--teal-soft), transparent 60%), var(--bg); }
    .card { max-width:540px; }
    .tick { width:84px; height:84px; border-radius:50%; background:rgba(15,118,110,.1);
      border:2px solid var(--teal); color:var(--teal); display:flex; align-items:center; justify-content:center; margin:0 auto 1.4rem; }
    h1 { font-family:'Bebas Neue',sans-serif; font-size:3rem; text-transform:uppercase; letter-spacing:.01em; line-height:1; }
    .resp { color:var(--red); font-weight:700; margin:0.9rem 0 0.4rem; font-size:1.1rem; }
    p { color:var(--muted); font-size:1.05rem; line-height:1.6; }
    .btn-call { display:inline-flex; align-items:center; gap:.5rem; margin-top:1.6rem; background:var(--orange);
      color:#fff; font-weight:700; padding:0.95rem 1.6rem; border-radius:10px; }
    img.logo { height:54px; margin:0 auto 2rem; }
  </style>
</head>
<body>
  <div class="card">
    <img class="logo" src="/assets/LJ-martial-arts-logo.PNG" alt="La Jolla Martial Arts" />
    <div class="tick"><i data-lucide="check" style="width:42px;height:42px"></i></div>
    <h1>We'll Text You The Class Details</h1>
    <div class="resp">Keep your phone close — we'll respond in less than 60 seconds.</div>
    <p>Thanks for your request. Keep your phone handy — we'll text or call you right now with the class schedule and how to claim your free week.</p>
    <a class="btn-call" href="tel:8583610961"><i data-lucide="phone"></i> Or call us now: (858) 361-0961</a>
  </div>
  <script is:inline>if (window.lucide) lucide.createIcons();</script>
</body>
</html>
