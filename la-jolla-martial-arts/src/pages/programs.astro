---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

/**
 * Programs hub — same design system as homepage + kids pages.
 * - Archivo body via programPageCss (/program-page.css), same path as kids.
 * - Kids-style full-bleed dark hero + homepage `.program-card` chrome.
 * - Dark #0a0a0a contrast band for Zumba / Game Zone (homepage pattern).
 */
const agePrograms = [
  {
    href: '/little-ninjas',
    image: '/assets/EMA - Post 12.jpg',
    alt: 'Little Ninjas class training at La Jolla Martial Arts',
    badge: 'Ages 3-5',
    age: 'Ages 3-5',
    title: 'Little Ninjas',
    copy: 'Designed specifically for young minds, focusing on fundamental Taekwondo skills, discipline, and respect while having fun in a highly supportive environment.',
    features: ['Focus & Coordination', 'Character building', 'Engaging & fun'],
  },
  {
    href: '/kids-martial-arts',
    image: '/assets/kids-martial-arts-1.webp',
    alt: 'Kids martial arts class at La Jolla Martial Arts',
    badge: 'Kids & Youth',
    age: 'Ages 7-12',
    title: 'Kids Martial Arts',
    copy: 'Build character, self-esteem, and positive energy in a supportive environment. Great for helping kids, including those with ADHD, find structure and discipline.',
    features: ['Anti-bullying skills', 'Confidence building', 'Learn respect & integrity'],
    imageStyle: 'object-position: center top;',
  },
  {
    href: '/teen-martial-arts',
    image: '/assets/EMA - Post 6.jpg',
    alt: 'Teen martial arts students at La Jolla Martial Arts',
    badge: 'Ages 13+',
    age: 'Ages 13 & Up',
    title: 'Teen Martial Arts',
    copy: 'Trains alongside our adult class—an excellent outlet for physical activity while building discipline, focus, and leadership during crucial formative years.',
    features: ['Physical fitness', 'Mental toughness', 'Leadership development'],
  },
  {
    href: '/adult-martial-arts',
    image: '/assets/EMA Image 2.webp',
    alt: 'Adult martial arts class at La Jolla Martial Arts',
    badge: 'Adults',
    age: 'Adults',
    title: 'Adult Classes',
    copy: "Whether you're looking for self-defense, physical fitness, or personal development, our adult classes offer a scientific approach to Taekwondo instruction.",
    features: ['Practical self-defense', 'Stress relief & fitness', 'All experience levels'],
  },
];
---

<Layout
  title="Programs | La Jolla Martial Arts"
  description="Compare Little Ninjas, kids, teen, and adult Taekwondo plus Zumba and the Game Zone at La Jolla Martial Arts in La Jolla."
  canonical="https://lajollatkd.com/programs"
  ogImage="/assets/EMA%20-%20Post.jpg"
  programPageCss
>
  <Fragment slot="head">
    <style is:global>
      /* Hero photo crop — training floor, matching kids program pages. */
      .programs-page .hero-media img {
        object-fit: cover !important;
        object-position: center 28% !important;
      }

      .programs-page .hero {
        min-height: 78vh;
      }

      .programs-page .hero-copy {
        max-width: 820px;
      }

      /* Homepage `.tagline` metrics: 12.8px / 600 / 3.84px tracking. */
      .programs-page .hero-tagline {
        font-family: 'Archivo', sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--blood-red);
        margin-bottom: 1.25rem;
      }

      .programs-page .hero-title {
        font-size: clamp(3.1rem, 7vw, 5.4rem);
        line-height: 0.92;
      }

      .programs-page .hero-title span {
        display: block;
      }

      .programs-page .hero-title .accent {
        color: var(--blood-red);
        -webkit-text-stroke: 0;
      }

      .programs-page .hero-lede {
        font-family: 'Archivo', sans-serif;
        max-width: 560px;
        margin-top: 1.15rem;
        color: rgba(245, 245, 240, 0.78);
        font-size: 1.02rem;
        line-height: 1.7;
      }

      .programs-page .hero-meta {
        margin-top: 1.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        max-width: 520px;
      }

      .programs-page .hero-meta a {
        color: #fff;
        font-weight: 700;
        text-decoration: none;
      }

      .programs-page .hero-meta a:hover {
        color: var(--blood-red);
      }

      .programs-page .hero-meta-address {
        font-family: 'Archivo', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(245, 245, 240, 0.92);
        line-height: 1.45;
      }

      .programs-page .hero-meta-hours {
        font-family: 'Archivo', sans-serif;
        font-size: 0.8rem;
        color: rgba(245, 245, 240, 0.62);
        line-height: 1.5;
      }

      .programs-page .hero-actions {
        margin-top: 2.25rem;
      }

      /* ============================================
         PROGRAMS DIRECTORY — homepage card language
      ============================================ */
      .programs-page .programs-directory {
        background: var(--light-bg);
        color: var(--dark-text);
        padding: 5.5rem 0;
      }

      .programs-page .programs-directory .section-inner {
        width: min(1265px, calc(100% - 3rem));
      }

      .programs-page .programs-header {
        margin-bottom: 3rem;
        max-width: 700px;
      }

      .programs-page .programs-header .section-label {
        font-family: 'Archivo', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: var(--blood-red);
        margin-bottom: 1rem;
        font-weight: 600;
      }

      .programs-page .programs-header .section-title {
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 0.95;
        text-transform: uppercase;
        color: var(--dark-text);
        margin-bottom: 1rem;
      }

      .programs-page .programs-header .section-title .accent {
        color: var(--blood-red);
      }

      .programs-page .programs-header p {
        font-family: 'Archivo', sans-serif;
        color: var(--muted-text);
        line-height: 1.7;
        font-size: 1rem;
      }

      .programs-page .programs-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem; /* 24px — homepage computed */
      }

      .programs-page .program-card {
        background: white;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
        border: 1px solid var(--light-bg-alt);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        display: block;
        color: inherit;
        text-decoration: none;
        cursor: pointer;
      }

      .programs-page .program-card:hover .program-link {
        gap: 1rem;
      }

      .programs-page .program-card::before {
        content: '';
        position: absolute;
        top: 240px;
        left: 1.5rem;
        width: 44px;
        height: 3px;
        background: var(--blood-red);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease, opacity 0.3s ease;
        opacity: 0;
        z-index: 2;
      }

      .programs-page .program-card:hover {
        border-color: var(--blood-red);
        transform: translateY(-8px);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.12);
      }

      .programs-page .program-card:hover::before {
        opacity: 1;
        transform: scaleX(1);
      }

      .programs-page .program-image {
        position: relative;
        width: 100%;
        height: 240px;
        overflow: hidden;
      }

      .programs-page .program-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s ease, filter 0.3s ease;
        filter: saturate(1.02);
      }

      .programs-page .program-card:hover .program-image img {
        transform: scale(1.06);
        filter: saturate(1.08);
      }

      .programs-page .program-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: inline-block;
        background: var(--blood-red);
        color: var(--bone-white);
        padding: 0.45rem 0.85rem;
        font-family: 'Archivo', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        z-index: 2;
      }

      .programs-page .program-body {
        padding: 1.5rem 1.5rem 1.8rem;
      }

      .programs-page .program-title {
        font-size: 1.35rem; /* 21.6px @ 16px root — homepage computed */
        text-transform: none;
        margin-bottom: 0.35rem;
        line-height: 1.1;
        color: var(--dark-text);
      }

      .programs-page .program-age {
        font-family: 'Archivo', sans-serif;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        text-transform: none;
        color: var(--blood-red);
        margin-bottom: 0.85rem;
        font-weight: 500;
        font-style: italic;
      }

      .programs-page .program-description {
        font-family: 'Archivo', sans-serif;
        font-size: 0.92rem;
        color: var(--muted-text);
        line-height: 1.65;
        margin-bottom: 1.35rem;
      }

      .programs-page .program-features {
        list-style: none;
        margin: 0 0 1.5rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .programs-page .program-features li {
        font-family: 'Archivo', sans-serif;
        font-size: 0.82rem;
        color: var(--muted-text);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .programs-page .program-features li::before {
        content: '';
        width: 6px;
        height: 6px;
        background: var(--blood-red);
        flex-shrink: 0;
        transform: rotate(45deg);
      }

      .programs-page .program-link {
        font-family: 'Archivo', sans-serif;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--blood-red);
        text-decoration: none;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: gap 0.3s ease;
      }

      .programs-page .programs-footer {
        margin-top: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        text-align: center;
      }

      .programs-page .programs-footer p {
        font-family: 'Archivo', sans-serif;
        color: var(--muted-text);
        font-size: 1rem;
        font-style: italic;
        max-width: 420px;
        line-height: 1.55;
      }

      .programs-page .programs-footer strong {
        color: var(--dark-text);
        font-style: normal;
      }

      .programs-page .programs-footer a:not(.btn-primary) {
        color: var(--dark-text);
        font-weight: 700;
        font-style: normal;
      }

      /* ============================================
         DARK BAND — Zumba + Game Zone (home rhythm)
      ============================================ */
      .programs-page .hub-dark-band {
        background:
          radial-gradient(70% 80% at 8% 10%, rgba(41, 190, 226, 0.16), transparent 60%),
          radial-gradient(70% 90% at 100% 100%, rgba(255, 46, 151, 0.14), transparent 60%),
          #0a0a0a;
        color: var(--bone-white);
        position: relative;
        overflow: hidden;
        padding: 5.5rem 0;
      }

      .programs-page .hub-dark-band::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-size: 46px 46px;
        -webkit-mask-image: radial-gradient(circle at 30% 40%, #000, transparent 75%);
        mask-image: radial-gradient(circle at 30% 40%, #000, transparent 75%);
        pointer-events: none;
      }

      .programs-page .hub-dark-inner {
        position: relative;
        z-index: 1;
        width: min(1265px, calc(100% - 3rem));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }

      .programs-page .hub-dark-card {
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
        padding: 2rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .programs-page .hub-dark-card .section-label {
        font-family: 'Archivo', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--blood-red);
        margin-bottom: 0;
        font-weight: 700;
      }

      .programs-page .hub-dark-card h2 {
        font-size: clamp(2.2rem, 4vw, 3.1rem);
        line-height: 0.95;
        text-transform: uppercase;
        color: var(--bone-white);
      }

      .programs-page .hub-dark-card h2 .accent {
        color: var(--blood-red);
      }

      .programs-page .hub-dark-card h2 .gz-neon {
        color: var(--blood-red);
        text-shadow: 0 0 18px rgba(41, 190, 226, 0.85), 0 0 44px rgba(41, 190, 226, 0.45);
      }

      .programs-page .hub-dark-card p {
        font-family: 'Archivo', sans-serif;
        color: rgba(245, 245, 240, 0.74);
        line-height: 1.7;
        font-size: 0.98rem;
        max-width: 460px;
      }

      .programs-page .hub-dark-media {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
      }

      .programs-page .hub-dark-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .programs-page .hub-dark-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: auto;
      }

      .programs-page .hub-dark-actions .btn-secondary {
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: var(--bone-white);
      }

      @media (max-width: 1200px) {
        .programs-page .programs-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 900px) {
        .programs-page .hub-dark-inner {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 768px) {
        .programs-page .hero {
          min-height: auto;
        }

        .programs-page .hero-title {
          font-size: clamp(2.6rem, 12vw, 3.5rem);
          line-height: 1;
        }

        .programs-page .programs-directory {
          padding: 3.5rem 0;
        }

        .programs-page .programs-directory .section-inner,
        .programs-page .hub-dark-inner {
          width: min(1265px, calc(100% - 2rem));
        }

        .programs-page .programs-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .programs-page .hub-dark-band {
          padding: 3.5rem 0;
        }

        .programs-page .hub-dark-card {
          padding: 1.5rem;
        }

        .programs-page .hero-actions {
          flex-direction: column;
          gap: 0.75rem;
        }

        .programs-page .hero-actions .btn-primary,
        .programs-page .hero-actions .btn-secondary,
        .programs-page .programs-footer .btn-primary,
        .programs-page .hub-dark-actions .btn-primary,
        .programs-page .hub-dark-actions .btn-secondary {
          width: 100%;
          text-align: center;
        }

        .programs-page .programs-footer {
          flex-direction: column;
          gap: 1.1rem;
        }
      }
    </style>
  </Fragment>

  <div class="programs-page">
    <header class="hero">
      <div class="hero-media">
        <img
          src="/assets/EMA - Post.jpg"
          alt="Students training at La Jolla Martial Arts"
          title="Students training at La Jolla Martial Arts"
        />
      </div>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-tagline">La Jolla's Premier Taekwondo Academy</p>
          <h1 class="hero-title font-display" id="programs-hub-title">
            <span>Programs at</span>
            <span><span class="accent">La Jolla</span> Martial Arts</span>
          </h1>
          <p class="hero-lede">
            Age-based Taekwondo, Zumba dance fitness, and the interactive Game Zone
            — all under one roof in La Jolla.
          </p>

          <div class="hero-meta" aria-label="Location and hours">
            <p class="hero-meta-address">
              {site.address} ·
              <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
            </p>
            <p class="hero-meta-hours">{site.hoursOneLine}</p>
          </div>

          <div class="hero-actions">
            <a href="/contact" class="btn-primary">Claim Free Week</a>
            <a href="/schedule" class="btn-secondary">View Schedule</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="section programs-directory" aria-labelledby="programs-directory-title">
        <div class="section-inner">
          <header class="programs-header">
            <p class="section-label">Our Programs</p>
            <h2 class="section-title font-display" id="programs-directory-title">
              Taekwondo For <span class="accent">Every</span> Age
            </h2>
            <p>
              Programs designed to leave a lasting positive impact. Whether your child is
              stepping onto the mat for the first time or you're an adult looking for fitness,
              we have a structured program built for you.
            </p>
          </header>

          <div class="programs-grid" aria-label="Age-based Taekwondo programs">
            {agePrograms.map((program) => (
              <a class="program-card" href={program.href}>
                <div class="program-image">
                  <img
                    src={program.image}
                    alt={program.alt}
                    title={program.alt}
                    style={program.imageStyle}
                    loading="lazy"
                  />
                  <span class="program-badge">{program.badge}</span>
                </div>
                <div class="program-body">
                  <h3 class="program-title font-display">{program.title}</h3>
                  <p class="program-age">{program.age}</p>
                  <p class="program-description">{program.copy}</p>
                  <ul class="program-features">
                    {program.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                  <span class="program-link">Learn More →</span>
                </div>
              </a>
            ))}
          </div>

          <div class="programs-footer">
            <p>
              Not sure which class is right?
              <strong> Try our 1 Week FREE Martial Arts Classes.</strong>
            </p>
            <a href="/contact" class="btn-primary">Claim Your Free Week</a>
          </div>
        </div>
      </section>

      <section class="hub-dark-band" aria-label="Zumba and Game Zone">
        <div class="hub-dark-inner">
          <article class="hub-dark-card">
            <p class="section-label">New · Zumba classes</p>
            <div class="hub-dark-media">
              <img
                src="/assets/zumba-banner.jpeg"
                alt="Zumba dance fitness at La Jolla Martial Arts"
                title="Zumba dance fitness at La Jolla Martial Arts"
                loading="lazy"
                style="object-position: center 18%;"
              />
            </div>
            <h2 class="font-display">
              Dance. Sweat. <span class="accent">Smile.</span>
            </h2>
            <p>
              45-minute dance fitness every Friday and Saturday, 10:30am–11:15am.
              First week free. No dance experience required.
            </p>
            <div class="hub-dark-actions">
              <a href="/zumba#zumba-signup" class="btn-primary">Claim My Free Week</a>
              <a href="/zumba" class="btn-secondary">Learn About Zumba</a>
            </div>
          </article>

          <article class="hub-dark-card">
            <p class="section-label">New · Interactive Game Zone</p>
            <div class="hub-dark-media">
              <img
                src="/assets/gamezone-jumper-1.webp"
                alt="Child jumping on the Jumper AR trampoline in the Game Zone"
                title="Child jumping on the Jumper AR trampoline in the Game Zone"
                loading="lazy"
              />
            </div>
            <h2 class="font-display">
              Step Into The <span class="gz-neon">Game Zone</span>
            </h2>
            <p>
              AR trampoline and wall laser arena inside the dojo. Open play, class rewards,
              and birthday parties for ages 6+.
            </p>
            <div class="hub-dark-actions">
              <a href="/game-zone" class="btn-primary">Explore The Game Zone</a>
              <a href="/birthday-parties" class="btn-secondary">Book A Party</a>
            </div>
          </article>
        </div>
      </section>
    </main>
  </div>
</Layout>
