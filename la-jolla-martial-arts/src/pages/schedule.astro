---
import Layout from '../layouts/Layout.astro';
import ScheduleMobile from '../components/ScheduleMobile.astro';
import { site } from '../data/site';
---

<Layout
  title={`Class Schedule | La Jolla Martial Arts`}
  description={`Weekly La Jolla Martial Arts class schedule for Little Ninjas, Kids, Teens, Adults, and Zumba dance fitness classes.`}
  canonical={`https://lajollatkd.com/schedule`}
>
  <Fragment slot="head">
<style is:global>

    :root {
      --blood-red: #29BEE2;
      --deep-black: #0A0A0A;
      --bone-white: #F5F5F0;
      --steel-gray: #3A3A3A;
      --off-black: #141414;
      --light-bg: #F5F5F0;
      --light-bg-alt: #EAEAE5;
      --dark-text: #1A1A1A;
      --muted-text: #5A5A5A;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Archivo', sans-serif;
      background: var(--deep-black);
      color: var(--bone-white);
      overflow-x: hidden;
    }

    .font-display { font-family: 'Bebas Neue', sans-serif; }


    /* HERO (tight, like about) */
    .hero {
      min-height: 58vh; position: relative;
      display: flex; align-items: center;
      overflow: hidden;
      background: var(--deep-black); color: var(--bone-white);
    }
    .hero-background { position: absolute; inset: 0; z-index: 1; }
    .hero-background img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center 35%;
    }
    .hero-background::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(
        to right,
        rgba(10,10,10,0.93) 0%,
        rgba(10,10,10,0.82) 45%,
        rgba(10,10,10,0.55) 80%,
        rgba(10,10,10,0.35) 100%
      );
    }
    .hero-container {
      position: relative; z-index: 10;
      width: 100%; margin: 0 auto;
      padding: 8rem 4rem 4rem;
      max-width: 1400px;
    }
    .hero-left { max-width: 820px; }
    .tagline {
      font-size: 0.8rem; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--blood-red);
      font-weight: 600; margin-bottom: 1.25rem;
    }
    .hero-title {
      font-size: clamp(3.5rem, 8.5vw, 7rem);
      line-height: 0.92; text-transform: uppercase;
      margin-bottom: 1.25rem; color: var(--bone-white);
    }
    .hero-title span { display: block; }
    .hero-title .accent { color: var(--blood-red); }
    .hero-subtitle {
      font-size: 1.05rem; max-width: 560px; line-height: 1.65;
      color: rgba(255,255,255,0.75); margin-bottom: 0;
    }

    /* SECTION UTILITIES */
    .section { padding: 5.5rem 4rem; position: relative; }
    .section-inner { max-width: 1400px; margin: 0 auto; }
    .section-label {
      font-size: 0.75rem; letter-spacing: 0.4em;
      text-transform: uppercase; color: var(--blood-red);
      margin-bottom: 1rem; font-weight: 600;
    }
    .section-title {
      font-size: clamp(2rem, 4vw, 3.25rem);
      line-height: 0.95; text-transform: uppercase;
      margin-bottom: 1.5rem;
    }
    .section-title .accent { color: var(--blood-red); }
    .section-intro {
      color: var(--muted-text); line-height: 1.7;
      font-size: 1rem; max-width: 720px;
    }

    .btn-primary {
      padding: 1.15rem 2.25rem; background: var(--blood-red);
      color: var(--bone-white); font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      font-size: 0.85rem; border: none; cursor: pointer;
      position: relative; overflow: hidden;
      transition: transform 0.3s ease;
      text-decoration: none; display: inline-block;
    }
    .btn-primary::after {
      content: ''; position: absolute;
      top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s ease;
    }
    .btn-primary:hover { transform: translateY(-2px); }
    .btn-primary:hover::after { left: 100%; }

    /* SCHEDULE BOARD */
    .schedule-wrap {
      background: var(--light-bg-alt);
      color: var(--dark-text);
    }
    .schedule-head {
      margin-bottom: 2.5rem;
      max-width: 760px;
    }
    .schedule-head p.section-intro { margin-top: 1rem; }

    .schedule-board {
      background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(245,245,240,0.94));
      border: 1px solid rgba(20,20,20,0.08);
      box-shadow: 0 24px 60px rgba(10,10,10,0.1);
      padding: 1rem;
    }
    .schedule-board-scroll { overflow-x: auto; }
    .schedule-grid {
      min-width: 980px;
      display: grid;
      grid-template-columns: 160px repeat(7, minmax(112px, 1fr));
      gap: 0.65rem;
    }
    .schedule-corner, .schedule-day, .schedule-time, .schedule-slot {
      min-height: 88px; padding: 0.85rem;
      display: flex; align-items: center; justify-content: center;
      text-align: center;
    }
    .schedule-corner, .schedule-day {
      min-height: 60px;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.05rem; letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .schedule-corner { background: #ecebe7; color: var(--dark-text); }
    .schedule-day { background: var(--blood-red); color: var(--bone-white); }
    .schedule-time {
      background: #ecebe7; color: var(--dark-text);
      font-size: 0.95rem; font-weight: 700; line-height: 1.3;
    }
    .schedule-slot {
      position: relative;
      background: rgba(234,234,229,0.6);
      border: 1px solid rgba(20,20,20,0.05);
      color: var(--dark-text);
    }
    .schedule-slot strong {
      display: block;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.2rem; line-height: 1.05;
      letter-spacing: 0.03em; text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .schedule-slot span {
      display: block; font-size: 0.75rem; line-height: 1.4;
      color: rgba(26,26,26,0.72);
    }
    .schedule-slot--little {
      background: linear-gradient(180deg, #fde8b8, #f9d682);
      border-color: rgba(180,120,20,0.18);
    }
    .schedule-slot--kids {
      background: linear-gradient(180deg, #d8f3ef, #b8ebe3);
      border-color: rgba(15,118,110,0.18);
    }
    .schedule-slot--teen {
      background: linear-gradient(180deg, #f6b9b0, #ef8f82);
      border-color: rgba(153,27,27,0.22);
      color: #3a0d0d;
    }
    .schedule-slot--teen span { color: rgba(58,13,13,0.78); }
    .schedule-slot--combo {
      background: linear-gradient(180deg, #f9d9d4, #f3b7af);
      border-color: rgba(153,27,27,0.18);
    }
    .schedule-slot--zumba {
      background: linear-gradient(145deg, #f9f7bf, #d7ef50);
      border-color: rgba(117, 134, 0, 0.28);
      color: #2d3300;
    }
    .schedule-slot--zumba span { color: rgba(45, 51, 0, 0.76); }
    .schedule-slot--private {
      background: linear-gradient(180deg, #fde7d2, #f8c98e);
      border-color: rgba(176, 96, 18, 0.25);
      color: #5a3210;
    }
    .schedule-slot--private strong { color: #5a3210; }
    .schedule-slot--private span { color: rgba(90, 50, 16, 0.85); }

    .schedule-slot--closed {
      background:
        linear-gradient(135deg, rgba(20,20,20,0.025) 25%, transparent 25%, transparent 50%, rgba(20,20,20,0.025) 50%, rgba(20,20,20,0.025) 75%, transparent 75%, transparent),
        #f1f1ed;
      background-size: 20px 20px;
      color: rgba(26,26,26,0.52);
    }
    .schedule-slot--closed strong { margin-bottom: 0; font-size: 1.05rem; }

    @media (max-width: 820px) {
      .schedule-board-scroll { display: none; }
    }

    /* LEGEND */
    .legend {
      display: flex; flex-wrap: wrap; gap: 1rem;
      margin-top: 1.75rem;
    }
    .legend-chip {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-size: 0.72rem; letter-spacing: 0.15em;
      text-transform: uppercase; color: var(--dark-text);
      font-weight: 600;
    }
    .legend-swatch {
      width: 18px; height: 18px; border: 1px solid rgba(20,20,20,0.12);
    }
    .legend-swatch.little { background: linear-gradient(180deg, #fde8b8, #f9d682); }
    .legend-swatch.kids { background: linear-gradient(180deg, #d8f3ef, #b8ebe3); }
    .legend-swatch.teen { background: linear-gradient(180deg, #f6b9b0, #ef8f82); }
    .legend-swatch.combo { background: linear-gradient(180deg, #f9d9d4, #f3b7af); }
    .legend-swatch.zumba { background: linear-gradient(145deg, #f9f7bf, #d7ef50); }
    .legend-swatch.closed {
      background:
        linear-gradient(135deg, rgba(20,20,20,0.06) 25%, transparent 25%, transparent 50%, rgba(20,20,20,0.06) 50%, rgba(20,20,20,0.06) 75%, transparent 75%, transparent),
        #f1f1ed;
      background-size: 8px 8px;
    }

    /* INFO STRIP */
    .info-strip {
      background: var(--deep-black); color: var(--bone-white);
      padding: 3.5rem 4rem;
    }
    .info-strip-inner {
      max-width: 1400px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
    .info-card {
      display: flex; gap: 1rem; align-items: flex-start;
    }
    .info-card .icon-wrap {
      width: 42px; height: 42px; flex-shrink: 0;
      background: rgba(41,190,226,0.15);
      border: 1px solid rgba(41,190,226,0.45);
      color: var(--blood-red);
      display: flex; align-items: center; justify-content: center;
    }
    .info-card .icon-wrap i { width: 18px; height: 18px; }
    .info-card h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.3rem; letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .info-card p {
      font-size: 0.92rem; line-height: 1.6;
      color: rgba(245,245,240,0.68);
    }
    .info-card a { color: var(--bone-white); text-decoration: none; border-bottom: 1px solid rgba(245,245,240,0.3); }
    .info-card a:hover { color: var(--blood-red); border-color: var(--blood-red); }

    /* CTA */
    .schedule-cta {
      background: var(--light-bg);
      color: var(--dark-text);
      padding: 6rem 4rem;
      text-align: center;
    }
    .schedule-cta h2 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.25rem, 4.5vw, 3.75rem);
      line-height: 0.95; text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .schedule-cta h2 .accent { color: var(--blood-red); }
    .schedule-cta p {
      color: var(--muted-text); line-height: 1.7;
      max-width: 560px; margin: 0 auto 2rem;
    }

    /* FOOTER */
    .footer {
      background: var(--off-black);
      padding: 2.5rem 4rem;
      border-top: 1px solid var(--steel-gray);
    }
    .footer-content {
      max-width: 1400px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-logo {
      font-size: 1.25rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
    }
    .footer-logo span { color: var(--blood-red); }
    .footer-info { text-align: center; }
    .footer-info p { font-size: 0.8rem; color: #6B6B6B; }
    .footer-info a { color: var(--bone-white); text-decoration: none; }
    .footer-info a:hover { color: var(--blood-red); }
    .footer-social { display: flex; gap: 1rem; }
    .footer-social a {
      width: 40px; height: 40px;
      background: var(--steel-gray);
      display: flex; align-items: center; justify-content: center;
      color: var(--bone-white); text-decoration: none;
      transition: all 0.3s ease;
    }
    .footer-social a:hover { background: var(--blood-red); }
    .footer-social svg { width: 18px; height: 18px; }

    /* RESPONSIVE */
    @media (max-width: 960px) {
      .hero-container { padding: 7rem 1.5rem 3rem; }
      .section { padding: 4rem 1.5rem; }
      .info-strip { padding: 3rem 1.5rem; }
      .info-strip-inner { grid-template-columns: 1fr; gap: 1.75rem; }
      .schedule-cta { padding: 4.5rem 1.5rem; }
      .footer { padding: 2rem 1.5rem; }
      .footer-content { flex-direction: column; gap: 1.25rem; text-align: center; }
    }
    @media (max-width: 640px) {
      .hero-container { padding: 6rem 1.25rem 2.5rem; }
      .hero-title, .section-title { font-size: clamp(1.9rem, 9vw, 2.75rem); line-height: 1.05; }
      .section { padding: 3rem 1.25rem; }
      .info-strip { padding: 2.25rem 1.25rem; }
      .schedule-cta { padding: 3rem 1.25rem; }
      .cta-group { flex-direction: column; gap: 0.75rem; }
      .btn-primary, .btn-secondary { width: 100%; text-align: center; }
    }
    @media (max-width: 400px) {
      .hero-container { padding: 5.5rem 1rem 2rem; }
      .section { padding: 2.75rem 1rem; }
    }


</style>

  </Fragment>
<!-- HERO -->
  <header class="hero">
    <div class="hero-background">
      <img src="/assets/EMA - Post 2.jpg" alt="La Jolla Martial Arts class in session">
    </div>
    <div class="hero-container">
      <div class="hero-left">
        <p class="tagline">Weekly Class Times</p>
        <h1 class="hero-title font-display">
          <span>Class</span>
          <span><span class="accent">Schedule.</span></span>
        </h1>
        <p class="hero-subtitle">
          Martial arts Monday through Thursday plus Saturday morning, with
          Zumba classes every Friday and Saturday.
        </p>
      </div>
    </div>
  </header>

  <!-- SCHEDULE BOARD -->
  <section class="section schedule-wrap">
    <div class="section-inner">
      <div class="schedule-head">
        <p class="section-label">Weekly Schedule</p>
        <h2 class="section-title font-display">
          Find A Class <span class="accent">That Fits.</span>
        </h2>
        <p class="section-intro">
          Classes are broken out by age and experience level so every student
          trains with the right group. Zumba runs Friday and Saturday from
          10:30am to 11:15am. Closed Sundays.
        </p>
      </div>

      <div class="schedule-board">
        <div class="schedule-board-scroll">
          <div class="schedule-grid" role="table" aria-label="La Jolla Martial Arts weekly class schedule">
            <div class="schedule-corner" role="columnheader">Time</div>
            <div class="schedule-day" role="columnheader">Mon</div>
            <div class="schedule-day" role="columnheader">Tue</div>
            <div class="schedule-day" role="columnheader">Wed</div>
            <div class="schedule-day" role="columnheader">Thu</div>
            <div class="schedule-day" role="columnheader">Fri</div>
            <div class="schedule-day" role="columnheader">Sat</div>
            <div class="schedule-day" role="columnheader">Sun</div>

            <div class="schedule-time" role="rowheader">9:00am – 9:45am</div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--private" role="cell"><div><strong>Private Lessons</strong><span>By appointment</span></div></div>
            <div class="schedule-slot schedule-slot--combo" role="cell">
              <div>
                <strong>Little Ninjas &amp; Kids</strong>
                <span>Ages 3–12</span>
              </div>
            </div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>

            <div class="schedule-time" role="rowheader">10:30am – 11:15am</div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--zumba" role="cell"><div><strong>Zumba</strong><span>Dance fitness</span></div></div>
            <div class="schedule-slot schedule-slot--zumba" role="cell"><div><strong>Zumba</strong><span>Dance fitness</span></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>

            <div class="schedule-time" role="rowheader">3:30pm – 4:00pm</div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--private" role="cell"><div><strong>Private Lessons</strong><span>By appointment</span></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>

            <div class="schedule-time" role="rowheader">4:00pm – 4:30pm</div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--little" role="cell"><div><strong>Little Ninjas</strong><span>Ages 3–6</span></div></div>
            <div class="schedule-slot schedule-slot--private" role="cell"><div><strong>Private Lessons</strong><span>By appointment</span></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>

            <div class="schedule-time" role="rowheader">4:30pm – 5:15pm</div>
            <div class="schedule-slot schedule-slot--kids" role="cell"><div><strong>Kids Martial Arts</strong><span>Ages 7–12</span></div></div>
            <div class="schedule-slot schedule-slot--kids" role="cell"><div><strong>Kids Martial Arts</strong><span>Ages 7–12</span></div></div>
            <div class="schedule-slot schedule-slot--kids" role="cell"><div><strong>Kids Martial Arts</strong><span>Ages 7–12</span></div></div>
            <div class="schedule-slot schedule-slot--kids" role="cell"><div><strong>Kids Martial Arts</strong><span>Ages 7–12</span></div></div>
            <div class="schedule-slot schedule-slot--private" role="cell"><div><strong>Private Lessons</strong><span>By appointment</span></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>

            <div class="schedule-time" role="rowheader">5:15pm – 6:15pm</div>
            <div class="schedule-slot schedule-slot--teen" role="cell"><div><strong>Teen &amp; Adult</strong><span>Ages 13+</span></div></div>
            <div class="schedule-slot schedule-slot--teen" role="cell"><div><strong>Teen &amp; Adult</strong><span>Ages 13+</span></div></div>
            <div class="schedule-slot schedule-slot--teen" role="cell"><div><strong>Teen &amp; Adult</strong><span>Ages 13+</span></div></div>
            <div class="schedule-slot schedule-slot--teen" role="cell"><div><strong>Teen &amp; Adult</strong><span>Ages 13+</span></div></div>
            <div class="schedule-slot schedule-slot--private" role="cell"><div><strong>Private Lessons</strong><span>By appointment</span></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
            <div class="schedule-slot schedule-slot--closed" role="cell"><div><strong>Closed</strong></div></div>
          </div>
        </div>

        <ScheduleMobile />
      </div>

      <div class="legend" aria-label="Schedule legend">
        <span class="legend-chip"><span class="legend-swatch little"></span>Little Ninjas</span>
        <span class="legend-chip"><span class="legend-swatch kids"></span>Kids</span>
        <span class="legend-chip"><span class="legend-swatch teen"></span>Teen &amp; Adult</span>
        <span class="legend-chip"><span class="legend-swatch combo"></span>Combo</span>
        <span class="legend-chip"><span class="legend-swatch zumba"></span>Zumba</span>
        <span class="legend-chip"><span class="legend-swatch closed"></span>Closed</span>
      </div>
    </div>
  </section>

  <!-- INFO STRIP -->
  <section class="info-strip">
    <div class="info-strip-inner">
      <div class="info-card">
        <span class="icon-wrap"><i data-lucide="map-pin"></i></span>
        <div>
          <h3>Location</h3>
          <p>{site.brand}<br>{site.streetAddress}<br>{site.addressLocality}, {site.addressRegion} {site.postalCode}</p>
        </div>
      </div>
      <div class="info-card">
        <span class="icon-wrap"><i data-lucide="clock"></i></span>
        <div>
          <h3>Hours</h3>
          <p>{site.hoursOneLine}</p>
        </div>
      </div>
      <div class="info-card">
        <span class="icon-wrap"><i data-lucide="phone"></i></span>
        <div>
          <h3>Questions?</h3>
          <p>Call <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="schedule-cta">
    <p class="section-label">Try A Week Free</p>
    <h2>Not Sure Which Class? <span class="accent">Come Try One.</span></h2>
    <p>
      Your first week is on us. Pick a time that works and our head instructor
      will place you or your child in the right group on day one.
    </p>
    <a href="/contact" class="btn-primary">Claim Your Free Week</a>
  </section>

</Layout>
