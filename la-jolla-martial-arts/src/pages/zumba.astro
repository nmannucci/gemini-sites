---
import Layout from '../layouts/Layout.astro';
import '../styles/site-theme.css';

const SITE = 'https://lajollatkd.com';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Zumba Classes in La Jolla',
  description:
    'Zumba dance fitness classes at La Jolla Martial Arts. Fridays and Saturdays from 10:30am to 11:15am, with 45-minute classes at $45 per class.',
  url: `${SITE}/zumba`,
  areaServed: { '@type': 'City', name: 'La Jolla' },
  provider: {
    '@type': 'MartialArtsSchool',
    '@id': `${SITE}/#business`,
    name: 'La Jolla Martial Arts',
    telephone: '+1-858-361-0961',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '7680 Girard Ave, Basement',
      addressLocality: 'La Jolla',
      addressRegion: 'CA',
      postalCode: '92037',
      addressCountry: 'US',
    },
  },
  offers: {
    '@type': 'Offer',
    price: '45',
    priceCurrency: 'USD',
    description: 'One 45-minute Zumba class',
    availability: 'https://schema.org/InStock',
  },
};
---

<Layout
  title="Zumba Classes in La Jolla, CA | Dance Fitness"
  description="Try a Zumba class at La Jolla Martial Arts. Friday and Saturday from 10:30am to 11:15am — 45-minute dance fitness classes in La Jolla."
  canonical={`${SITE}/zumba`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <style is:global>
      :root {
        --zumba-pink: #f50768;
        --zumba-lime: #c9e500;
        --zumba-yellow: #ffd93d;
      }

      .zumba-page {
        background: var(--bone-white);
        color: var(--dark-text);
      }

      .zumba-hero {
        min-height: 760px;
        padding: 9rem 4rem 5rem;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        background:
          radial-gradient(circle at 72% 18%, rgba(41, 190, 226, 0.2), transparent 26%),
          radial-gradient(circle at 86% 80%, rgba(245, 7, 104, 0.19), transparent 31%),
          #0a0a0a;
      }

      .zumba-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.17;
        background-image: repeating-linear-gradient(115deg, transparent 0 34px, rgba(255,255,255,0.08) 34px 35px);
      }

      .zumba-hero-inner {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.75fr);
        gap: clamp(3rem, 7vw, 7rem);
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .zumba-kicker,
      .zumba-section-label {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--blood-red);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }

      .zumba-kicker::before,
      .zumba-section-label::before {
        content: '';
        width: 30px;
        height: 2px;
        background: currentColor;
      }

      .zumba-title {
        max-width: 820px;
        margin: 1.15rem 0 1.4rem;
        color: #fff;
        font-size: clamp(4.7rem, 10vw, 9.4rem);
        line-height: 0.78;
        letter-spacing: -0.025em;
        text-transform: uppercase;
      }

      .zumba-title span { display: block; }
      .zumba-title .zumba-title-accent { color: var(--zumba-lime); }

      .zumba-lede {
        max-width: 610px;
        color: rgba(255,255,255,0.76);
        font-size: clamp(1rem, 1.7vw, 1.18rem);
        line-height: 1.7;
      }

      .zumba-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin: 2rem 0 2.25rem;
      }

      .zumba-meta-chip {
        padding: 0.7rem 0.9rem;
        border: 1px solid rgba(255,255,255,0.18);
        color: #fff;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: rgba(255,255,255,0.05);
      }

      .zumba-meta-chip--soon {
        color: #0a0a0a;
        background: var(--zumba-lime);
        border-color: var(--zumba-lime);
      }

      .zumba-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
      }

      .zumba-text-link {
        min-height: 52px;
        padding: 0 1.35rem;
        display: inline-flex;
        align-items: center;
        color: #fff;
        border: 1px solid rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: border-color 0.25s ease, background 0.25s ease;
      }

      .zumba-text-link:hover { border-color: #fff; background: rgba(255,255,255,0.08); }

      .zumba-poster {
        position: relative;
        overflow: hidden;
        background: #fff7de;
        transform: rotate(2.2deg);
        box-shadow: 24px 28px 0 rgba(41,190,226,0.18), 0 38px 80px rgba(0,0,0,0.35);
      }

      .zumba-poster img {
        display: block;
        width: 100%;
        height: auto;
      }

      .zumba-facts {
        padding: 5.5rem 4rem;
        background: var(--bone-white);
      }

      .zumba-inner { max-width: 1400px; margin: 0 auto; }

      .zumba-facts-head {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 4rem;
        align-items: end;
        margin-bottom: 2.7rem;
      }

      .zumba-section-title {
        margin-top: 1rem;
        font-size: clamp(2.8rem, 5vw, 5.2rem);
        line-height: 0.9;
        text-transform: uppercase;
      }

      .zumba-facts-head > p {
        color: var(--muted-text);
        font-size: 1rem;
        line-height: 1.75;
      }

      .zumba-fact-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid rgba(10,10,10,0.12);
        border-bottom: 1px solid rgba(10,10,10,0.12);
      }

      .zumba-fact {
        min-height: 205px;
        padding: 2rem;
        border-right: 1px solid rgba(10,10,10,0.12);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .zumba-fact:last-child { border-right: 0; }
      .zumba-fact i { width: 28px; height: 28px; color: var(--blood-red); }
      .zumba-fact:nth-child(2) i { color: var(--zumba-pink); }
      .zumba-fact:nth-child(3) i { color: var(--orange); }
      .zumba-fact:nth-child(4) i { color: #758600; }
      .zumba-fact strong { display: block; font-family: 'Bebas Neue', sans-serif; font-size: 2rem; line-height: 1; }
      .zumba-fact span { display: block; margin-top: 0.4rem; color: var(--muted-text); font-size: 0.82rem; line-height: 1.5; }

      .zumba-benefits {
        padding: 6rem 4rem;
        background: #111;
        color: #fff;
      }

      .zumba-benefits-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: center;
      }

      .zumba-benefits-copy p:not(.zumba-section-label) {
        max-width: 560px;
        margin-top: 1.5rem;
        color: rgba(255,255,255,0.68);
        line-height: 1.75;
      }

      .zumba-benefit-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .zumba-benefit {
        min-height: 170px;
        padding: 1.5rem;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.035);
      }

      .zumba-benefit i { color: var(--zumba-lime); width: 25px; height: 25px; margin-bottom: 1.3rem; }
      .zumba-benefit h3 { font-size: 1rem; margin-bottom: 0.45rem; }
      .zumba-benefit p { color: rgba(255,255,255,0.58); font-size: 0.84rem; line-height: 1.55; }

      .zumba-signup {
        padding: 6rem 4rem;
        background:
          linear-gradient(135deg, rgba(41,190,226,0.11), transparent 42%),
          var(--light-bg-alt);
      }

      .zumba-signup-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: start;
      }

      .zumba-signup-copy p:not(.zumba-section-label) {
        max-width: 530px;
        margin: 1.3rem 0 1.8rem;
        color: var(--muted-text);
        line-height: 1.75;
      }

      .zumba-note {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        padding: 1rem 1.1rem;
        border-left: 4px solid var(--zumba-pink);
        background: rgba(255,255,255,0.72);
        font-size: 0.82rem;
        line-height: 1.55;
      }

      .zumba-note i { width: 20px; height: 20px; flex: 0 0 auto; color: var(--zumba-pink); }

      .zumba-form {
        padding: clamp(1.5rem, 4vw, 2.6rem);
        background: #fff;
        box-shadow: 0 24px 70px rgba(10,10,10,0.12);
        border-top: 5px solid var(--zumba-lime);
      }

      .zumba-form-head { margin-bottom: 1.6rem; }

      .zumba-form-head strong {
        display: block;
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(2rem, 4vw, 2.7rem);
        line-height: 1;
        text-transform: uppercase;
      }

      .zumba-form-head span {
        display: block;
        margin-top: 0.55rem;
        color: var(--muted-text);
        font-size: 0.84rem;
        line-height: 1.55;
      }

      .zumba-form .form-input,
      .zumba-form .form-select { min-height: 48px; }

      .zumba-form .form-submit { min-height: 52px; }

      @media (prefers-reduced-motion: no-preference) {
        .zumba-poster { animation: zumba-float 5.5s ease-in-out infinite; }
        @keyframes zumba-float {
          0%, 100% { transform: rotate(2.2deg) translateY(0); }
          50% { transform: rotate(1.4deg) translateY(-12px); }
        }
      }

      @media (max-width: 1050px) {
        .zumba-hero-inner,
        .zumba-facts-head,
        .zumba-benefits-grid,
        .zumba-signup-grid { grid-template-columns: 1fr; }
        .zumba-hero { padding-top: 8rem; }
        .zumba-poster { max-width: 580px; width: 100%; margin: 0 auto; }
        .zumba-fact-grid { grid-template-columns: 1fr 1fr; }
        .zumba-fact:nth-child(2) { border-right: 0; }
        .zumba-fact:nth-child(-n+2) { border-bottom: 1px solid rgba(10,10,10,0.12); }
      }

      @media (max-width: 768px) {
        .zumba-hero,
        .zumba-facts,
        .zumba-benefits,
        .zumba-signup { padding-left: 1.25rem; padding-right: 1.25rem; }
        .zumba-hero { min-height: auto; padding-top: 7rem; padding-bottom: 4rem; }
        .zumba-title { font-size: clamp(4rem, 22vw, 6.2rem); }
        .zumba-poster { transform: none; box-shadow: 12px 16px 0 rgba(41,190,226,0.18); }
        .zumba-facts { padding-top: 4rem; padding-bottom: 4rem; }
        .zumba-fact-grid,
        .zumba-benefit-list { grid-template-columns: 1fr; }
        .zumba-fact,
        .zumba-fact:nth-child(2) { border-right: 0; border-bottom: 1px solid rgba(10,10,10,0.12); }
        .zumba-fact:last-child { border-bottom: 0; }
        .zumba-benefits,
        .zumba-signup { padding-top: 4.5rem; padding-bottom: 4.5rem; }
        .zumba-hero-actions .btn-primary,
        .zumba-text-link { width: 100%; justify-content: center; text-align: center; }
        .zumba-form .form-row { grid-template-columns: 1fr; }
      }

      @media (prefers-reduced-motion: reduce) {
        .zumba-poster { animation: none; }
      }
    </style>
  </Fragment>

  <main class="zumba-page">
    <section class="zumba-hero" aria-labelledby="zumba-title">
      <div class="zumba-hero-inner">
        <div>
          <p class="zumba-kicker">Zumba dance fitness in La Jolla</p>
          <h1 class="zumba-title font-display" id="zumba-title">
            <span>Zumba</span>
            <span class="zumba-title-accent">Is Here.</span>
          </h1>
          <p class="zumba-lede">
            Move, sweat, and leave smiling. Our new 45-minute Zumba classes bring
            high-energy dance fitness to the La Jolla Martial Arts community—no dance
            experience required.
          </p>
          <div class="zumba-hero-meta" aria-label="Zumba class details">
            <span class="zumba-meta-chip zumba-meta-chip--soon">Now enrolling</span>
            <span class="zumba-meta-chip">Friday + Saturday</span>
            <span class="zumba-meta-chip">10:30am–11:15am</span>
            <span class="zumba-meta-chip">$45 / class</span>
          </div>
          <div class="zumba-hero-actions">
            <a href="#zumba-signup" class="btn-primary">Try A Zumba Class</a>
            <a href="/schedule" class="zumba-text-link">View Full Schedule</a>
          </div>
        </div>

        <figure class="zumba-poster">
          <img src="/assets/zumba-banner.jpeg" alt="Zumba Dance, Sweat, Smile class banner" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="zumba-facts" aria-labelledby="zumba-details-title">
      <div class="zumba-inner">
        <div class="zumba-facts-head">
          <div>
            <p class="zumba-section-label">Class details</p>
            <h2 class="zumba-section-title font-display" id="zumba-details-title">Your New Weekend Energy.</h2>
          </div>
          <p>
            Classes run every Friday and Saturday morning. Choose the day that works for you,
            then send the form below and our team will help you try your first class.
          </p>
        </div>
        <div class="zumba-fact-grid">
          <div class="zumba-fact"><i data-lucide="calendar-days"></i><div><strong>Friday + Saturday</strong><span>Two weekly class days.</span></div></div>
          <div class="zumba-fact"><i data-lucide="clock-3"></i><div><strong>10:30am–11:15am</strong><span>A 45-minute late-morning energy reset.</span></div></div>
          <div class="zumba-fact"><i data-lucide="timer"></i><div><strong>45 Minutes</strong><span>One focused dance fitness session.</span></div></div>
          <div class="zumba-fact"><i data-lucide="badge-dollar-sign"></i><div><strong>$45 / Class</strong><span>Simple pay-per-class pricing.</span></div></div>
        </div>
      </div>
    </section>

    <section class="zumba-benefits" aria-labelledby="zumba-benefits-title">
      <div class="zumba-inner zumba-benefits-grid">
        <div class="zumba-benefits-copy">
          <p class="zumba-section-label">Why Zumba</p>
          <h2 class="zumba-section-title font-display" id="zumba-benefits-title">A Workout That Feels Like A Party.</h2>
          <p>
            Follow upbeat choreography at your own pace while building cardio fitness,
            confidence, and community. The goal is simple: keep moving and have fun doing it.
          </p>
        </div>
        <div class="zumba-benefit-list">
          <article class="zumba-benefit"><i data-lucide="flame"></i><h3>Full-Body Cardio</h3><p>Keep your heart rate up with nonstop, music-led movement.</p></article>
          <article class="zumba-benefit"><i data-lucide="smile"></i><h3>Mood Boost</h3><p>Shake off the week in an energetic, welcoming room.</p></article>
          <article class="zumba-benefit"><i data-lucide="music"></i><h3>No Dance Experience Needed</h3><p>Follow the instructor, modify the moves, and make it yours.</p></article>
          <article class="zumba-benefit"><i data-lucide="users"></i><h3>Community Energy</h3><p>Move alongside neighbors who came to sweat and smile.</p></article>
        </div>
      </div>
    </section>

    <section class="zumba-signup" id="zumba-signup" aria-labelledby="zumba-signup-title">
      <div class="zumba-inner zumba-signup-grid">
        <div class="zumba-signup-copy">
          <p class="zumba-section-label">Your first class</p>
          <h2 class="zumba-section-title font-display" id="zumba-signup-title">Try A Zumba Class.</h2>
          <p>
            Pick Friday or Saturday and tell us how to reach you. Our team will follow up
            with everything you need for your first 45-minute Zumba class.
          </p>
          <div class="zumba-note">
            <i data-lucide="sparkles"></i>
            <span>No dance experience is needed—come ready to move, sweat, and have fun.</span>
          </div>
        </div>

        <form
          class="zumba-form"
          action="/api/lead"
          method="POST"
          novalidate
          data-lead-form
          data-form-type="ZumbaTrialForm"
          data-lead-source="zumba-page"
        >
          <div class="zumba-form-head">
            <strong>Try a Zumba Class</strong>
            <span>Friday or Saturday · 10:30am–11:15am</span>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="zumba-first-name">First Name</label>
              <input class="form-input" id="zumba-first-name" name="firstName" type="text" autocomplete="given-name" placeholder="First name" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="zumba-last-name">Last Name</label>
              <input class="form-input" id="zumba-last-name" name="lastName" type="text" autocomplete="family-name" placeholder="Last name" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="zumba-email">Email Address</label>
              <input class="form-input" id="zumba-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="zumba-phone">Phone Number</label>
              <input class="form-input" id="zumba-phone" name="phone" type="tel" autocomplete="tel" placeholder="(858) 555-0123" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="zumba-day">Preferred Class</label>
            <select class="form-select" id="zumba-day" name="message" required>
              <option value="" disabled selected>Select a class</option>
              <option value="Preferred Zumba class: Friday, 10:30am–11:15am">Friday · 10:30am–11:15am</option>
              <option value="Preferred Zumba class: Saturday, 10:30am–11:15am">Saturday · 10:30am–11:15am</option>
              <option value="Preferred Zumba class: Either Friday or Saturday, 10:30am–11:15am">Either day works</option>
            </select>
          </div>
          <input type="hidden" name="program" value="zumba" />
          <button class="form-submit" type="submit">Try A Zumba Class</button>
          <p class="form-disclaimer">By submitting, you agree to receive emails and texts about Zumba classes. We respect your privacy and will never share your information.</p>
        </form>
      </div>
    </section>
  </main>
</Layout>
