              <option value="Free First Week">Free First Week</option>
              <option value="October 10 Master Class" data-lv-until={MASTER_CLASS_END}>Oct 10 Master Class (Free)</option>
              <option value="Both" data-lv-until={MASTER_CLASS_END}>Both</option>
            </select>
          </div>

          <div class="form-group" data-lv-date-group>
            <span class="form-label" id="lv-date-label">Your First Class</span>
            <div class="lv-picker-row" data-lv-picker-row>
              <button type="button" class="lv-picker-toggle" id="lv-date" aria-haspopup="dialog" aria-expanded="false" aria-controls="lv-cal" aria-labelledby="lv-date-label lv-date" data-lv-picker-toggle>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                <span data-lv-picker-text>Pick a date</span>
              </button>
              <button type="button" class="lv-picker-clear" data-lv-picker-clear>Clear</button>
            </div>
            <p class="lv-field-error" role="alert" hidden data-lv-date-error>Pick the date of your first class.</p>
            <div class="lv-cal" id="lv-cal" role="dialog" aria-label="Choose a class date" hidden data-lv-cal>
              <div class="lv-cal-head">
                <button type="button" class="lv-cal-nav" data-lv-cal-prev aria-label="Previous month">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <strong data-lv-cal-title aria-live="polite"></strong>
                <button type="button" class="lv-cal-nav" data-lv-cal-next aria-label="Next month">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                </button>
              </div>
              <div class="lv-cal-grid" data-lv-cal-grid></div>
              <div class="lv-cal-legend">
                <span><i></i>Mon &amp; Thu 9:00 AM · Fri 10:30 AM</span>
              </div>
            </div>
            <input type="hidden" value="" data-lv-date-value />
            <input type="hidden" name="classDate" value="" data-lv-class-date />
            <p class="form-hint">Choose the class you'd like to start your free week with.</p>
          </div>

          <input type="hidden" name="message" value="" data-lv-message />
          <input type="hidden" name="program" value="zumba" />
          <button class="lv-btn lv-btn--gold lv-submit" type="submit">Claim My Free Week</button>
          <p class="form-disclaimer">By submitting, you agree to receive emails and texts about LAVEL Zumba classes and events. We respect your privacy and will never share your information.</p>

          <template data-lead-success>
            <div class="lv-success" role="status">
              <div class="lv-success-mark" aria-hidden="true">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
              </div>
              <h3>You're In!</h3>
              <p>Thanks for connecting with LAVEL. We received your information.</p>
              <address>La Jolla Martial Arts<br />7680 Girard Avenue<br />La Jolla, CA</address>
              <p>We'll use the contact information you provided for relevant class and event details.</p>
            </div>
          </template>
        </form>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts">
    (function () {
      var now = Date.now();

      // Remove time-limited content (the Oct 10 Master Class) once it's over.
      document.querySelectorAll('[data-lv-until]').forEach(function (el) {
        if (now > Date.parse(el.getAttribute('data-lv-until'))) el.remove();
      });

      var form = document.querySelector('form[data-lv-form]');
      if (!form) return;

      var interestGroup = form.querySelector('[data-lv-interest]');
      var interestSelect = form.interest;
      var dateGroup = form.querySelector('[data-lv-date-group]');

      // Once the Master Class has passed, Free First Week is the only option.
      var interestChoices = interestSelect.querySelectorAll('option[value]:not([value=""])');
      if (interestChoices.length === 1) {
        interestSelect.value = interestChoices[0].value;
        interestGroup.hidden = true;
      }

      // CTAs elsewhere on the page preselect the matching option.
      document.querySelectorAll('a[data-interest]').forEach(function (link) {
        link.addEventListener('click', function () {
          var value = link.getAttribute('data-interest');
          if (interestSelect.querySelector('option[value="' + value + '"]')) {
            interestSelect.value = value;
            interestSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });

      // Class-day date picker: only real class days in the next 8 weeks are selectable.
      var SLOTS = { 1: { label: '9:00 AM', hour: 9 }, 4: { label: '9:00 AM', hour: 9 }, 5: { label: '10:30 AM', hour: 10.5 } };
      var WINDOW_DAYS = 56;
      var nowDate = new Date(now);
      var today = new Date(nowDate.getFullYear(), nowDate.getMonth(), nowDate.getDate());
      var lastDay = new Date(today.getFullYear(), today.getMonth(), today.getDate() + WINDOW_DAYS);
      var nowHour = nowDate.getHours() + nowDate.getMinutes() / 60;

      function slotFor(date) {
        if (date < today || date > lastDay) return null;
        var slot = SLOTS[date.getDay()];
        if (slot && date.getTime() === today.getTime() && nowHour >= slot.hour) return null;
        return slot;
      }

      var firstAvailable = null;
      for (var i = 0; i <= WINDOW_DAYS && !firstAvailable; i++) {
        var probe = new Date(today.getFullYear(), today.getMonth(), today.getDate() + i);
        if (slotFor(probe)) firstAvailable = probe;
      }

      var pickerRow = form.querySelector('[data-lv-picker-row]');
      var toggle = form.querySelector('[data-lv-picker-toggle]');
      var toggleText = form.querySelector('[data-lv-picker-text]');
      var clearBtn = form.querySelector('[data-lv-picker-clear]');
      var cal = form.querySelector('[data-lv-cal]');
      var calTitle = form.querySelector('[data-lv-cal-title]');
      var calGrid = form.querySelector('[data-lv-cal-grid]');
      var prevBtn = form.querySelector('[data-lv-cal-prev]');
      var nextBtn = form.querySelector('[data-lv-cal-next]');
      var dateValue = form.querySelector('[data-lv-date-value]');
      var minMonth = (firstAvailable || today).getFullYear() * 12 + (firstAvailable || today).getMonth();
      var maxMonth = lastDay.getFullYear() * 12 + lastDay.getMonth();
      var viewMonth = minMonth;
      var selected = null;
      var shortFmt = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
      var longFmt = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
      var monthFmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });

      function labelFor(date, slot) {
        return shortFmt.format(date) + ' · ' + slot.label;
      }

      function render() {
        var year = Math.floor(viewMonth / 12);
        var month = viewMonth % 12;
        calTitle.textContent = monthFmt.format(new Date(year, month, 1));
        prevBtn.disabled = viewMonth <= minMonth;
        nextBtn.disabled = viewMonth >= maxMonth;
        calGrid.innerHTML = '';
        ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach(function (d) {
          var el = document.createElement('span');
          el.className = 'lv-cal-dow';
          el.setAttribute('aria-hidden', 'true');
          el.textContent = d;
          calGrid.appendChild(el);
        });
        var lead = new Date(year, month, 1).getDay();
        for (var b = 0; b < lead; b++) calGrid.appendChild(document.createElement('span'));
        var daysInMonth = new Date(year, month + 1, 0).getDate();
        for (var day = 1; day <= daysInMonth; day++) {
          var date = new Date(year, month, day);
          var slot = slotFor(date);
          var el;
          if (slot) {
            el = document.createElement('button');
            el.type = 'button';
            el.className = 'lv-cal-day is-class';
            el.setAttribute('aria-label', longFmt.format(date) + ', ' + slot.label);
            var isSelected = selected && selected.getTime() === date.getTime();
            if (isSelected) el.classList.add('is-selected');
            el.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
            el.addEventListener('click', pick.bind(null, date, slot));
          } else {
            el = document.createElement('span');
            el.className = 'lv-cal-day';
            el.setAttribute('aria-hidden', 'true');
          }
          el.textContent = day;
          calGrid.appendChild(el);
        }
      }

      function setOpen(open) {
        cal.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          render();
          var target = cal.querySelector('.is-selected') || cal.querySelector('.is-class');
          if (target) target.focus();
        }
      }

      function pick(date, slot) {
        clearDateError();
        selected = date;
        dateValue.value = labelFor(date, slot);
        toggleText.textContent = dateValue.value;
        toggle.classList.add('has-value');
        pickerRow.classList.add('has-value');
        setOpen(false);
        toggle.focus();
        form.dispatchEvent(new Event('change'));
      }

      if (!firstAvailable) {
        toggle.disabled = true;
        toggleText.textContent = 'No upcoming class dates';
      }
      toggle.addEventListener('click', function () { setOpen(cal.hidden); });
      var dateError = form.querySelector('[data-lv-date-error]');
      function clearDateError() {
        dateError.hidden = true;
        pickerRow.classList.remove('is-invalid');
      }

      function clearDate() {
        selected = null;
        dateValue.value = '';
        toggleText.textContent = 'Pick a date';
        toggle.classList.remove('has-value');
        pickerRow.classList.remove('has-value');
        setOpen(false);
      }
      clearBtn.addEventListener('click', function () {
        clearDate();
        toggle.focus();
        form.dispatchEvent(new Event('change'));
      });

      // The first-class date only applies to the regular classes, not a Master-Class-only sign-up.
      var submitBtn = form.querySelector('button[type="submit"]');
      function syncDateGroup() {
        var masterOnly = interestSelect.value === 'October 10 Master Class';
        if (!submitBtn.disabled) submitBtn.textContent = masterOnly ? 'Reserve My Spot' : 'Claim My Free Week';
        dateGroup.hidden = masterOnly;
        if (masterOnly) clearDateError();
        if (masterOnly && dateValue.value) clearDate();
      }
      interestSelect.addEventListener('change', syncDateGroup);
      syncDateGroup();

      prevBtn.addEventListener('click', function () { viewMonth--; render(); });
      nextBtn.addEventListener('click', function () { viewMonth++; render(); });
      cal.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { setOpen(false); toggle.focus(); }
      });

      // The lead API stores extra details in `message`; compose it before Layout's submit handler runs.
      var messageInput = form.querySelector('[data-lv-message]');
      var classDateInput = form.querySelector('[data-lv-class-date]');
      var MASTER_CLASS_LABEL = 'Sat, Oct 10 · 9:00 AM';
      function composeMessage() {
        var lines = [
          'LAVEL Zumba registration',
          'Signing up for: ' + (interestSelect.value || '—'),
        ];
        if (interestSelect.value !== 'October 10 Master Class') {
          lines.push('First class: ' + (dateValue.value || 'No date picked'));
        }
        messageInput.value = lines.join('\n');
        // Always give GoHighLevel a class date; Master-Class-only sign-ups get the event date.
        classDateInput.value = interestSelect.value === 'October 10 Master Class' ? MASTER_CLASS_LABEL : dateValue.value;
      }
      form.addEventListener('change', composeMessage);
      form.addEventListener('submit', composeMessage, true);

      // A first-class date is required unless they're only signing up for the Master Class.
      // Runs in the capture phase so it can stop Layout's submit handler; other fields are
      // left to the browser's own validation first.
      form.addEventListener('submit', function (e) {
        if (dateGroup.hidden || dateValue.value || !form.checkValidity()) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        dateError.hidden = false;
        pickerRow.classList.add('is-invalid');
        dateGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setOpen(true);
      }, true);
      composeMessage();
    })();
  </script>
</Layout>
