---
import Layout from '../layouts/Layout.astro';
import '../styles/site-theme.css';

const SITE = 'https://lajollatkd.com';

// LAVEL Group Fitness handoff (Lavel Bryant, Sep 25 2026).
const CLASSES = [
  { day: 'Monday', time: '9:00 AM' },
  { day: 'Thursday', time: '9:00 AM' },
  { day: 'Friday', time: '10:30 AM' },
];

// Hero benefits map to Lavel's tagline: mind, body & soul.
const HERO_BENEFITS = [
  { kicker: 'Body', text: 'Full-body cardio' },
  { kicker: 'Mind', text: 'Stress-melting mood boost' },
  { kicker: 'Soul', text: 'Music, energy & community' },
];

const PRICES = [
  { label: 'First Class', price: '$15' },
  { label: 'Single / Drop-In', price: '$25' },
  { label: '3-Class Package', price: '$69' },
  { label: '8-Class Package', price: '$160' },
];

// Master Class content hides itself client-side once it has ended.
const MASTER_CLASS_END = '2026-10-10T10:30:00-07:00';

const location = {
  '@type': 'SportsActivityLocation',
  '@id': `${SITE}/#business`,
  name: 'La Jolla Martial Arts',
  telephone: '+1-858-361-0961',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7680 Girard Ave, Basement',
    addressLocality: 'La Jolla',
    addressRegion: 'CA',
    postalCode: '92037',
    addressCountry: 'US',
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'LAVEL Zumba Group Fitness Classes in La Jolla',
  description:
    'LAVEL Zumba group fitness classes at La Jolla Martial Arts on Mondays and Thursdays at 9:00 AM and Fridays at 10:30 AM. Your first week is free.',
  url: `${SITE}/zumba`,
  areaServed: { '@type': 'City', name: 'La Jolla' },
  provider: location,
  offers: [
    { '@type': 'Offer', name: 'Free First Week', price: '0', priceCurrency: 'USD' },
    ...PRICES.map((p) => ({ '@type': 'Offer', name: p.label, price: p.price.replace('$', ''), priceCurrency: 'USD' })),
  ],
};

const masterClassSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Free 90-Minute LAVEL Zumba Master Class',
  startDate: '2026-10-10T09:00:00-07:00',
  endDate: MASTER_CLASS_END,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: true,
  location,
  organizer: { '@type': 'Organization', name: 'La Jolla Martial Arts', url: SITE },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: `${SITE}/zumba#zumba-signup` },
};
---

<Layout
  title="LAVEL Zumba Classes in La Jolla | First Week Free"
  description="LAVEL Zumba group fitness at La Jolla Martial Arts. Mondays & Thursdays 9:00 AM, Fridays 10:30 AM. Your first week is free, plus a free Master Class Oct 10."
  canonical={`${SITE}/zumba`}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/lavel-wordmark.webp" />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@1,6..96,500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(masterClassSchema)} />
    <style is:global>
      :root {
        --lv-ink: #0b0906;
        --lv-ink-2: #15110b;
        --lv-gold: #d4a73c;
        --lv-gold-hi: #f3d27a;
        --lv-gold-lo: #9a6d1a;
        --lv-cream: #f7efe0;
        --lv-cream-2: #efe3cc;
        --lv-text: #2a2216;
        --lv-muted: #6f5f45;
        --lv-line: rgba(154, 109, 26, 0.24);
        --lv-gold-grad: linear-gradient(180deg, var(--lv-gold-hi) 0%, var(--lv-gold) 55%, var(--lv-gold-lo) 100%);
      }

      .lv-page { background: var(--lv-cream); color: var(--lv-text); }
      .lv-inner { max-width: 1320px; margin: 0 auto; }
      .lv-serif { font-family: 'Bodoni Moda', Georgia, serif; font-style: italic; font-weight: 500; }
      .lv-gold-text {
        background: var(--lv-gold-grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      /* Darker gold for headlines on cream, where the bright gradient loses contrast. */
      .lv-gold-text--deep { background-image: linear-gradient(180deg, #c79a33 0%, var(--lv-gold-lo) 100%); }

      .lv-label {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: var(--lv-gold-lo);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: uppercase;
      }
      .lv-label::before { content: ''; width: 28px; height: 1px; background: currentColor; }
      .lv-dark .lv-label { color: var(--lv-gold-hi); }

      .lv-h2 {
        margin-top: 1rem;
        font-size: clamp(2.8rem, 5.4vw, 5.2rem);
        line-height: 0.9;
        text-transform: uppercase;
      }

      /* Buttons */
      .lv-btn {
        min-height: 54px;
        padding: 0 1.6rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        border: 0;
        font-family: 'Archivo', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, color 0.25s ease;
      }
      .lv-btn--gold { background: var(--lv-gold-grad); color: var(--lv-ink); box-shadow: 0 10px 30px -12px rgba(212,167,60,0.7); }
      .lv-btn--gold::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.55) 50%, transparent 70%);
        transform: translateX(-120%);
        transition: transform 0.7s ease;
      }
      .lv-btn--gold:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -12px rgba(212,167,60,0.85); }
      .lv-btn--gold:hover::after { transform: translateX(120%); }
      .lv-btn--line { color: #fff; box-shadow: inset 0 0 0 1px rgba(243,210,122,0.55); }
      .lv-btn--line:hover { background: rgba(243,210,122,0.1); box-shadow: inset 0 0 0 1px var(--lv-gold-hi); }
      .lv-btn--ink { background: var(--lv-ink); color: var(--lv-gold-hi); }
      .lv-btn--ink:hover { transform: translateY(-2px); background: #000; }
      .lv-btn:focus-visible,
      .lv-page a:focus-visible { outline: 2px solid var(--lv-gold); outline-offset: 3px; }

      /* ---------- HERO ---------- */
      .lv-hero {
        position: relative;
        overflow: hidden;
        padding: 8.25rem 4rem 4.5rem;
        color: #fff;
        background:
          radial-gradient(ellipse 60% 70% at 80% 35%, rgba(212,167,60,0.24), transparent 65%),
          radial-gradient(ellipse 50% 60% at 5% 100%, rgba(154,109,26,0.22), transparent 70%),
          var(--lv-ink);
      }
      .lv-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.5;
        background-image: repeating-linear-gradient(115deg, transparent 0 46px, rgba(243,210,122,0.05) 46px 47px);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%, #000 70%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 40%, #000 70%, transparent);
      }
      .lv-hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
        gap: clamp(2.5rem, 6vw, 6rem);
        align-items: center;
      }

      .lv-wordmark {
        position: relative;
        width: min(400px, 100%);
        aspect-ratio: 3 / 1;
        margin-left: -2%;
      }
      .lv-wordmark img { width: 100%; height: 100%; display: block; filter: drop-shadow(0 10px 28px rgba(212,167,60,0.28)); }
      .lv-wordmark::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(105deg, transparent 38%, rgba(255,250,230,0.85) 50%, transparent 62%);
        background-size: 250% 100%;
        background-position: 130% 0;
        -webkit-mask: url('/assets/lavel-wordmark.webp') center / contain no-repeat;
        mask: url('/assets/lavel-wordmark.webp') center / contain no-repeat;
        mix-blend-mode: overlay;
      }

      .lv-hero-sub {
        margin-top: 0.4rem;
        color: var(--lv-gold-hi);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.42em;
        text-transform: uppercase;
      }
      .lv-hero-sub span { color: rgba(255,255,255,0.55); letter-spacing: 0.3em; }

      .lv-h1 {
        margin: 1rem 0 0.8rem;
        font-size: clamp(3.4rem, 5.6vw, 6.4rem);
        line-height: 0.86;
        text-transform: uppercase;
      }
      .lv-h1 span { display: block; }

      .lv-tagline { font-size: clamp(1.15rem, 1.9vw, 1.45rem); color: rgba(255,255,255,0.78); }

      .lv-pills {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.6rem;
        max-width: 560px;
      }
      .lv-pills li {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 0.9rem 1.1rem 1rem;
        border-radius: 14px;
        border: 1px solid rgba(212,167,60,0.5);
        background: linear-gradient(180deg, rgba(243,210,122,0.07), rgba(255,255,255,0.02));
      }
      .lv-pills b {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.35rem;
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--lv-gold-hi);
      }
      .lv-pills span { font-size: 0.86rem; font-weight: 600; line-height: 1.35; color: rgba(255,255,255,0.88); }

      .lv-hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }

      .lv-arch-wrap { position: relative; justify-self: center; width: min(430px, 100%); }
      .lv-arch {
        position: relative;
        aspect-ratio: 684 / 1000;
        border-radius: 999px 999px 10px 10px;
        overflow: hidden;
        border: 2px solid var(--lv-gold);
        box-shadow: 0 0 0 10px rgba(212,167,60,0.1), 0 40px 90px -20px rgba(0,0,0,0.8);
      }
      .lv-arch img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .lv-arch::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 60%, rgba(11,9,6,0.55));
      }
      .lv-arch-ring {
        position: absolute;
        inset: -22px -22px 30px;
        border-radius: 999px 999px 0 0;
        border: 1px solid rgba(243,210,122,0.25);
        border-bottom: 0;
        pointer-events: none;
      }
      .lv-badge {
        position: absolute;
        left: -2.2rem;
        bottom: 2.4rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.8rem 1.1rem 0.8rem 0.8rem;
        background: var(--lv-ink);
        border: 1px solid var(--lv-gold);
        border-radius: 999px;
        box-shadow: 0 18px 40px -12px rgba(0,0,0,0.8);
      }
      .lv-badge .lv-badge-star {
        width: 44px;
        height: 44px;
        flex: 0 0 auto;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--lv-gold-grad);
        color: var(--lv-ink);
      }
      .lv-badge-star svg { width: 22px; height: 22px; }
      .lv-badge strong { display: block; font-family: 'Bebas Neue', sans-serif; font-size: 1.7rem; line-height: 0.9; color: var(--lv-gold-hi); }
      .lv-badge span { display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.8); }

      /* ---------- SCHEDULE ---------- */
      .lv-schedule { padding: 6rem 4rem; }
      .lv-head {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 4rem;
        align-items: end;
        margin-bottom: 2.8rem;
      }
      .lv-head > p { color: var(--lv-muted); line-height: 1.75; max-width: 560px; }
      .lv-head > p strong { color: var(--lv-text); }

      .lv-days {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--lv-line);
        border-bottom: 1px solid var(--lv-line);
      }
      .lv-day {
        min-height: 230px;
        padding: 2rem;
        border-right: 1px solid var(--lv-line);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.5rem;
      }
      .lv-day-num { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.3em; color: var(--lv-gold-lo); }
      .lv-day h3 { font-family: 'Bebas Neue', sans-serif; font-size: 2.7rem; font-weight: 400; line-height: 0.9; text-transform: uppercase; }
      .lv-day time { display: block; margin-top: 0.35rem; font-family: 'Bebas Neue', sans-serif; font-size: 1.7rem; color: var(--lv-gold-lo); }
      .lv-day p { color: var(--lv-muted); font-size: 0.82rem; line-height: 1.5; }
      .lv-day--free {
        border-right: 0;
        background: var(--lv-ink);
        color: #fff;
        position: relative;
        overflow: hidden;
      }
      .lv-day--free::before {
        content: '';
        position: absolute;
        right: -60px;
        top: -60px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(212,167,60,0.35), transparent 70%);
      }
      .lv-day--free .lv-day-num { color: var(--lv-gold-hi); }
      .lv-day--free p { color: rgba(255,255,255,0.65); }
      .lv-day--free a { color: var(--lv-gold-hi); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; }
      .lv-day--free a:hover { text-decoration: underline; }

      .lv-where {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.4rem;
        margin-top: 1.4rem;
        color: var(--lv-muted);
        font-size: 0.84rem;
      }
      .lv-where span { display: inline-flex; align-items: center; gap: 0.45rem; }
      .lv-where .lucide, .lv-where i { width: 16px; height: 16px; color: var(--lv-gold-lo); }
      .lv-where a { color: inherit; }

      /* ---------- MASTER CLASS ---------- */
      .lv-master {
        padding: 5rem 4rem;
        background:
          radial-gradient(ellipse 45% 90% at 0% 50%, rgba(212,167,60,0.22), transparent 70%),
          var(--lv-ink-2);
        color: #fff;
        border-top: 1px solid rgba(212,167,60,0.4);
        border-bottom: 1px solid rgba(212,167,60,0.4);
      }
      .lv-master-grid {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: center;
      }
      .lv-date {
        width: 150px;
        text-align: center;
        border: 1px solid var(--lv-gold);
        padding: 1rem 0.5rem 1.1rem;
        position: relative;
      }
      .lv-date::before {
        content: '';
        position: absolute;
        inset: 5px;
        border: 1px solid rgba(243,210,122,0.25);
        pointer-events: none;
      }
      .lv-date small { display: block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.3em; color: var(--lv-gold-hi); }
      .lv-date strong { display: block; font-family: 'Bebas Neue', sans-serif; font-size: 5rem; font-weight: 400; line-height: 0.85; margin: 0.3rem 0 0.1rem; }
      .lv-date span { display: block; font-size: 0.68rem; letter-spacing: 0.24em; color: rgba(255,255,255,0.7); }
      .lv-master h2 { margin-top: 0.8rem; font-size: clamp(2.4rem, 4.4vw, 4rem); line-height: 0.92; text-transform: uppercase; }
      .lv-master p:not(.lv-label) { margin-top: 0.9rem; color: rgba(255,255,255,0.68); line-height: 1.7; max-width: 560px; }
      .lv-master p strong { color: #fff; }

      /* ---------- PRICING ---------- */
      .lv-pricing { padding: 6rem 4rem; background: var(--lv-cream-2); }
      .lv-price-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: stretch;
      }
      .lv-offer {
        position: relative;
        overflow: hidden;
        padding: clamp(2rem, 4vw, 3rem);
        background: var(--lv-ink);
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
        box-shadow: 18px 18px 0 var(--lv-gold);
      }
      .lv-offer::after {
        content: '';
        position: absolute;
        right: -30%;
        bottom: -40%;
        width: 90%;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 1px solid rgba(243,210,122,0.2);
        box-shadow: 0 0 0 40px rgba(243,210,122,0.03), 0 0 0 80px rgba(243,210,122,0.02);
      }
      .lv-offer-big { font-family: 'Bebas Neue', sans-serif; font-size: clamp(5rem, 10vw, 8.5rem); line-height: 0.8; text-transform: uppercase; }
      .lv-offer-big span { display: block; font-size: 0.42em; color: #fff; margin-top: 0.4rem; letter-spacing: 0.02em; }
      .lv-offer p { position: relative; z-index: 1; color: rgba(255,255,255,0.7); line-height: 1.65; max-width: 380px; }
      .lv-offer .lv-btn { position: relative; z-index: 1; align-self: flex-start; }

      .lv-menu { list-style: none; margin: 1.6rem 0 0; padding: 0; }
      .lv-menu li {
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        padding: 1.05rem 0;
        border-bottom: 1px solid var(--lv-line);
      }
      .lv-menu li:first-child { border-top: 1px solid var(--lv-line); }
      .lv-menu .name { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.5rem, 2.4vw, 2rem); letter-spacing: 0.02em; text-transform: uppercase; }
      .lv-menu .dots { flex: 1; border-bottom: 1px dotted rgba(154,109,26,0.55); transform: translateY(-0.35rem); }
      .lv-menu .price { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.8rem, 2.8vw, 2.4rem); color: var(--lv-gold-lo); }
      .lv-after { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.26em; text-transform: uppercase; color: var(--lv-muted); }
      .lv-military {
        margin-top: 1.4rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.2rem;
        background: #fff9ec;
        border: 1px solid var(--lv-line);
        border-left: 4px solid var(--lv-gold);
      }
      .lv-military strong { font-family: 'Bebas Neue', sans-serif; font-size: 2.4rem; line-height: 1; color: var(--lv-gold-lo); }
      .lv-military span { font-size: 0.86rem; line-height: 1.45; color: var(--lv-text); }

      /* ---------- WHY ---------- */
      .lv-why { padding: 6rem 4rem; background: var(--lv-ink); color: #fff; }
      .lv-why-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: center;
      }
      .lv-why-copy > p:not(.lv-label) { max-width: 540px; margin-top: 1.4rem; color: rgba(255,255,255,0.68); line-height: 1.75; }
      .lv-sig {
        margin-top: 2.2rem;
        padding-top: 1.4rem;
        border-top: 1px solid rgba(212,167,60,0.35);
        max-width: 540px;
      }
      .lv-sig small { display: block; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
      .lv-sig strong { display: block; margin-top: 0.4rem; font-family: 'Bodoni Moda', Georgia, serif; font-style: italic; font-weight: 500; font-size: 1.9rem; color: var(--lv-gold-hi); }
      .lv-sig span { display: block; margin-top: 0.2rem; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.72); }

      .lv-benefits { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(212,167,60,0.25); border: 1px solid rgba(212,167,60,0.25); }
      .lv-benefit { min-height: 180px; padding: 1.7rem; background: var(--lv-ink); transition: background 0.3s ease; }
      .lv-benefit:hover { background: #17120a; }
      .lv-benefit .lucide, .lv-benefit i { width: 26px; height: 26px; margin-bottom: 1.3rem; color: var(--lv-gold); }
      .lv-benefit h3 { font-size: 1rem; margin-bottom: 0.45rem; }
      .lv-benefit p { color: rgba(255,255,255,0.58); font-size: 0.85rem; line-height: 1.55; }

      /* ---------- SIGNUP ---------- */
      .lv-signup {
        padding: 6rem 4rem;
        background:
          radial-gradient(ellipse 50% 60% at 100% 0%, rgba(212,167,60,0.16), transparent 70%),
          var(--lv-cream);
      }
      .lv-signup-grid {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: clamp(3rem, 7vw, 7rem);
        align-items: start;
      }
      .lv-signup-copy > p:not(.lv-label) { max-width: 500px; margin: 1.3rem 0 1.8rem; color: var(--lv-muted); line-height: 1.75; }
      .lv-contact { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
      .lv-contact li { display: flex; gap: 0.8rem; align-items: flex-start; font-size: 0.9rem; line-height: 1.45; }
      .lv-contact .lucide, .lv-contact i { width: 18px; height: 18px; margin-top: 0.1rem; flex: 0 0 auto; color: var(--lv-gold-lo); }
      .lv-contact a { color: var(--lv-text); text-decoration: none; border-bottom: 1px solid var(--lv-line); }
      .lv-contact a:hover { border-color: var(--lv-gold); }

      .lv-form {
