# PostHog (House36 Default project) — public client project API key.
# Inlined at `astro build` via import.meta.env.PUBLIC_POSTHOG_KEY. Not a Worker secret.
#
# Local: copy to `.env` (gitignored) and paste the project API key.
# Cloudflare Workers Builds / Wrangler: set PUBLIC_POSTHOG_KEY as a *build-time*
# environment variable (Workers Builds → Variables, available during build).
# Wrangler `vars` / `.dev.vars` are runtime Worker bindings and do NOT populate
# Astro's import.meta.env unless the same name is also present at build time.
# Optional host override (defaults to US Cloud):
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Pixel/Dataset ID — one public build setting for both browser and CAPI.
# Set in .env locally and Cloudflare Workers Builds build-time variables.
# Astro inlines the browser value; npm build/dev and Wrangler generate the
# matching CAPI setting in ignored .wrangler/.
# A missing ID disables Meta tracking; malformed IDs fail configuration.
PUBLIC_META_PIXEL_ID=1467220277627514

# Meta CAPI uses a runtime Worker secret named META_CAPI_ACCESS_TOKEN.
# Set using `wrangler secret put META_CAPI_ACCESS_TOKEN`; never use a PUBLIC_ key
# or commit the token. The token must have access to PUBLIC_META_PIXEL_ID.
