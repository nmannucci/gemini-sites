---
import Layout from '../layouts/Layout.astro';
import { locations } from '../data/locations';
import { scheduleUrl } from '../data/urls';

const SITE = 'https://www.betterbaseballtraining.com';

const scheduleHighlights = [
  {
    eyebrow: 'Ages Served',
    title: 'Built For 8-14U Players',
    copy: 'The current schedule is centered on academy programming for youth players who need consistent reps, structure, and age-appropriate development.',
  },
  {
    eyebrow: 'Calendar Format',
    title: 'Live Weekly Schedule',
    copy: 'The embedded calendar below shows the current class schedule and updates as availability changes across the two BBT locations.',
  },
  {
    eyebrow: 'Program Focus',
    title: 'Academy Class Coverage',
    copy: 'Expect the schedule to highlight recurring baseball development sessions such as hitting, pitching, defense, catching, baseball IQ, and baserunning work.',
  },
];

const title = 'Baseball Schedule | Rocklin & El Dorado Hills | Better Baseball Training';
const description =
  'View the current Better Baseball Training academy schedule for Rocklin and El Dorado Hills, including active class times and recurring training sessions.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE}${scheduleUrl()}#webpage`,
  url: `${SITE}${scheduleUrl()}`,
  name: 'Baseball Training Schedule in Rocklin & El Dorado Hills',
  description,
  isPartOf: { '@id': `${SITE}/#website` },
  about: { '@id': `${SITE}/#organization` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Academy Schedule', item: `${SITE}${scheduleUrl()}` },
  ],
};
---

<Layout title={title} description={description} pageSchema={[webPageSchema, breadcrumbSchema]}>
  <main id="main-content" class="default-page">
    <div class="default-page__inner">
      <article class="entry-card">
        <h1 class="default-page__title">Baseball Training Schedule in Rocklin &amp; El Dorado Hills</h1>
        <p class="default-page__copy">View the current Better Baseball Training academy schedule for Rocklin and El Dorado Hills, including active class times and recurring training sessions.</p>
        <div class="schedule-highlights">
          {scheduleHighlights.map((item) => (
            <div class="schedule-highlight">
              <div class="schedule-highlight__eyebrow">{item.eyebrow}</div>
              <h2 class="schedule-highlight__title">{item.title}</h2>
              <p class="schedule-highlight__copy">{item.copy}</p>
            </div>
          ))}
        </div>

        <section class="schedule-summary" aria-label="Schedule overview">
          <div class="schedule-details">
            <article class="schedule-panel">
              <div class="schedule-card__eyebrow">Locations</div>
              <h2 class="schedule-panel__title">Two Training Locations</h2>
              <div class="schedule-location-grid">
                {locations.map((location) => (
                  <div class="schedule-location-card">
                    <strong>{location.name}</strong>
                    <span>{location.address_line}</span>
                    <span>{location.city_state_zip}</span>
                    <p>{location.summary}</p>
                  </div>
                ))}
              </div>
            </article>
          </div>
        </section>
        <div class="entry-content">
          <div class="schedule-embed">
            <div style="overflow:auto;-webkit-overflow-scrolling:touch;">
              <iframe
                src="https://syncapp.wodhopper.com/gym/15529/rsvp/calendar"
                title="Better Baseball Training class schedule"
                style="width:100%;min-width:600px;height:920px;border:none;border-radius:8px;"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>
