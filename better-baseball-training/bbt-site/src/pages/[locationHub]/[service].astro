---
// Service-area page: one {lesson} × {location}. Nested under its core location hub, e.g.
// /baseball-lessons-rocklin/hitting.
//
// The playbook's rule for this layer is that the page has TWO parents and links to both:
//   core service (/lessons/hitting)  ↔  this page  ↔  core location (/baseball-lessons-rocklin)
// It also links sideways: the same service at the other facility, and the other built
// service at this facility. Both parents link back — see [seoPage].astro and lessons/[slug].astro.
import Layout from '../../layouts/Layout.astro';
import { serviceAreas } from '../../data/serviceAreas';
import { lessons } from '../../data/lessons';
import { locations } from '../../data/locations';
import { coaches } from '../../data/coaches';
import { contact } from '../../data/contact';
import {
  lessonUrl,
  locationHubSlug,
  locationHubUrl,
  serviceAreaUrl,
  bookingUrl,
  coachesUrl,
  lessonRelatedCoachKeysFor,
} from '../../data/urls';
import LeadForm from '../../components/LeadForm.astro';

const SITE = 'https://www.betterbaseballtraining.com';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { locationHub: locationHubSlug(area.locationKey)!, service: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;

const location = locations.find((l) => l.key === area.locationKey)!;
const lesson = lessons.find((l) => l.slug === area.lessonSlug)!;
const pageUrl = `${SITE}${serviceAreaUrl(area.locationKey, area.slug)}`;

// Coaches who actually work this skill at this facility. Two sources, both already in the
// repo: the editorial per-lesson map that the lesson pages' FAQ uses, plus anyone whose
// coaches.ts specialty matches. Union of the two, then filtered to coaches whose `locations`
// include this facility — so the roster can never claim someone is somewhere they are not.
//
// The specialty list has no "Catching" or "Baseball IQ" entry, which is why the map is the
// primary source rather than a specialty lookup.
const specialtyFor: Record<string, string | undefined> = {
  hitting: 'Hitting',
  pitching: 'Pitching',
  'infield-outfield': 'Defense',
};
const mappedKeys = lessonRelatedCoachKeysFor(area.lessonSlug);
const specialty = specialtyFor[area.lessonSlug];
const orderedKeys = [
  ...mappedKeys,
  ...coaches
    .filter((c) => specialty && c.specialties?.includes(specialty))
    .map((c) => c.key)
    .filter((k) => !mappedKeys.includes(k)),
];
const localCoaches = orderedKeys
  .map((key) => coaches.find((c) => c.key === key))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .filter((c) => c.locations?.includes(location.name));

// Sideways links: same service at the other facility, other built service at this facility.
const sameServiceElsewhere = serviceAreas.find(
  (a) => a.lessonSlug === area.lessonSlug && a.locationKey !== area.locationKey,
);
// Every other lesson at this facility, in lessons.ts order — not a single arbitrary .find(),
// now that all five exist per location.
const otherServicesHere = lessons
  .filter((l) => l.slug !== area.lessonSlug)
  .map((l) => ({
    label: l.label,
    area: serviceAreas.find((a) => a.locationKey === area.locationKey && a.lessonSlug === l.slug),
  }))
  .filter((x): x is { label: string; area: NonNullable<typeof x.area> } => Boolean(x.area));
const otherLocation = locations.find((l) => l.key !== area.locationKey)!;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: area.headline,
  serviceType: `Youth baseball ${area.lessonSlug} lessons`,
  description: area.meta_description,
  url: pageUrl,
  provider: { '@id': `${SITE}/#organization` },
  areaServed: { '@type': 'City', name: location.name },
  availableAtOrFrom: {
    '@id': area.locationKey === 'rocklin' ? `${SITE}/#rocklin-location` : `${SITE}/#edh-location`,
  },
  audience: { '@type': 'PeopleAudience', suggestedMinAge: 8, suggestedMaxAge: 14 },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: area.faq_items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

// Breadcrumb mirrors the URL nesting: Home > {location hub} > {this page}.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: `Baseball Lessons in ${location.name}`,
      item: `${SITE}${locationHubUrl(area.locationKey)}`,
    },
    { '@type': 'ListItem', position: 3, name: area.headline, item: pageUrl },
  ],
};
---

<Layout
  title={area.meta_title}
  description={area.meta_description}
  canonical={pageUrl}
  pageSchema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <main id="main-content" class="seo-landing-page ls-page">
    <section class="ls-hero reveal">
      <div class="ls-hero__inner">
        {/* A <div role="navigation"> rather than <nav>: global.css styles the bare `nav`
            element as the fixed site header (position: fixed), so a <nav> here renders on
            top of the real navigation. Same semantics, no collision. It lives inside the
            hero because the hero's padding is what clears the fixed header. */}
        <div class="ls-breadcrumb" role="navigation" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href={locationHubUrl(area.locationKey)}>Baseball Lessons in {location.name}</a></li>
            <li aria-current="page">{lesson.label}</li>
          </ol>
        </div>
        <div class="ls-hero__kicker">{area.kicker}</div>
        <h1 class="ls-hero__title">{area.headline}</h1>
        <p class="ls-hero__copy">{area.subheadline}</p>
        <div class="ls-hero__meta" aria-label="Page details">
          {area.meta_items.map((item) => <span>{item}</span>)}
        </div>
        <div class="ls-hero__actions">
          <a href={bookingUrl()} class="membership-cta">{area.cta_label}</a>
          <a href={contact.phoneHref} class="cta-box-secondary-link">Call {contact.phone}</a>
        </div>
      </div>
    </section>

    <section class="ls-overview">
      <div class="ls-overview__inner reveal">
        <div class="ls-overview__media">
          <img
            src={area.image}
            srcset={area.image_srcset}
            sizes="(max-width: 768px) 100vw, (max-width: 1180px) 50vw, 540px"
            alt={area.image_alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="ls-overview__content">
          <div class="ls-section-label">{lesson.label} · {location.name}</div>
          <h2 class="ls-section-title">{area.intro_title}</h2>
          <p class="ls-overview__text">{area.intro_copy}</p>
          <ul class="ls-focus-list">
            {area.focus_items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* The facility block used to be the FAQ's narrow text column with the address set as
        small mono type — the one place on the page that has to answer "where do I drive to"
        was the least visible thing on it. It now carries the map at full section width. */}
    <section class="sa-facility reveal" aria-labelledby="sa-local-heading">
      <div class="sa-facility__head">
        <div class="ls-section-label">This Facility</div>
        <h2 id="sa-local-heading" class="ls-section-title">{area.local_title}</h2>
        <p>{area.local_copy}</p>
      </div>

      <div class="sa-facility__grid">
        <div class="sa-facility__map">
          <iframe
            src={`https://maps.google.com/maps?q=${encodeURIComponent(location.map_query)}&output=embed`}
            title={`Map to Better Baseball Training ${location.name}, ${location.address_line}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <aside class="sa-facility__card">
          <div class="sa-facility__eyebrow">Where This Lesson Happens</div>
          <h3 class="sa-facility__name">BBT {location.name}</h3>
          <address class="sa-facility__address">
            {location.address_line}<br />{location.city_state_zip}
          </address>
          <ul class="sa-facility__facts">
            <li><span>Lesson</span><strong>{lesson.label}, ages 8-14U</strong></li>
            <li><span>Phone</span><strong><a href={contact.phoneHref}>{contact.phone}</a></strong></li>
          </ul>
          <div class="sa-facility__actions">
            <a
              class="sa-facility__cta"
              href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(location.map_query)}`}
              target="_blank"
              rel="noopener noreferrer"
            >Get Directions</a>
            <a class="sa-facility__cta sa-facility__cta--ghost" href={contact.phoneHref}>
              Call {contact.phone}
            </a>
          </div>
          <a href={locationHubUrl(area.locationKey)} class="bk-card__inline-link">
            Everything at BBT {location.name}
          </a>
        </aside>
      </div>
    </section>

    {localCoaches.length > 0 && (
      <section class="ls-cards reveal" aria-labelledby="sa-coach-heading">
        <div class="seo-section-heading">
          <div class="ls-section-label">Your Coaches</div>
          <h2 id="sa-coach-heading" class="ls-section-title">
            Who Coaches {lesson.label} at {location.name}
          </h2>
        </div>
        <div class="ls-cards__inner">
          {localCoaches.map((coach) => (
            <article class="bk-card">
              <div class="bk-card__eyebrow">{coach.job_title}</div>
              <h3 class="bk-card__title">{coach.name}</h3>
              <p class="bk-card__copy">{coach.description}</p>
              <a href={`${coachesUrl()}#${coach.anchor}`} class="bk-card__inline-link">
                About {coach.name}
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="ls-answer-strip sa-faq reveal" aria-labelledby="sa-faq-heading">
      <div class="ls-answer-strip__inner">
        <div class="ls-section-label">Parents Ask</div>
        <h2 id="sa-faq-heading" class="ls-section-title">
          {lesson.label} in {location.name}: Common Questions
        </h2>
        <div class="ls-faq-list">
          {area.faq_items.map((item) => (
            <details class="faq-item">
              <summary>{item.question} <span class="faq-icon"></span></summary>
              <div class="faq-a-wrap"><div class="faq-a"><div class="faq-a-inner">
                <p>{item.answer}</p>
              </div></div></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="ls-form-section">
      <div class="ls-form-section__inner reveal">
        <div class="cta-box forminator-cta-box ls-form-card">
          <div class="cta-box-topline">
            <div class="cta-box-eyebrow">Parent Inquiry Form</div>
            <div class="cta-box-badge">Ages 8-14U</div>
          </div>
          <h2 class="cta-box-headline">{area.cta_label}</h2>
          <p class="ls-form-copy">
            Tell us about your athlete and the BBT team will follow up about {lesson.label.toLowerCase()} lessons at {location.name}.
          </p>
          <div class="forminator-shell">
            <LeadForm
              source={`${locationHubSlug(area.locationKey)}-${area.slug}`}
              idPrefix={`sa-${area.locationKey}-${area.slug}`}
              areaFocus={area.lessonSlug}
              interest=""
              location={area.locationKey}
            />
          </div>
        </div>
      </div>
    </section>

    {/* Both parents plus the two sideways links. This block is the page's half of the
        service ↔ service-area ↔ location graph. */}
    <section class="ls-cards seo-related-section reveal" aria-labelledby="sa-related-heading">
      <div class="seo-section-heading">
        <div class="ls-section-label">Related Training</div>
        <h2 id="sa-related-heading" class="ls-section-title">Where to Go Next</h2>
      </div>
      <div class="ls-cards__inner">
        <article class="bk-card">
          <div class="bk-card__eyebrow">The Service</div>
          <h3 class="bk-card__title">{lesson.label} Lessons</h3>
          <p class="bk-card__copy">How BBT teaches {lesson.label.toLowerCase()}, at either facility.</p>
          <a href={lessonUrl(lesson.slug)} class="bk-card__inline-link">View {lesson.label} Lessons</a>
        </article>

        <article class="bk-card">
          <div class="bk-card__eyebrow">The Location</div>
          <h3 class="bk-card__title">BBT {location.name}</h3>
          <p class="bk-card__copy">{location.summary}</p>
          <a href={locationHubUrl(area.locationKey)} class="bk-card__inline-link">
            View BBT {location.name}
          </a>
        </article>

        {sameServiceElsewhere && (
          <article class="bk-card">
            <div class="bk-card__eyebrow">Other Facility</div>
            <h3 class="bk-card__title">{lesson.label} in {otherLocation.name}</h3>
            <p class="bk-card__copy">The same lesson at the other BBT facility, if that commute is better.</p>
            <a
              href={serviceAreaUrl(sameServiceElsewhere.locationKey, sameServiceElsewhere.slug)}
              class="bk-card__inline-link"
            >
              View {lesson.label} in {otherLocation.name}
            </a>
          </article>
        )}

        {otherServicesHere.length > 0 && (
          <article class="bk-card">
            <div class="bk-card__eyebrow">Same Facility</div>
            <h3 class="bk-card__title">Other Lessons in {location.name}</h3>
            <p class="bk-card__copy">Everything else BBT {location.name} trains, ages 8-14U.</p>
            <ul class="sa-sibling-list">
              {otherServicesHere.map((s) => (
                <li>
                  <a href={serviceAreaUrl(s.area.locationKey, s.area.slug)}>
                    {s.label} in {location.name}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .ls-breadcrumb {
    margin: 0 0 18px;
  }
  .ls-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    /* The hero is centre-aligned; a flex row would otherwise sit hard against the left. */
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ls-breadcrumb li + li::before {
    content: '/';
    margin-right: 8px;
    opacity: 0.4;
  }
  .ls-breadcrumb a {
    color: var(--cyan);
    text-decoration: none;
  }
  .ls-breadcrumb a:hover {
    text-decoration: underline;
  }
  .ls-breadcrumb [aria-current='page'] {
    opacity: 0.6;
  }
  .sa-sibling-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .sa-sibling-list a {
    color: var(--cyan);
    text-decoration: none;
    font-size: 15px;
  }
  .sa-sibling-list a:hover {
    text-decoration: underline;
  }
  /* Facility band: heading at section width, then map + details card side by side. The map
     leads because the question this section answers is "where is it". */
  .sa-facility {
    padding: 0 72px;
  }
  .sa-facility__head {
    max-width: 1320px;
    margin: 0 auto 26px;
  }
  .sa-facility__head p {
    max-width: 70ch;
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.72);
  }
  .sa-facility__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .sa-facility__map {
    position: relative;
    min-height: 420px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
  }
  /* Deliberately unfiltered — an invert() would match the dark palette but wreck the map's
     legibility, and a directions map has to look obviously working first. */
  .sa-facility__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .sa-facility__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.015)),
      rgba(12, 12, 12, 0.92);
  }
  .sa-facility__eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .sa-facility__name {
    margin: 12px 0 0;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(34px, 3.4vw, 46px);
    line-height: 0.96;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--white);
  }
  .sa-facility__address {
    font-style: normal;
    margin: 14px 0 0;
    font-family: 'DM Mono', monospace;
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }
  .sa-facility__facts {
    width: 100%;
    list-style: none;
    margin: 20px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sa-facility__facts li {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .sa-facility__facts span {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .sa-facility__facts strong {
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.86);
  }
  .sa-facility__facts a {
    color: inherit;
    text-decoration: none;
  }
  .sa-facility__facts a:hover {
    color: var(--cyan);
  }
  .sa-facility__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 22px 0 18px;
  }
  .sa-facility__cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 11px 16px;
    background: var(--yellow);
    color: var(--black);
    text-decoration: none;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .sa-facility__cta:hover,
  .sa-facility__cta:focus-visible {
    background: var(--cyan);
    color: var(--black);
  }
  .sa-facility__cta--ghost {
    background: transparent;
    color: var(--yellow);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .sa-facility__cta--ghost:hover,
  .sa-facility__cta--ghost:focus-visible {
    background: transparent;
    color: var(--cyan);
    border-color: rgba(0, 174, 239, 0.5);
  }

  @media (max-width: 1024px) {
    .sa-facility {
      padding: 0 48px;
    }
    .sa-facility__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .sa-facility__map {
      min-height: 0;
      aspect-ratio: 16 / 8;
    }
  }

  @media (max-width: 768px) {
    .sa-facility {
      padding: 0 24px;
    }
    .sa-facility__map {
      aspect-ratio: 4 / 3;
    }
    .sa-facility__card {
      padding: 26px 22px;
    }
  }

  @media (max-width: 500px) {
    .sa-facility {
      padding: 0 20px;
    }
    .sa-facility__actions .sa-facility__cta {
      width: 100%;
      justify-content: center;
    }
  }

</style>
