---
// The page's ONE lead form, placed above the fold in the hero's right column.
//
// This replaces an earlier two-step attempt (three hero fields handing off to a second,
// fuller form further down). That produced two forms on one page asking overlapping
// questions, which is confusing and redundant. There is now a single form, and the
// separate mid-page form section has been removed from both page templates.
import LeadForm from './LeadForm.astro';

interface Props {
  source: string;
  idPrefix: string;
  areaFocus?: string;
  interest?: string;
  location?: string;
  eyebrow?: string;
  heading?: string;
  copy?: string;
}

const {
  source,
  idPrefix,
  areaFocus = '',
  interest = '',
  location = '',
  eyebrow = 'Parent Inquiry Form',
  heading = 'Book a Lesson',
  copy,
} = Astro.props;
---

<div class="hero-lead-form" id="lead-form">
  <div class="hero-lead-form__eyebrow">{eyebrow}</div>
  <h2 class="hero-lead-form__title">{heading}</h2>
  {copy && <p class="hero-lead-form__copy">{copy}</p>}
  {/* Every .lead-form rule in global.css is scoped under .forminator-shell, so the wrapper
      is load-bearing — without it the form renders unstyled. The hero card supplies its own
      border and background, so the shell's chrome is stripped in .hero-lead-form below. */}
  <div class="forminator-shell">
    <LeadForm
      source={source}
      idPrefix={idPrefix}
      areaFocus={areaFocus}
      interest={interest}
      location={location}
    />
  </div>
</div>
