---
// Above-the-fold lead capture for service and location pages.
//
// Why this is a two-step form rather than a direct post: /api/lead validates ALL of
// firstName, lastName, email, phone, playerName, playerDob, areaFocus, interest and
// location, and 400s on anything less. A short hero form posting straight to it would
// fail every time. Relaxing that validation would push partial leads into the client's
// GoHighLevel workflow, which is a working pipeline we should not weaken for a layout
// change. So this captures the three fields worth asking for above the fold, then hands
// them to the full form below and scrolls the visitor there.
interface Props {
  targetFormId: string; // id of the section containing the full LeadForm
  idPrefix: string;
  areaFocus?: string;
  heading?: string;
}

const { targetFormId, idPrefix, areaFocus = '', heading = 'Start Here' } = Astro.props;

const areaOptions = [
  { value: 'hitting', label: 'Hitting' },
  { value: 'pitching', label: 'Pitching' },
  { value: 'catching', label: 'Catching' },
  { value: 'fielding', label: 'Fielding' },
];
---

<div class="hero-lead-start" data-hero-lead-start data-target-form={targetFormId}>
  <div class="hero-lead-start__eyebrow">{heading}</div>
  <h2 class="hero-lead-start__title">Book a Lesson</h2>

  <div class="hero-lead-start__field">
    <label for={`${idPrefix}-hero-name`}>Full Name</label>
    <input type="text" id={`${idPrefix}-hero-name`} data-hero-field="fullName" placeholder="First &amp; Last Name" autocomplete="name" />
  </div>

  <div class="hero-lead-start__field">
    <label for={`${idPrefix}-hero-phone`}>Phone</label>
    <input type="tel" id={`${idPrefix}-hero-phone`} data-hero-field="phone" placeholder="Phone" autocomplete="tel" />
  </div>

  <div class="hero-lead-start__field">
    <label for={`${idPrefix}-hero-area`}>Area of Focus</label>
    <select id={`${idPrefix}-hero-area`} data-hero-field="areaFocus">
      <option value="" selected={!areaFocus}>Select Area of Focus</option>
      {areaOptions.map((opt) => (
        <option value={opt.value} selected={areaFocus === opt.value}>{opt.label}</option>
      ))}
    </select>
  </div>

  <button type="button" class="hero-lead-start__submit" data-hero-lead-continue>Continue</button>
  <p class="hero-lead-start__note">Takes about 30 seconds. We reply within one business day.</p>
</div>
