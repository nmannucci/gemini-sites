---
// Ported 1:1 from house36-bbt/header.php
import { primaryMenu } from '../data/nav';
import { contact } from '../data/contact';
import { bookingUrl } from '../data/urls';
---

<a class="skip-link screen-reader-text" href="#main-content">Skip to main content</a>

<a class="tryouts-banner" href="/#tryouts" aria-label="BBT Black Team Tryouts — see details">
  <span class="tryouts-banner-dot" aria-hidden="true"></span>
  <span class="tryouts-banner-text">
    <strong>BBT Black Team Tryouts</strong>
    <span class="tryouts-banner-divider" aria-hidden="true">·</span>
    <span class="tryouts-banner-meta">Wed May 27 · Folsom Lake College</span>
    <span class="tryouts-banner-link">See Details</span>
  </span>
</a>

<nav aria-label="Primary navigation">
  <button class="hamburger" aria-label="Open menu" type="button">
    <span class="hamburger-box">
      <span class="hamburger-inner"></span>
    </span>
  </button>

  <a href="/" class="nav-logo-link" rel="home" aria-label="Go to homepage">
    <img
      src="/assets/brand-assets/BBT Logo 2.jpeg"
      alt="Better Baseball Training"
      class="nav-logo"
      loading="eager"
      decoding="async"
      fetchpriority="auto"
    />
  </a>

  <ul class="nav-links">
    {primaryMenu.map((item) =>
      item.children ? (
        <li class="menu-item-has-children">
          <a href={item.url}>{item.title}</a>
          <ul class="sub-menu">
            {item.children.map((c) => (
              <li><a href={c.url}>{c.title}</a></li>
            ))}
          </ul>
        </li>
      ) : (
        <li><a href={item.url}>{item.title}</a></li>
      )
    )}
  </ul>

  <div class="nav-actions">
    <a href={contact.phoneHref} class="nav-cta nav-cta--ghost">Call Us</a>
    <a href={bookingUrl()} class="nav-cta">Book Now</a>
  </div>
</nav>

<div class="mobile-menu">
  <button class="mobile-menu-close" aria-label="Close menu" type="button">X</button>
  <ul class="mobile-menu-links">
    {primaryMenu.map((item) =>
      item.children ? (
        <li class="menu-item-has-children">
          <a href={item.url}>{item.title}</a>
          <ul class="sub-menu">
            {item.children.map((c) => (
              <li><a href={c.url}>{c.title}</a></li>
            ))}
          </ul>
        </li>
      ) : (
        <li><a href={item.url}>{item.title}</a></li>
      )
    )}
  </ul>
</div>
