{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hitting",
      "destination": "/lessons/hitting",
      "statusCode": 301
    },
    {
      "source": "/hitting.html",
      "destination": "/lessons/hitting",
      "statusCode": 301
    },
    {
      "source": "/rocklin",
      "destination": "/baseball-lessons-rocklin",
      "statusCode": 301
    },
    {
      "source": "/rocklin.html",
      "destination": "/baseball-lessons-rocklin",
      "statusCode": 301
    },
    {
      "source": "/el-dorado-hills",
      "destination": "/baseball-lessons-el-dorado-hills",
      "statusCode": 301
    },
    {
      "source": "/el-dorado-hills.html",
      "destination": "/baseball-lessons-el-dorado-hills",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml"
    },
    {
      "source": "/api/lead",
      "destination": "https://better-baseball-training.pages.dev/api/lead"
    }
  ]
}
