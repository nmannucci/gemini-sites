---
import { contact, getAreas, getServicePillars, primaryCta, site } from "../data/site";

const pillars = getServicePillars();
const areas = getAreas();
---
<header class="site-header">
  <div class="utility-bar">
    <div class="utility-inner container">
      <span class="utility-welcome">Welcome to {site.businessName}</span>
      <div class="utility-links">
        <span>Middle Sunset · San Francisco</span>
        <a href={contact.href}><i class="ph ph-phone" aria-hidden="true"></i>{site.phone}</a>
        <span>{site.hours}</span>
        {site.clientPortalUrl && <a href={site.clientPortalUrl} target="_blank" rel="noopener"><i class="ph ph-lock-key" aria-hidden="true"></i>Client portal</a>}
        {site.paymentUrl && <a href={site.paymentUrl} target="_blank" rel="noopener"><i class="ph ph-credit-card" aria-hidden="true"></i>Pay invoice</a>}
      </div>
    </div>
  </div>

  <div class="nav-bar">
    <div class="nav-inner container">
      <a class="brand" href="/" aria-label={`${site.businessName} home`}>
        {site.logoImage
          ? <span class="brand-logos"><img src={site.logoImage} alt="JJR" width="163" height="82" /><img src="/brand/cpa-logo.png" alt="CPA" width="168" height="82" /></span>
          : <span class="brand-mark" aria-hidden="true">{site.logoText}</span>}
        <span class="brand-name">{site.brandDisplayName}</span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <div class="services-menu">
          <button class="services-trigger" type="button" aria-expanded="false" aria-controls="services-panel" aria-haspopup="true">Services<i class="ph ph-caret-down" aria-hidden="true"></i></button>
          <div class="services-panel" id="services-panel">
            {pillars.map((pillar) => <div class="nav-group"><a class="pillar-nav-link" href={pillar.path}>{pillar.name}</a>{pillar.services.map((service) => <a href={service.path}>{service.name}</a>)}</div>)}
          </div>
        </div>
        <a href="/who-we-help/">Who we help</a>
        <a href="/#about">About</a>
        <div class="services-menu areas-menu">
          <button class="services-trigger" type="button" aria-expanded="false" aria-controls="areas-panel" aria-haspopup="true">Areas served<i class="ph ph-caret-down" aria-hidden="true"></i></button>
          <div class="services-panel areas-panel" id="areas-panel">
            <span class="nav-panel-label">Core counties</span>
            {areas.slice(0, 3).map((area) => <a href={area.path}>{area.name}</a>)}
          </div>
        </div>
        <a href="/contact/">Contact</a>
      </nav>

      <a class="nav-cta" href={primaryCta.href} target={primaryCta.external ? "_blank" : undefined} rel={primaryCta.external ? "noopener" : undefined}>{primaryCta.label}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation"><span></span><span></span></button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" aria-hidden="true" inert>
    <details class="mobile-services">
      <summary>Services<i class="ph ph-plus" aria-hidden="true"></i></summary>
      <div>{pillars.map((pillar) => <div class="mobile-nav-group"><a class="mobile-pillar" href={pillar.path}>{pillar.name}</a>{pillar.services.map((service) => <a href={service.path}>{service.name}</a>)}</div>)}</div>
    </details>
    <a href="/who-we-help/">Who we help</a>
    <a href="/#about">About</a>
    <details class="mobile-services">
      <summary>Areas served<i class="ph ph-plus" aria-hidden="true"></i></summary>
      <div>
        <span class="mobile-panel-label">Core counties</span>
        {areas.slice(0, 3).map((area) => <a href={area.path}>{area.name}</a>)}
      </div>
    </details>
    <a href="/contact/">Contact</a>
    <a class="mobile-call" href={contact.href}>Call {site.phone}</a>
    <a class="mobile-cta" href={primaryCta.href} target={primaryCta.external ? "_blank" : undefined} rel={primaryCta.external ? "noopener" : undefined}>{primaryCta.label}</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const desktopMenus = Array.from(document.querySelectorAll<HTMLElement>(".services-menu"));
  const setMenuOpen = (menu: HTMLElement, open: boolean) => {
    menu.dataset.open = String(open);
    menu.querySelector<HTMLButtonElement>(".services-trigger")?.setAttribute("aria-expanded", String(open));
  };
  const closeDesktopMenus = () => desktopMenus.forEach((menu) => setMenuOpen(menu, false));
  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      menu.setAttribute("aria-hidden", String(!open));
      menu.inert = !open;
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        closeDesktopMenus();
      }
    });
    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => event.matches && setOpen(false));
  }
  desktopMenus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>(".services-trigger");
    trigger?.addEventListener("click", () => {
      const nextOpen = menu.dataset.open !== "true";
      closeDesktopMenus();
      setMenuOpen(menu, nextOpen);
    });
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeDesktopMenus));
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !desktopMenus.some((menu) => menu.contains(event.target))) closeDesktopMenus();
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-sticky); background: var(--white); }
  .utility-bar { color: var(--ink); background: #f3f7f9; }
  .utility-inner { min-height: 42px; display: flex; align-items: center; gap: 24px; font-size: 0.75rem; }
  .utility-inner a { display: inline-flex; align-items: center; gap: 7px; text-decoration: none; }
  .utility-welcome { color: var(--muted); }
  .utility-links { display: flex; align-items: center; gap: 22px; margin-left: auto; }
  .utility-links > span { color: var(--muted); }
  .nav-bar { border-bottom: 1px solid var(--line); box-shadow: 0 2px 8px rgba(29, 29, 25, 0.035); }
  .nav-inner { min-height: 78px; display: flex; align-items: center; gap: 34px; }
  .brand { min-width: 0; display: inline-flex; align-items: center; gap: 12px; margin-right: auto; text-decoration: none; }
  .brand-logos { display: inline-flex; align-items: center; flex: none; }
  .brand-logos img { width: auto; height: 38px; max-width: 90px; object-fit: contain; }
  .brand-logos img + img { margin-left: -5px; }
  .brand-mark { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 50%; color: var(--brand-contrast); background: var(--brand); font: 600 0.9rem/1 var(--display); }
  .brand-name { max-width: 290px; overflow: hidden; font: 600 1.22rem/1.05 var(--display); text-overflow: ellipsis; white-space: nowrap; }
  .desktop-nav { display: flex; align-items: center; gap: 24px; }
  .desktop-nav > a, .services-trigger { color: var(--ink); font-size: 0.875rem; font-weight: 500; text-decoration: none; transition: color 160ms var(--ease-out); }
  .desktop-nav a:hover, .desktop-nav a:focus-visible { color: var(--brand); }
  .services-menu { position: relative; }
  .services-trigger { min-height: 44px; display: flex; align-items: center; gap: 6px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .services-trigger i { font-size: 0.75rem; transition: transform 180ms var(--ease-out); }
  .services-menu[data-open="true"] > .services-trigger { color: var(--brand); }
  .services-menu[data-open="true"] > .services-trigger i { transform: rotate(180deg); }
  .services-panel { position: absolute; z-index: var(--z-dropdown); top: 100%; left: -18px; width: 330px; display: grid; padding: 8px; border: 1px solid var(--line); background: var(--white); box-shadow: 0 8px 18px rgba(29, 29, 25, 0.1); opacity: 0; pointer-events: none; visibility: hidden; transform: translateY(-4px); transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out), visibility 160ms; }
  .areas-panel { width: 260px; }
  .nav-panel-label { padding: 10px 12px 3px; color: var(--brand); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.055em; text-transform: uppercase; }
  .nav-group + .nav-group { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); }
  .services-panel a { min-width: 0; min-height: 46px; display: flex; align-items: center; padding: 10px 12px; font-size: 0.9rem; font-weight: 500; line-height: 1.25; text-decoration: none; transition: color 160ms var(--ease-out), background 160ms var(--ease-out); }
  .services-panel .pillar-nav-link { min-height: 38px; color: var(--brand); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .services-panel a:hover, .services-panel a:focus-visible { color: var(--brand); background: var(--cream-light); }

  @media (hover: hover) and (min-width: 901px) {
    .services-menu:hover > .services-trigger, .services-menu:focus-within > .services-trigger { color: var(--brand); }
    .services-menu:hover > .services-trigger i, .services-menu:focus-within > .services-trigger i { transform: rotate(180deg); }
    .services-menu:hover > .services-panel { opacity: 1; pointer-events: auto; visibility: visible; transform: none; }
  }

  .services-menu:focus-within > .services-panel,
  .services-menu[data-open="true"] > .services-panel { opacity: 1; pointer-events: auto; visibility: visible; transform: none; }

  .nav-cta { display: inline-flex; min-height: 44px; align-items: center; padding: 0 17px; border: 1px solid var(--brand); border-radius: var(--radius); color: var(--brand-contrast); background: var(--brand); font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: background 160ms var(--ease-out), transform 160ms var(--ease-out); }
  .nav-cta:hover { color: var(--brand-dark-contrast); background: var(--brand-dark); transform: translateY(-1px); }
  .nav-cta:active { transform: none; }
  .nav-toggle, .mobile-menu { display: none; }

  @media (max-width: 900px) {
    .utility-bar, .desktop-nav, .nav-cta { display: none; }
    .nav-inner { min-height: 70px; }
    .brand-name { max-width: min(60vw, 310px); font-size: 1.02rem; }
    .brand-logos img { height: 32px; }
    .nav-toggle { display: grid; width: 44px; height: 44px; padding: 0; place-content: center; gap: 7px; border: 0; background: transparent; cursor: pointer; }
    .nav-toggle span { width: 24px; height: 2px; background: var(--ink); transition: transform 180ms var(--ease-out); }
    .site-header[data-open="true"] .nav-toggle span:first-child { transform: translateY(4.5px) rotate(45deg); }
    .site-header[data-open="true"] .nav-toggle span:last-child { transform: translateY(-4.5px) rotate(-45deg); }
    .mobile-menu { position: fixed; inset: 70px 0 0; display: grid; align-content: start; gap: 0; padding: 22px 24px 38px; background: var(--cream-light); opacity: 0; overflow-y: auto; overscroll-behavior: contain; pointer-events: none; transform: translateY(-8px); transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out); }
    .site-header[data-open="true"] .mobile-menu { opacity: 1; pointer-events: auto; transform: none; }
    .mobile-menu > a, .mobile-services > summary { padding: 17px 2px; border-bottom: 1px solid var(--line); font: 500 2rem/1 var(--display); text-decoration: none; }
    .mobile-services > summary { display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; }
    .mobile-services > summary::-webkit-details-marker { display: none; }
    .mobile-services > summary i { font-size: 1.25rem; transition: transform 180ms var(--ease-out); }
    .mobile-services[open] > summary i { transform: rotate(45deg); }
    .mobile-services > div { display: grid; padding: 8px 0 13px 16px; border-bottom: 1px solid var(--line); }
    .mobile-nav-group { display: grid; }
    .mobile-nav-group + .mobile-nav-group { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
    .mobile-services > div a { min-height: 48px; display: flex; align-items: center; padding: 11px 2px; color: var(--muted); font: 500 1rem/1.25 var(--sans); text-decoration: none; }
    .mobile-services > div .mobile-pillar { color: var(--brand); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .mobile-panel-label { padding: 12px 2px 2px; color: var(--brand); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
    .mobile-menu .mobile-call { color: var(--muted); font: 500 0.9rem/1.3 var(--sans); }
    .mobile-menu .mobile-cta { margin-top: 22px; border: 0; color: var(--brand-contrast); background: var(--brand); font: 600 0.84rem/52px var(--sans); text-align: center; }
  }

  @media (max-width: 520px) {
    .brand-name { display: none; }
  }
</style>
