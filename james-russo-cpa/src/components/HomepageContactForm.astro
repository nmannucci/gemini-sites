---
import { site } from "../data/site";

const recipient = site.email;
---
<form class="homepage-contact-form" data-homepage-contact-form data-recipient={recipient} novalidate>
  <div class="form-heading">
    <span>Send a confidential note</span>
    <p>Share the broad outline. Jim will follow up about fit and next steps.</p>
  </div>

  <div class="form-fields">
    <label>
      <span>Your name</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>Email address</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>
      <span>Phone <em>(optional)</em></span>
      <input name="phone" type="tel" autocomplete="tel" />
    </label>
    <label class="message-field">
      <span>How can Jim help?</span>
      <textarea name="message" rows="4" required></textarea>
    </label>
  </div>

  <div class="form-footer">
    <p>Please do not include Social Security numbers, account numbers, or tax documents here.</p>
    <button type="submit">Send inquiry<i class="ph ph-arrow-up-right" aria-hidden="true"></i></button>
  </div>
</form>

<script>
  document.querySelectorAll("[data-homepage-contact-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const subject = encodeURIComponent("Website inquiry for James J. Russo, CPA");
      const body = encodeURIComponent([
        `Name: ${data.get("name") || ""}`,
        `Email: ${data.get("email") || ""}`,
        `Phone: ${data.get("phone") || ""}`,
        "",
        "How I can help:",
        String(data.get("message") || "")
      ].join("\n"));
      const recipient = form.dataset.recipient;
      window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
    });
  });
</script>

<style>
  .homepage-contact-form { padding: clamp(26px, 3vw, 38px); border: 1px solid var(--line); background: var(--cream-light); }
  .form-heading > span { color: var(--brand); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.055em; text-transform: uppercase; }
  .form-heading > p { max-width: 520px; margin-top: 9px; color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
  .form-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; margin-top: 25px; }
  label { display: grid; gap: 7px; }
  label > span { color: var(--ink); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.025em; }
  label em { color: var(--muted); font-style: normal; font-weight: 500; }
  input, textarea { width: 100%; border: 1px solid var(--line); border-radius: 0; color: var(--ink); background: var(--white); font: 0.95rem/1.4 var(--sans); }
  input { min-height: 46px; padding: 10px 12px; }
  textarea { min-height: 104px; padding: 11px 12px; resize: vertical; }
  input:focus, textarea:focus { outline: 2px solid color-mix(in srgb, var(--brand) 42%, transparent); outline-offset: 2px; border-color: var(--brand); }
  .message-field { grid-column: 1 / -1; }
  .form-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 22px; }
  .form-footer > p { margin: 0; color: var(--muted); font-size: 0.76rem; line-height: 1.5; }
  button { display: inline-flex; flex: none; min-height: 46px; align-items: center; gap: 8px; padding: 0 18px; border: 1px solid var(--brand); border-radius: var(--radius); color: var(--brand-contrast); background: var(--brand); font: 700 0.84rem/1 var(--sans); cursor: pointer; transition: background 160ms var(--ease-out), transform 160ms var(--ease-out); }
  button:hover { color: var(--brand-dark-contrast); background: var(--brand-dark); transform: translateY(-1px); }
  @media (max-width: 520px) { .form-fields { grid-template-columns: 1fr; } .form-footer { display: grid; } button { width: 100%; justify-content: center; } }
</style>
