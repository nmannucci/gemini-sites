---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HomepageContactForm from "../components/HomepageContactForm.astro";
import { contact, getAreas, getSanFranciscoServicePages, getServices, site } from "../data/site";

export function getStaticPaths() {
  return getSanFranciscoServicePages().map((localService) => ({
    params: { slug: localService.localPath.replace(/^\//, "").replace(/\/$/, "") },
    props: { localService }
  }));
}

const { localService } = Astro.props;
const services = getServices();
const areas = getAreas();
const otherLocalServices = getSanFranciscoServicePages().filter((item) => item.slug !== localService.slug);
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: localService.pillarName, href: `/services/${localService.pillarSlug}/` },
  { label: localService.name, href: localService.path },
  { label: "San Francisco" }
];
const businessId = site.siteUrl ? `${site.siteUrl}/#business` : "#business";
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": site.siteUrl ? `${site.siteUrl}${localService.localPath}#service` : `${localService.localPath}#service`,
  serviceType: localService.name,
  name: localService.title,
  description: localService.description,
  url: site.siteUrl ? `${site.siteUrl}${localService.localPath}` : localService.localPath,
  provider: { "@id": businessId },
  areaServed: { "@type": "City", name: "San Francisco", containedInPlace: { "@type": "State", name: "California" } }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: localService.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } }))
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: site.siteUrl ? `${site.siteUrl}${item.href || localService.localPath}` : item.href || localService.localPath
  }))
};
---

<BaseLayout title={`${localService.slug === "real-estate-and-landlord-tax" ? "Real Estate Tax in San Francisco, CA" : localService.title} | James J. Russo, CPA`} description={localService.description} schemas={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <Header />
  <main>
    <Breadcrumbs items={breadcrumbItems} />
    <section class="local-hero">
      <div class="local-hero-inner container">
        <div class="local-copy">
          <span class="eyebrow">Middle Sunset practice · Serving San Francisco</span>
          <h1>{localService.title}</h1>
          <p>{localService.intro}</p>
          <div class="local-details"><span><i class="ph ph-map-pin" aria-hidden="true"></i>Middle Sunset, San Francisco</span><span><i class="ph ph-calendar" aria-hidden="true"></i>By appointment</span></div>
          <div class="local-actions"><a class="button light" href="/contact/">Contact Jim</a><a class="local-call" href={contact.href}><i class="ph ph-phone" aria-hidden="true"></i>Call Jim at {site.phone}</a></div>
        </div>
        <HomepageContactForm />
      </div>
    </section>

    <section class="local-intro container">
      <div><span class="eyebrow">San Francisco tax guidance</span><h2 class="section-title">Local context, direct CPA attention.</h2></div>
      <div><p>{localService.localContext}</p><p>Jim has been a CPA since 1984, founded his San Francisco practice in 1990, and works directly with each client rather than handing the relationship to a large team.</p></div>
    </section>

    <section class="scenarios">
      <div class="container">
        <span class="eyebrow">Common reasons to reach out</span>
        <h2 class="section-title">Questions this service can help organize.</h2>
        <div class="scenario-grid">{localService.scenarios.map((scenario, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{scenario}</h3></article>)}</div>
      </div>
    </section>

    <section class="process container">
      <div><span class="eyebrow">What happens next</span><h2 class="section-title">A straightforward process.</h2></div>
      <div class="process-grid">
        <article><strong>01</strong><h3>Describe the situation</h3><p>Share the deadline, decision, and the broad outline of the tax issue.</p></article>
        <article><strong>02</strong><h3>Organize the right records</h3><p>Jim identifies the documents and details that matter to this engagement.</p></article>
        <article><strong>03</strong><h3>Move forward informed</h3><p>Receive careful work, a direct explanation, and practical next steps.</p></article>
      </div>
    </section>

    <section class="san-francisco-reach">
      <div class="reach-inner container">
        <div>
          <span class="eyebrow">Where Jim serves</span>
          <h2 class="section-title">Based in Middle Sunset. Available across San Francisco.</h2>
          <p>The practice serves clients throughout the city, including the Sunset and Richmond districts, Parkside, West Portal, and other San Francisco neighborhoods. Contact Jim to confirm remote or by-appointment availability.</p>
          <div class="neighborhoods"><span>Middle Sunset</span><span>Richmond District</span><span>Parkside</span><span>West Portal</span><span>Across San Francisco</span></div>
        </div>
        <iframe title="Map of Middle Sunset, San Francisco" src={site.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <section class="related-services container">
      <div><span class="eyebrow">Other services in San Francisco</span><h2 class="section-title">Related tax services.</h2><p>Explore the broader service category and other ways Jim helps San Francisco clients.</p></div>
      <div class="link-grid">
        <a class="parent-card" href={`/services/${localService.pillarSlug}/`}><span>Service category</span><h3>{localService.pillarName}</h3><p>View the full group of related services.</p></a>
        {otherLocalServices.map((item) => <a href={item.localPath}><span>San Francisco service</span><h3>{item.name}</h3><p>{item.summary}</p></a>)}
      </div>
    </section>

    <section class="local-faq">
      <div class="local-faq-inner container">
        <div><span class="eyebrow">San Francisco FAQs</span><h2 class="section-title">Answers before you reach out.</h2><p>These questions are specific to the service and Jim's Middle Sunset practice details.</p></div>
        <div class="faq-list">{localService.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.q}<i class="ph ph-plus" aria-hidden="true"></i></summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <section class="other-areas container">
      <div><span class="eyebrow">Also serving</span><h2 class="section-title">Other Bay Area counties.</h2><p>Jim also works with clients in Marin, San Mateo, Santa Clara, Alameda, and Contra Costa Counties. Explore each area for local practice details and available services.</p></div>
      <div class="area-cards">{areas.filter((area) => area.slug !== "san-francisco-county").map((area) => <a href={area.path}><span>{area.tier}</span><h3>{area.name}</h3><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div>
    </section>

    <section class="nap">
      <div class="nap-inner container">
        <div><span class="eyebrow">Firm details</span><h2>{site.businessName}</h2><p>Street address withheld by request. Meetings are scheduled directly.</p></div>
        <dl><div><dt>Location</dt><dd>{site.address}</dd></div><div><dt>Meetings</dt><dd>{site.hours}</dd></div><div><dt>Phone</dt><dd><a href={contact.href}>{site.phone}</a></dd></div><div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div></dl>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .local-hero { padding: 64px 0 76px; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .local-hero-inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(460px, 0.78fr); align-items: start; gap: clamp(52px, 8vw, 106px); }
  .local-copy { padding-top: 24px; }
  .local-hero .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); text-transform: uppercase; }
  .local-hero h1 { max-width: 700px; margin-top: 18px; font-size: clamp(3.25rem, 4.35vw, 4.6rem); line-height: 0.98; }
  .local-hero p { max-width: 690px; margin-top: 24px; color: color-mix(in srgb, var(--brand-dark-contrast) 80%, transparent); font-size: 1.04rem; line-height: 1.72; }
  .local-details { display: flex; flex-wrap: wrap; gap: 14px 24px; margin-top: 24px; color: color-mix(in srgb, var(--brand-dark-contrast) 76%, transparent); font-size: 0.84rem; }
  .local-details span, .local-call { display: inline-flex; align-items: center; gap: 7px; }
  .local-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 25px; }
  .local-call { font-weight: 600; text-decoration: none; }
  .local-hero :global(.homepage-contact-form) { color: var(--ink); background: var(--white); box-shadow: 0 18px 42px rgba(0,0,0,0.2); }
  .local-intro, .process, .related-services, .other-areas { display: grid; grid-template-columns: 0.78fr 1fr; gap: clamp(52px, 9vw, 120px); padding-block: 104px; }
  .local-intro h2, .process h2, .related-services h2, .other-areas h2 { margin-top: 15px; }
  .local-intro > div:last-child { padding-top: 28px; }
  .local-intro p, .related-services > div:first-child p, .other-areas > div:first-child p { color: var(--muted); line-height: 1.74; }
  .local-intro p + p { margin-top: 20px; }
  .related-services > div:first-child p, .other-areas > div:first-child p { margin-top: 20px; }
  .scenarios { padding: 98px 0 104px; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .scenarios .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); }
  .scenarios h2 { max-width: 780px; margin-top: 15px; }
  .scenario-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.2); border-left: 1px solid rgba(255,255,255,0.2); }
  .scenario-grid article { min-height: 220px; display: flex; flex-direction: column; padding: 26px; border-right: 1px solid rgba(255,255,255,0.2); border-bottom: 1px solid rgba(255,255,255,0.2); }
  .scenario-grid span { color: color-mix(in srgb, var(--brand-dark-contrast) 62%, transparent); font-size: 0.78rem; }
  .scenario-grid h3 { margin-top: auto; font-size: 1.55rem; line-height: 1.06; }
  .process-grid { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .process-grid article { display: grid; grid-template-columns: 50px 1fr; gap: 12px 20px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .process-grid strong { grid-row: 1 / 3; color: var(--brand); }
  .process-grid h3 { font-size: 1.5rem; }
  .process-grid p { color: var(--muted); line-height: 1.66; }
  .san-francisco-reach { padding: 100px 0; background: var(--cream); }
  .reach-inner { display: grid; grid-template-columns: 0.82fr 1fr; align-items: stretch; gap: clamp(50px, 8vw, 100px); }
  .reach-inner h2 { margin-top: 15px; }
  .reach-inner p { margin-top: 20px; color: var(--muted); line-height: 1.72; }
  .neighborhoods { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 24px; }
  .neighborhoods span { padding: 8px 11px; border: 1px solid var(--line); background: var(--white); font-size: 0.8rem; }
  .reach-inner iframe { width: 100%; min-height: 430px; border: 0; }
  .link-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .link-grid a { min-height: 220px; display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .link-grid a:hover { border-color: var(--brand); }
  .link-grid span, .area-cards span { color: var(--brand); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; }
  .link-grid h3 { margin-top: 26px; font-size: 1.45rem; }
  .link-grid p { margin-top: 11px; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }
  .parent-card { background: var(--cream); }
  .local-faq { padding: 104px 0; background: var(--cream); }
  .local-faq-inner { display: grid; grid-template-columns: 0.62fr 1fr; gap: clamp(52px, 9vw, 120px); }
  .local-faq h2 { margin-top: 15px; }
  .local-faq-inner > div:first-child p { margin-top: 20px; color: var(--muted); line-height: 1.7; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 22px 0; cursor: pointer; list-style: none; font: 500 1.34rem/1.16 var(--display); }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary i { color: var(--brand); transition: transform 180ms var(--ease-out); }
  .faq-list details[open] summary i { transform: rotate(45deg); }
  .faq-list p { padding: 0 42px 24px 0; color: var(--muted); line-height: 1.7; }
  .area-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .area-cards a { position: relative; min-height: 150px; padding: 22px 48px 22px 22px; border: 1px solid var(--line); text-decoration: none; }
  .area-cards a:hover { border-color: var(--brand); }
  .area-cards h3 { margin-top: 23px; font-size: 1.35rem; }
  .area-cards i { position: absolute; top: 22px; right: 22px; color: var(--brand); }
  .nap { padding: 96px 0; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .nap-inner { display: grid; grid-template-columns: 0.78fr 1fr; gap: clamp(52px, 9vw, 120px); }
  .nap .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); }
  .nap h2 { margin-top: 15px; font-size: 3rem; }
  .nap p { margin-top: 17px; color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); }
  .nap dl { margin: 0; border-top: 1px solid rgba(255,255,255,0.2); }
  .nap dl > div { display: grid; grid-template-columns: 110px 1fr; gap: 20px; padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,0.2); }
  .nap dt { color: color-mix(in srgb, var(--brand-dark-contrast) 64%, transparent); font-size: 0.76rem; text-transform: uppercase; }
  .nap dd { margin: 0; }
  .nap a { text-decoration: none; }
  @media (max-width: 920px) { .local-hero-inner, .local-intro, .process, .reach-inner, .related-services, .local-faq-inner, .other-areas, .nap-inner { grid-template-columns: 1fr; } .local-intro, .process, .related-services, .other-areas { gap: 28px; } .local-copy { grid-row: 1; padding-top: 0; } .local-hero :global(.homepage-contact-form) { grid-row: 2; } .scenario-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .local-hero { padding-block: 48px 68px; } .local-hero h1 { font-size: clamp(3.2rem, 15vw, 4.5rem); } .local-intro, .process, .related-services, .other-areas { gap: 22px; padding-block: 78px; } .scenarios, .san-francisco-reach, .local-faq, .nap { padding-block: 78px; } .scenario-grid, .link-grid, .area-cards { grid-template-columns: 1fr; } .reach-inner iframe { min-height: 340px; } .nap dl > div { grid-template-columns: 1fr; gap: 6px; } }
</style>
