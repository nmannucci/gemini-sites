---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomepageContactForm from "../components/HomepageContactForm.astro";
import { contact, getServicePillars, getServices, site } from "../data/site";

const services = getServices();
const pillars = getServicePillars();
const featuredServices = services.slice(0, 4);
const serviceIcons = ["ph-file-text", "ph-chart-line-up", "ph-buildings", "ph-briefcase"];
const clientGroups = [
  {
    title: "Small-business owners",
    description: "Entity choices, estimated taxes, business returns, and practical planning grounded in the realities of ownership.",
    image: "/assets/james-russo/who-small-business.webp",
    alt: "Small-business point-of-sale system in use",
    href: "/services/tax-preparation/small-business-tax-services/"
  },
  {
    title: "Real estate owners & landlords",
    description: "Tax planning for rentals, depreciation, capital gains, home sales, and the financial decisions behind a property.",
    image: "/assets/james-russo/who-real-estate.webp",
    alt: "A hand holding keys for a residential property",
    href: "/services/tax-planning/real-estate-and-landlord-tax/"
  },
  {
    title: "High-income individuals",
    description: "Preparation and planning for multiple income sources, bonuses, investments, property, and consequential financial decisions.",
    image: "/assets/james-russo/who-high-income.webp",
    alt: "Financial reports, a calculator, and a laptop used for tax planning",
    href: "/who-we-help/high-income-individuals/"
  },
  {
    title: "Technology professionals",
    description: "Guidance for employees and managers navigating stock options, equity compensation, and changing tax exposure.",
    image: "/assets/james-russo/who-technology.webp",
    alt: "Technology professional working at a computer",
    href: "/services/tax-planning/stock-option-tax-planning/"
  },
  {
    title: "Retired taxpayers",
    description: "Thoughtful preparation around pensions, retirement income, trusts, property, and important life transitions.",
    image: "/assets/james-russo/who-retirement.webp",
    alt: "Retired couple reviewing financial paperwork at home",
    href: "/services/tax-preparation/retirement-and-life-change-planning/"
  }
];
const milestones = [
  { year: "1984", title: "CPA and graduate tax education", body: "Jim became a Certified Public Accountant and earned his MBA-taxation degree from Golden Gate University." },
  { year: "1990", title: "San Francisco practice founded", body: "He established his own accounting firm to advise individuals and small-business owners directly." },
  { year: "2004", title: "Marin County practice acquired", body: "The firm expanded its relationships and experience across another core Bay Area market." }
];
---
<BaseLayout title={`San Francisco CPA & Tax Preparation | ${site.businessName}`} description="San Francisco CPA James J. Russo provides individual tax preparation and year-round planning for business owners, technology professionals, property owners, and retirees.">
  <Header />
  <main class="reference-home">
    <section class="hero">
      <div class="hero-inner container">
        <div class="hero-copy">
          <span class="hero-kicker">James J. Russo, CPA · Serving the Bay Area since 1990</span>
          <h1>Trusted San Francisco tax preparation &amp; planning.</h1>
          <p>Work directly with an experienced San Francisco CPA for individual income tax preparation, year-round planning, and the financial decisions that shape what comes next.</p>
          <div class="hero-actions">
            <a class="primary-action" href="#services">Explore tax services<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            <a class="secondary-action" href="#contact">Contact Jim</a>
          </div>
          <div class="hero-proof" aria-label="Practice credentials">
            <span><strong>35+</strong> years in practice</span>
            <span><strong>CPA</strong> since 1984</span>
            <span><strong>3 + 3</strong> primary and additional counties</span>
          </div>
        </div>

        <div class="hero-visual">
          <img src={site.heroImage} alt="A tax professional reviewing financial information with clients" width="1536" height="1024" fetchpriority="high" />
          <div class="hero-card credential-card"><i class="ph ph-seal-check" aria-hidden="true"></i><span>Certified Public Accountant<br /><strong>Since 1984</strong></span></div>
          <div class="hero-card location-card"><i class="ph ph-map-pin" aria-hidden="true"></i><span>Middle Sunset<br /><strong>San Francisco</strong></span></div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="James Russo practice highlights">
      <div class="container trust-grid">
        <div><strong>35+ years</strong><span>Serving clients</span></div>
        <div><strong>CPA since 1984</strong><span>Longstanding professional experience</span></div>
        <div><strong>MBA–Taxation</strong><span>Golden Gate University</span></div>
        <div><strong>Bay Area focused</strong><span>Primarily San Francisco, Marin &amp; San Mateo</span></div>
      </div>
    </section>

    <section class="about" id="about">
      <div class="about-inner container">
        <div class="about-image">
          <img src="/brand/james-russo-headshot.jpg" alt="James J. Russo, CPA" width="343" height="500" loading="lazy" decoding="async" />
          <div class="about-badge"><strong>James J. Russo, CPA</strong><span>Serving San Francisco since 1990</span></div>
        </div>
        <div class="about-copy">
          <span class="section-kicker">Experience that adds perspective</span>
          <h2>Tax guidance shaped by real life.</h2>
          <p>James J. “Jim” Russo has been a Certified Public Accountant since 1984. He earned his MBA-taxation degree from Golden Gate University that same year, founded his San Francisco accounting practice in 1990, and acquired a Marin County firm in 2004.</p>
          <p>Jim’s advice is informed by firsthand experience as a small-business owner, homeowner, investor, trustee, landlord, property manager, and problem solver. That perspective helps him explain the tax impact of a decision in practical, understandable terms.</p>
          <a class="text-action" href="#contact">Start a conversation with Jim<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="services" id="services">
      <div class="container">
        <div class="section-heading">
          <span class="section-kicker">Our services</span>
          <h2>Tax support for today—and the decisions ahead.</h2>
          <p>Careful preparation is the foundation. Year-round planning helps you understand the choices, deadlines, and tax consequences before they become urgent.</p>
        </div>
        <div class="pillar-links">
          {pillars.map((pillar) => <a href={pillar.path}><span>Service pillar</span><h3>{pillar.name}</h3><p>{pillar.summary}</p><strong>Explore pillar<i class="ph ph-arrow-up-right" aria-hidden="true"></i></strong></a>)}
        </div>
        <div class="service-grid">
          {featuredServices.map((service, index) => (
            <a class="service-card" href={service.path}>
              <span class="service-icon"><i class={`ph ${serviceIcons[index]}`} aria-hidden="true"></i></span>
              <h3>{service.name}</h3>
              <p>{service.summary}</p>
              <span class="card-link">Learn more<i class="ph ph-arrow-up-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
        <div class="more-services">
          <span>Also available</span>
          {services.slice(4).map((service) => <a href={service.path}>{service.name}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}
        </div>
      </div>
    </section>

    <section class="clients" id="who-we-help">
      <div class="container">
        <div class="section-heading clients-heading">
          <span class="section-kicker">Who Jim serves</span>
          <h2>Experience matched to your situation.</h2>
          <p>Jim works with clients whose tax lives often extend beyond a straightforward annual return—people managing businesses, property, higher incomes, equity compensation, retirement income, and meaningful financial transitions.</p>
        </div>
        <div class="client-grid">
          {clientGroups.map((client) => (
            <a class="client-card" href={client.href}>
              <img src={client.image} alt={client.alt} width="1448" height="1086" loading="lazy" decoding="async" />
              <div><h3>{client.title}</h3><p>{client.description}</p><strong>Explore guidance<i class="ph ph-arrow-up-right" aria-hidden="true"></i></strong></div>
            </a>
          ))}
        </div>
        <a class="clients-action" href="/who-we-help/">See everyone Jim helps<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>

    <section class="milestones">
      <div class="container">
        <div class="section-heading milestones-heading">
          <span class="section-kicker">A record built over time</span>
          <h2>Established experience. Personal attention.</h2>
          <p>Jim’s practice combines formal tax education, decades of hands-on work, and the direct accountability of working with the CPA whose name is on the door.</p>
        </div>
        <div class="milestone-grid">
          {milestones.map((milestone) => (
            <article><strong>{milestone.year}</strong><h3>{milestone.title}</h3><p>{milestone.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="credentials" id="areas-served">
      <div class="container credentials-inner">
        <div class="credentials-heading">
          <span class="section-kicker">Credentials &amp; reach</span>
          <h2>Trusted locally. Prepared for complex tax lives.</h2>
        </div>
        <div class="credential-grid">
          <article class="logo-credential"><img src="/brand/cpa-logo.png" alt="CPA" width="168" height="82" /><p>Certified Public Accountant since 1984</p></article>
          <article><i class="ph ph-student" aria-hidden="true"></i><strong>Golden Gate University</strong><p>MBA–Taxation, earned in 1984</p></article>
          <article><i class="ph ph-buildings" aria-hidden="true"></i><strong>Bay Area practice</strong><p>Primarily San Francisco, Marin, and San Mateo Counties, with select clients in Santa Clara, Alameda, and Contra Costa Counties</p></article>
          <article class="logo-credential"><img src="/brand/trusted-adviser.png" alt="Your trusted adviser" width="256" height="38" /><p>Direct guidance from a seasoned, independent CPA</p></article>
        </div>
      </div>
    </section>

    <section class="home-map" aria-labelledby="home-map-heading">
      <div class="home-map-inner container">
        <div class="home-map-copy">
          <span class="section-kicker">Middle Sunset practice</span>
          <h2 id="home-map-heading">Local to San Francisco. Available across the Bay Area.</h2>
          <p>Jim’s practice is based in Middle Sunset and primarily serves San Francisco, Marin, and San Mateo Counties, with select clients elsewhere in the Bay Area. Meetings are arranged by appointment, and the street address is kept private.</p>
          <a class="map-action" href={site.mapSearchUrl} target="_blank" rel="noreferrer">
            View Middle Sunset on Google Maps<i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="home-map-frame">
          <iframe
            title="Google Map of Middle Sunset, San Francisco"
            src={site.mapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="contact-inner container">
        <div class="contact-copy">
          <span class="section-kicker">Have a tax question?</span>
          <h2>Ask Jim.</h2>
          <p>Start with the situation, the deadline, and what you want to understand. You do not need to diagnose the exact service before reaching out.</p>
          <div class="direct-contact">
            <a href={contact.href}><i class="ph ph-phone" aria-hidden="true"></i><span>Call Jim<strong>{site.phone}</strong></span></a>
            <a href={`mailto:${site.email}`}><i class="ph ph-envelope-simple" aria-hidden="true"></i><span>Email Jim<strong>{site.email}</strong></span></a>
          </div>
        </div>
        <HomepageContactForm />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .reference-home { color: #111826; background: #fff; }
  .reference-home h1, .reference-home h2, .reference-home h3 { font-family: var(--display); font-weight: 500; letter-spacing: -0.04em; text-align: left; text-wrap: balance; }
  .reference-home h2 { font-size: clamp(2.45rem, 4vw, 4rem); line-height: 1.02; }
  .section-kicker { display: block; margin-bottom: 12px; color: var(--brand); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

  .hero { padding: 58px 0 64px; color: #fffdf6; background: linear-gradient(135deg, #145986 0%, #0d4168 100%); }
  .hero-inner { width: min(1320px, calc(100% - 64px)); display: grid; grid-template-columns: minmax(0, 0.93fr) minmax(480px, 0.9fr); align-items: center; gap: clamp(58px, 7vw, 112px); }
  .hero-kicker { display: block; color: color-mix(in srgb, #fff 75%, transparent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .hero h1 { max-width: 700px; margin-top: 18px; font-size: clamp(3.25rem, 4.35vw, 4.6rem); line-height: 0.98; }
  .hero-copy > p { max-width: 680px; margin-top: 20px; color: color-mix(in srgb, #fff 82%, transparent); font-size: 1rem; line-height: 1.68; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .primary-action, .secondary-action { display: inline-flex; min-height: 54px; align-items: center; justify-content: center; gap: 9px; padding: 0 25px; border: 2px solid transparent; border-radius: 9px; font-size: 0.87rem; font-weight: 700; text-decoration: none; transition: transform 180ms var(--ease-out), background 180ms var(--ease-out), color 180ms var(--ease-out), border-color 180ms var(--ease-out); }
  .primary-action { color: #123c5b; background: #f5cf73; border-color: #f5cf73; box-shadow: 0 12px 26px rgba(3, 27, 48, 0.28); }
  .secondary-action { color: #123c5b; background: #fffdf6; border-color: #fffdf6; box-shadow: 0 10px 22px rgba(3, 27, 48, 0.16); }
  .primary-action:hover, .secondary-action:hover { transform: translateY(-2px); }
  .primary-action:hover { color: #123c5b; background: #ffe09a; border-color: #ffe09a; }
  .secondary-action:hover { color: #123c5b; background: #e9f4fb; border-color: #e9f4fb; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 20px 34px; margin-top: 27px; padding-top: 21px; border-top: 1px solid rgba(255,255,255,0.18); }
  .hero-proof span { display: grid; gap: 2px; color: color-mix(in srgb, #fff 66%, transparent); font-size: 0.75rem; }
  .hero-proof strong { color: #fff; font-size: 1.08rem; }
  .hero-visual { position: relative; padding: 18px; border-radius: 12px; background: #fff; box-shadow: 0 22px 46px rgba(0,0,0,0.2); }
  .hero-visual > img { aspect-ratio: 4 / 3; border-radius: 8px; object-fit: cover; }
  .hero-card { position: absolute; display: flex; align-items: center; gap: 11px; min-width: 205px; padding: 14px 16px; border-radius: 10px; color: #111826; background: #fff; box-shadow: 0 12px 30px rgba(5,22,39,0.2); font-size: 0.78rem; line-height: 1.35; }
  .hero-card i { color: var(--brand); font-size: 1.5rem; }
  .hero-card strong { font-size: 0.92rem; }
  .credential-card { top: -28px; right: -26px; }
  .location-card { bottom: -28px; left: -28px; }

  .trust-strip { border-bottom: 1px solid #dce5eb; background: #f6f9fb; }
  .trust-grid { width: min(1320px, calc(100% - 64px)); display: grid; grid-template-columns: repeat(4, 1fr); }
  .trust-grid > div { min-height: 118px; display: grid; align-content: center; gap: 4px; padding: 20px 28px; border-right: 1px solid #dce5eb; }
  .trust-grid > div:first-child { border-left: 1px solid #dce5eb; }
  .trust-grid strong { color: var(--brand-dark); font-size: 1.04rem; }
  .trust-grid span { color: #617180; font-size: 0.8rem; }

  .about { padding: 112px 0; }
  .about-inner { display: grid; grid-template-columns: minmax(420px, 0.95fr) minmax(0, 1fr); align-items: center; gap: clamp(68px, 9vw, 132px); }
  .about-image { position: relative; }
  .about-image img { aspect-ratio: 3 / 4; border-radius: 10px; object-fit: cover; object-position: center 16%; }
  .about-badge { position: absolute; right: -26px; bottom: -28px; display: grid; gap: 3px; padding: 18px 22px; border-radius: 9px; color: #fff; background: var(--brand); box-shadow: 0 12px 28px rgba(17,104,173,0.25); }
  .about-badge strong { font-size: 1.05rem; }
  .about-badge span { font-size: 0.75rem; }
  .about-copy p { max-width: 680px; margin-top: 21px; color: #5f6c78; line-height: 1.75; }
  .text-action { display: inline-flex; min-height: 46px; align-items: center; gap: 8px; margin-top: 24px; color: var(--brand); font-size: 0.86rem; font-weight: 700; text-decoration: none; }

  .services { padding: 104px 0 112px; background: #f5f8fa; }
  .section-heading { max-width: 780px; }
  .section-heading > p { max-width: 720px; margin-top: 18px; color: #5f6c78; line-height: 1.72; }
  .pillar-links { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 40px; }
  .pillar-links a { position: relative; min-height: 245px; display: flex; flex-direction: column; padding: 28px; overflow: hidden; border: 1px solid transparent; border-radius: 11px; color: #fff; background: var(--brand-dark); text-decoration: none; transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out), border-color 220ms var(--ease-out), background 220ms var(--ease-out); }
  .pillar-links a::after { content: ""; position: absolute; inset: auto -12% -58% auto; width: 220px; height: 170px; border-radius: 50%; background: rgba(255,255,255,0.1); filter: blur(28px); opacity: 0; transform: translate(18px, 18px); transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out); pointer-events: none; }
  .pillar-links a:hover, .pillar-links a:focus-visible { transform: translateY(-6px); border-color: rgba(255,255,255,0.28); background: #185f90; box-shadow: 0 18px 34px rgba(11,52,82,0.22); }
  .pillar-links a:hover::after, .pillar-links a:focus-visible::after { opacity: 1; transform: translate(0, 0); }
  .pillar-links a:active { transform: translateY(-2px); }
  .pillar-links span { color: color-mix(in srgb, #fff 68%, transparent); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .pillar-links h3 { margin-top: 30px; font-size: 2rem; }
  .pillar-links p { margin-top: 12px; color: color-mix(in srgb, #fff 74%, transparent); font-size: 0.9rem; line-height: 1.62; }
  .pillar-links strong { position: relative; z-index: 1; display: flex; align-items: center; gap: 7px; margin-top: auto; padding-top: 22px; font: 700 0.8rem/1 var(--sans); }
  .pillar-links strong i { transition: transform 220ms var(--ease-out); }
  .pillar-links a:hover strong i, .pillar-links a:focus-visible strong i { transform: translate(3px, -3px); }
  .service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 42px; }
  .service-card { min-height: 330px; display: flex; flex-direction: column; align-items: flex-start; padding: 30px 27px; border: 1px solid color-mix(in srgb, var(--brand) 34%, #dce5eb); border-radius: 11px; color: #111826; background: #fff; text-decoration: none; transition: transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out), border-color 180ms var(--ease-out); }
  .service-card:hover { transform: translateY(-4px); border-color: var(--brand); box-shadow: 0 15px 32px rgba(16,45,66,0.09); }
  .service-icon { display: grid; width: 66px; height: 66px; place-items: center; border-radius: 10px; color: #fff; background: var(--brand); box-shadow: 0 6px 14px rgba(17,104,173,0.2); }
  .service-icon i { font-size: 2rem; }
  .service-card h3 { margin-top: 24px; font-size: 1.35rem; line-height: 1.15; }
  .service-card p { margin-top: 12px; color: #667581; font-size: 0.9rem; line-height: 1.62; }
  .card-link { display: inline-flex; align-items: center; gap: 7px; margin-top: auto; padding-top: 24px; color: var(--brand); font-size: 0.81rem; font-weight: 700; }
  .more-services { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-top: 30px; }
  .more-services > span { color: #76838d; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .more-services a { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); font-size: 0.86rem; font-weight: 700; text-decoration: none; }

  .clients { padding: 108px 0 116px; }
  .clients-heading { max-width: 850px; }
  .client-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; margin-top: 43px; }
  .client-card { grid-column: span 2; overflow: hidden; border-radius: 11px; color: #111826; background: #fff; box-shadow: 0 10px 28px rgba(16,45,66,0.1); text-decoration: none; transition: transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out); }
  .client-card:nth-child(4), .client-card:nth-child(5) { grid-column: span 3; }
  .client-card:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(16,45,66,0.14); }
  .client-card img { aspect-ratio: 4 / 3; object-fit: cover; }
  .client-card > div { min-height: 245px; padding: 24px; }
  .client-card h3 { font-size: 1.26rem; line-height: 1.15; }
  .client-card p { margin-top: 12px; color: #64727e; font-size: 0.88rem; line-height: 1.62; }
  .client-card strong { display: inline-flex; align-items: center; gap: 7px; margin-top: 18px; color: var(--brand); font-size: 0.8rem; }
  .clients-action { display: inline-flex; min-height: 48px; align-items: center; gap: 8px; margin-top: 28px; color: var(--brand); font-size: 0.86rem; font-weight: 700; text-decoration: none; }

  .milestones { padding: 104px 0 112px; background: linear-gradient(110deg, #eef8f7 0%, #fff8e8 100%); }
  .milestones-heading { max-width: 800px; }
  .milestone-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 42px; }
  .milestone-grid article { min-height: 310px; padding: 32px; border-radius: 11px; background: rgba(255,255,255,0.92); box-shadow: 0 10px 28px rgba(16,45,66,0.08); }
  .milestone-grid article > strong { color: var(--brand); font-size: 2.65rem; letter-spacing: -0.05em; }
  .milestone-grid h3 { margin-top: 34px; font-size: 1.35rem; }
  .milestone-grid p { margin-top: 13px; color: #62717d; font-size: 0.9rem; line-height: 1.65; }

  .credentials { padding: 96px 0 104px; background: #f5f8fa; }
  .credentials-heading { max-width: 800px; }
  .credential-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 38px; }
  .credential-grid article { min-height: 215px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 28px; border: 1px solid #d9e4eb; border-radius: 10px; background: #fff; }
  .credential-grid article > i { color: var(--brand); font-size: 2.3rem; }
  .credential-grid article > strong { margin-top: 18px; font-size: 1.05rem; }
  .credential-grid p { margin-top: 10px; color: #65737e; font-size: 0.84rem; line-height: 1.55; }
  .logo-credential img { width: auto; max-width: 170px; height: 48px; object-fit: contain; background: transparent; }

  .home-map { padding: 104px 0; background: #fff; }
  .home-map-inner { display: grid; grid-template-columns: minmax(300px, 0.72fr) minmax(500px, 1fr); align-items: center; gap: clamp(54px, 8vw, 110px); }
  .home-map-copy > p { max-width: 590px; margin-top: 21px; color: #5f6c78; line-height: 1.72; }
  .map-action { display: inline-flex; min-height: 48px; align-items: center; gap: 8px; margin-top: 25px; color: var(--brand); font-size: 0.86rem; font-weight: 700; text-decoration: none; }
