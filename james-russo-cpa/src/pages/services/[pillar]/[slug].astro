---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import HomepageContactForm from "../../../components/HomepageContactForm.astro";
import { contact, getServices, site } from "../../../data/site";

export function getStaticPaths() {
  return getServices().map((service) => ({ params: { pillar: service.pillarSlug, slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const services = getServices();
const relatedServices = services.filter((item) => item.slug !== service.slug && item.pillarSlug === service.pillarSlug);
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: service.pillarName, href: `/services/${service.pillarSlug}/` },
  { label: service.name }
];
const businessId = site.siteUrl ? `${site.siteUrl}/#business` : "#business";
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": site.siteUrl ? `${site.siteUrl}${service.path}#service` : `${service.path}#service`,
  serviceType: service.name,
  name: service.name,
  description: service.summary,
  provider: { "@id": businessId },
  url: site.siteUrl ? `${site.siteUrl}${service.path}` : service.path
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } }))
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: site.siteUrl ? `${site.siteUrl}${item.href || service.path}` : item.href || service.path
  }))
};
---

<BaseLayout title={`${service.name} Near You | ${site.businessName}`} description={`${service.summary} Direct, plain-language guidance from James J. Russo, CPA.`} schemas={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <Header />
  <main>
    <Breadcrumbs items={breadcrumbItems} />
    <section class="service-hero">
      <div class="service-hero-inner container">
        <div class="service-copy">
          <span class="eyebrow">{service.name} near you</span>
          <h1>{service.headline}</h1>
          <p>{service.intro}</p>
          <div class="hero-actions"><a class="button light" href="/contact/">Contact Jim</a><a class="hero-call" href={contact.href}><i class="ph ph-phone" aria-hidden="true"></i>{site.phone}</a></div>
          <div class="hero-credentials" aria-label="Professional credentials">
            <div><strong>35+</strong><span>years in practice</span></div>
            <div><strong>CPA</strong><span>since 1984</span></div>
            <div><strong>MBA–Taxation</strong><span>Golden Gate University</span></div>
          </div>
        </div>
        <HomepageContactForm />
      </div>
    </section>

    <section class="service-overview container">
      <div><span class="eyebrow">How Jim can help</span><h2 class="section-title">A clear scope and useful answers.</h2></div>
      <div><p>{service.summary}</p><p>Jim starts with the decision or filing need, then identifies the records, timing, and work required. You receive direct explanations and practical next steps tailored to your situation.</p></div>
    </section>

    <section class="strategies">
      <div class="container">
        <span class="eyebrow">What the work can address</span>
        <h2 class="section-title">Built around the decisions behind the numbers.</h2>
        <div class="strategy-grid">{service.strategies.map((strategy, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{strategy.title}</h3><p>{strategy.body}</p></article>)}</div>
      </div>
    </section>

    <section class="outcomes container">
      <div><span class="eyebrow">Common outcomes</span><h2 class="section-title">What a well-scoped engagement can provide.</h2><p>{service.fit}</p></div>
      <div class="outcome-grid">{service.outcomes.map((outcome) => <article><i class="ph ph-check-circle" aria-hidden="true"></i><h3>{outcome}</h3></article>)}</div>
    </section>

    <section class="where-offered">
      <div class="where-inner container">
        <div>
          <span class="eyebrow">Where Jim works</span>
          <h2 class="section-title">Based in Middle Sunset. Serving San Francisco.</h2>
          <p>Jim works with clients throughout San Francisco from his Middle Sunset practice. Meetings are by appointment, and remote options can be discussed when you get in touch.</p>
          <div class="where-actions"><a class="button" href="/contact/">Contact Jim</a><a class="local-service-link" href={service.homeTurfPath}>View {service.name.toLowerCase()} in San Francisco<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
        </div>
        <iframe title="Google Map of Middle Sunset, San Francisco" src={site.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <section class="service-faq">
      <div class="service-faq-inner container">
        <div><span class="eyebrow">Questions about {service.name}</span><h2 class="section-title">What clients often ask first.</h2></div>
        <div class="faq-list">{service.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.q}<i class="ph ph-plus" aria-hidden="true"></i></summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <section class="related container">
      <div><span class="eyebrow">More from {service.pillarName}</span><h2 class="section-title">Related services.</h2></div>
      <div class="related-grid">
        <a class="pillar-link" href={`/services/${service.pillarSlug}/`}><span>Service category</span><h3>{service.pillarName}</h3><p>View the full group of related services.</p></a>
        {relatedServices.map((item) => <a href={item.path}><span>Related service</span><h3>{item.name}</h3><p>{item.summary}</p></a>)}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .service-hero { padding: 72px 0 82px; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .service-hero-inner { display: grid; grid-template-columns: minmax(0, 0.88fr) minmax(440px, 0.8fr); align-items: stretch; gap: clamp(54px, 8vw, 110px); }
  .service-copy { display: flex; flex-direction: column; padding-top: 26px; }
  .service-hero .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); text-transform: uppercase; }
  .service-hero h1 { max-width: 700px; margin-top: 18px; font-size: clamp(3.25rem, 4.35vw, 4.6rem); line-height: 0.98; }
  .service-hero p { max-width: 670px; margin-top: 24px; color: color-mix(in srgb, var(--brand-dark-contrast) 80%, transparent); font-size: 1.05rem; line-height: 1.72; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 27px; }
  .hero-call { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; text-decoration: none; }
  .hero-credentials { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: auto; padding-top: 48px; }
  .hero-credentials > div { padding-top: 17px; border-top: 1px solid rgba(255,255,255,0.22); }
  .hero-credentials strong { display: block; font: 500 1.45rem/1 var(--display); letter-spacing: -0.02em; }
  .hero-credentials span { display: block; margin-top: 7px; color: color-mix(in srgb, var(--brand-dark-contrast) 68%, transparent); font-size: 0.74rem; line-height: 1.35; }
  .service-hero :global(.homepage-contact-form) { color: var(--ink); background: var(--white); box-shadow: 0 18px 42px rgba(0,0,0,0.18); }
  .service-overview .eyebrow, .strategies .eyebrow, .outcomes .eyebrow, .where-offered .eyebrow, .service-faq .eyebrow, .related .eyebrow { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .service-overview .section-title, .strategies .section-title, .outcomes .section-title, .where-offered .section-title, .service-faq .section-title, .related .section-title { font-size: clamp(2.45rem, 4vw, 4rem); line-height: 1.02; }
  .service-overview { max-width: 900px; padding-block: 104px; }
  .service-overview h2 { max-width: 760px; margin-top: 12px; }
  .service-overview > div:last-child { max-width: 760px; margin-top: 20px; }
  .service-overview p { color: var(--muted); line-height: 1.75; }
  .service-overview p + p { margin-top: 20px; }
  .strategies { padding: 98px 0 104px; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .strategies .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); }
  .strategies h2 { max-width: 760px; margin-top: 12px; }
  .strategy-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 42px; border-top: 1px solid rgba(255,255,255,0.2); border-left: 1px solid rgba(255,255,255,0.2); }
  .strategy-grid article { min-height: 280px; display: flex; flex-direction: column; padding: 28px; border-right: 1px solid rgba(255,255,255,0.2); border-bottom: 1px solid rgba(255,255,255,0.2); }
  .strategy-grid article > span { color: color-mix(in srgb, var(--brand-dark-contrast) 62%, transparent); font-size: 0.8rem; }
  .strategy-grid h3 { margin-top: 72px; font-size: 1.9rem; line-height: 1.04; }
  .strategy-grid p { margin-top: 13px; color: color-mix(in srgb, var(--brand-dark-contrast) 76%, transparent); font-size: 0.92rem; line-height: 1.66; }
  .outcomes { display: grid; grid-template-columns: 0.78fr 1fr; gap: clamp(50px, 9vw, 120px); padding-block: 104px; }
  .outcomes h2 { margin-top: 12px; }
  .outcomes > div:first-child > p { margin-top: 18px; color: var(--muted); line-height: 1.7; }
  .outcome-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .outcome-grid article { min-height: 170px; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .outcome-grid i { color: var(--brand); font-size: 1.8rem; }
  .outcome-grid h3 { margin-top: 30px; font-size: 1.4rem; line-height: 1.08; }
  .where-offered { padding: 100px 0; background: var(--cream); }
  .where-inner { display: grid; grid-template-columns: 0.78fr 1fr; gap: clamp(50px, 9vw, 120px); }
  .where-inner h2 { margin-top: 12px; }
  .where-inner > div > p { margin-top: 18px; color: var(--muted); line-height: 1.7; }
  .where-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 28px; }
  .local-service-link { display: inline-flex; align-items: center; gap: 7px; color: var(--brand); font-size: 0.84rem; font-weight: 600; line-height: 1.35; text-decoration: none; }
  .where-inner iframe { width: 100%; min-height: 410px; border: 1px solid var(--line); background: var(--white); }
  .service-faq { padding: 104px 0; background: var(--white); }
  .service-faq-inner { display: grid; grid-template-columns: minmax(280px, 0.62fr) minmax(0, 1fr); gap: clamp(55px, 9vw, 120px); }
  .service-faq h2 { margin-top: 12px; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 0; cursor: pointer; list-style: none; font: 500 1.38rem/1.16 var(--display); }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary i { color: var(--brand); transition: transform 180ms var(--ease-out); }
  .faq-list details[open] summary i { transform: rotate(45deg); }
  .faq-list p { padding: 0 42px 24px 0; color: var(--muted); line-height: 1.7; }
  .related { padding-block: 104px; }
  .related h2 { margin-top: 12px; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .related-grid a { min-height: 230px; display: flex; flex-direction: column; padding: 26px; border: 1px solid var(--line); text-decoration: none; }
  .related-grid a:hover { border-color: var(--brand); }
  .related-grid span { color: var(--brand); font-size: 0.76rem; text-transform: uppercase; }
  .related-grid h3 { margin-top: 35px; font-size: 1.65rem; }
  .related-grid p { margin-top: 12px; color: var(--muted); line-height: 1.62; }
  .pillar-link { background: var(--cream); }
  @media (max-width: 900px) { .service-hero-inner, .outcomes, .where-inner, .service-faq-inner { grid-template-columns: 1fr; } .service-copy { grid-row: 1; padding-top: 0; } .hero-credentials { margin-top: 38px; padding-top: 0; } .service-hero :global(.homepage-contact-form) { grid-row: 2; } .strategy-grid, .related-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .service-hero { padding-block: 54px 70px; } .service-hero h1 { font-size: clamp(3.2rem, 15vw, 4.5rem); } .hero-credentials { grid-template-columns: 1fr; gap: 13px; } .hero-credentials > div { display: grid; grid-template-columns: minmax(112px, auto) 1fr; align-items: baseline; gap: 12px; padding-top: 13px; } .hero-credentials span { margin-top: 0; } .service-overview, .outcomes, .service-faq, .related { padding-block: 78px; } .strategies, .where-offered { padding-block: 78px; } .outcome-grid { grid-template-columns: 1fr; } }
</style>
