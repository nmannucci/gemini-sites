---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import HomepageContactForm from "../../components/HomepageContactForm.astro";
import { contact, getAreas, getServices, site } from "../../data/site";

export function getStaticPaths() {
  return getAreas().map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const services = getServices();
const isHomeTurf = area.slug === "san-francisco-county";
const areaLabel = isHomeTurf ? "San Francisco" : area.name;
const areaMapEmbedUrl = isHomeTurf
  ? site.mapEmbedUrl
  : `https://www.google.com/maps?q=${encodeURIComponent(`${area.name}, California`)}&output=embed`;
const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Areas served", href: "/#areas-served" }, { label: area.name }];
const areaSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": site.siteUrl ? `${site.siteUrl}${area.path}#service-area` : `${area.path}#service-area`,
  name: `CPA and tax services in ${area.name}`,
  serviceType: "Tax preparation and tax planning",
  description: area.intro,
  provider: { "@id": site.siteUrl ? `${site.siteUrl}/#business` : "#business" },
  areaServed: { "@type": "AdministrativeArea", name: area.name }
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.label, item: site.siteUrl ? `${site.siteUrl}${item.href || area.path}` : item.href || area.path }))
};
---

<BaseLayout title={`CPA & Tax Services in ${area.name} | ${site.businessName}`} description={area.metaDescription} schemas={[areaSchema, breadcrumbSchema]}>
  <Header />
  <main>
    <Breadcrumbs items={breadcrumbItems} />
    <section class="area-hero">
      <div class="area-hero-inner container">
        <div class="area-copy">
          <span class="eyebrow">{area.tier}</span>
          <h1>CPA &amp; tax services in {area.name}.</h1>
          <p>{area.intro}</p>
          <div class="hero-meta"><span><i class="ph ph-map-pin" aria-hidden="true"></i>{site.address}</span><a href={contact.href}><i class="ph ph-phone" aria-hidden="true"></i>{site.phone}</a></div>
        </div>
        <HomepageContactForm />
      </div>
    </section>

    <section class="area-intro container">
      <div><span class="eyebrow">Local focus</span><h2 class="section-title">Tax guidance matched to the clients Jim serves here.</h2></div>
      <div><p>{area.focus}</p><p>Jim works directly with clients and explains the filing or planning implications in plain language. Meetings are by appointment, with remote options confirmed for each engagement.</p></div>
    </section>

    <section class="local-context">
      <div class="container local-context-inner">
        <div>
          <span class="eyebrow">Local context</span>
          <h2 class="section-title">Tax decisions shaped by life in {areaLabel}.</h2>
          <p>{area.localContext}</p>
        </div>
        <div class="landmark-grid">
          {area.landmarks.map((landmark) => <article><h3>{landmark.name}</h3><p>{landmark.detail}</p></article>)}
        </div>
      </div>
    </section>

    <section class="communities">
      <div class="container communities-inner">
        <div><span class="eyebrow">Communities in this area</span><h2 class="section-title">Serving clients across {area.name}.</h2></div>
        <div class="community-list">{area.communities.map((community) => <span>{community}</span>)}</div>
      </div>
    </section>

    <section class="area-services container">
      <div><span class="eyebrow">Services available</span><h2 class="section-title">Choose the tax issue you need help with.</h2><p>{area.serviceGuide}</p></div>
      <div class="service-list">{services.map((service) => <a href={isHomeTurf ? service.homeTurfPath : service.path}><span>{service.pillarName}</span><h3>{service.name}</h3><p>{service.summary}</p><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}</div>
    </section>

    <section class="map-section">
      <div class="map-inner container">
        <div>
          <span class="eyebrow">Serving {areaLabel}</span>
          <h2 class="section-title">Tax guidance for {areaLabel}.</h2>
          <p>{isHomeTurf
            ? "The practice is based in Middle Sunset. The street address is withheld by request and appointments are arranged directly."
            : `Jim’s office is in Middle Sunset. He serves clients in ${area.name} by appointment, with direct CPA guidance and remote options confirmed for each engagement.`}</p>
        </div>
        <iframe title={`Service area map for ${areaLabel}`} src={areaMapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <section class="firm-details container">
      <div><span class="eyebrow">Firm details</span><h2 class="section-title">Direct access when the details matter.</h2><p>Contact Jim to confirm service fit, appointment availability, and the best way to handle documents for your location.</p></div>
      <dl><div><dt>Location</dt><dd>{site.address}</dd></div><div><dt>Meetings</dt><dd>{site.hours}</dd></div><div><dt>Phone</dt><dd><a href={contact.href}>{site.phone}</a></dd></div><div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div></dl>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .area-hero { padding: 62px 0 74px; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .area-hero-inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(440px, 0.76fr); align-items: start; gap: clamp(52px, 8vw, 105px); }
  .area-copy { padding-top: 24px; }
  .area-hero .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .area-hero h1 { max-width: 700px; margin-top: 18px; font-size: clamp(3.25rem, 4.35vw, 4.6rem); line-height: 0.98; }
  .area-hero p { max-width: 680px; margin-top: 24px; color: color-mix(in srgb, var(--brand-dark-contrast) 80%, transparent); font-size: 1.04rem; line-height: 1.72; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 14px 24px; margin-top: 25px; }
  .hero-meta span, .hero-meta a { display: inline-flex; align-items: center; gap: 7px; color: color-mix(in srgb, var(--brand-dark-contrast) 82%, transparent); font-size: 0.84rem; text-decoration: none; }
  .area-hero :global(.homepage-contact-form) { color: var(--ink); background: var(--white); box-shadow: 0 18px 42px rgba(0,0,0,0.2); }
  .area-intro .eyebrow, .local-context .eyebrow, .communities .eyebrow, .area-services .eyebrow, .map-section .eyebrow, .firm-details .eyebrow { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .area-intro .section-title, .local-context .section-title, .communities .section-title, .area-services .section-title, .map-section .section-title, .firm-details .section-title { font-size: clamp(2.45rem, 4vw, 4rem); line-height: 1.02; }
  .area-intro { max-width: 900px; padding-block: 104px; }
  .area-intro h2 { max-width: 760px; margin-top: 12px; }
  .area-intro > div:last-child { max-width: 720px; margin-top: 20px; }
  .area-intro p, .firm-details p { color: var(--muted); line-height: 1.75; }
  .area-intro p + p { margin-top: 20px; }
  .local-context { padding: 100px 0; background: var(--cream); }
  .local-context-inner { display: grid; grid-template-columns: 0.78fr 1fr; gap: clamp(52px, 9vw, 120px); }
  .local-context h2 { max-width: 690px; margin-top: 12px; }
  .local-context-inner > div > p { margin-top: 18px; color: var(--muted); line-height: 1.72; }
  .landmark-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .landmark-grid article { min-height: 230px; padding: 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .landmark-grid h3 { font-size: 1.35rem; line-height: 1.08; }
  .landmark-grid p { margin-top: 13px; color: var(--muted); font-size: 0.88rem; line-height: 1.62; }
  .firm-details { display: grid; grid-template-columns: 0.82fr 1fr; gap: clamp(52px, 9vw, 120px); padding-block: 104px; }
  .firm-details h2 { margin-top: 12px; }
  .communities { padding: 90px 0; color: var(--brand-dark-contrast); background: var(--brand-dark); }
  .communities-inner { display: grid; grid-template-columns: 0.82fr 1fr; gap: clamp(52px, 9vw, 120px); }
  .communities .eyebrow { color: color-mix(in srgb, var(--brand-dark-contrast) 72%, transparent); }
  .communities h2 { margin-top: 12px; }
  .community-list { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(255,255,255,0.2); }
  .community-list span { padding: 18px 4px; border-bottom: 1px solid rgba(255,255,255,0.2); color: color-mix(in srgb, var(--brand-dark-contrast) 80%, transparent); }
  .area-services { display: grid; grid-template-columns: 0.66fr 1.34fr; gap: clamp(52px, 8vw, 100px); padding-block: 104px; }
  .area-services h2 { margin-top: 12px; }
  .area-services > div:first-child p { margin-top: 18px; color: var(--muted); line-height: 1.7; }
  .service-list { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .service-list a { position: relative; min-height: 245px; padding: 24px 48px 24px 24px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .service-list a:hover { border-color: var(--brand); }
  .service-list span { color: var(--brand); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
  .service-list h3 { margin-top: 28px; font-size: 1.45rem; }
  .service-list p { margin-top: 12px; color: var(--muted); font-size: 0.88rem; line-height: 1.62; }
  .service-list i { position: absolute; top: 24px; right: 24px; color: var(--brand); }
  .map-section { padding: 100px 0; background: var(--cream); }
  .map-inner { display: grid; grid-template-columns: 0.72fr 1fr; gap: clamp(52px, 8vw, 100px); }
  .map-inner h2 { margin-top: 12px; }
  .map-inner p { margin-top: 18px; color: var(--muted); line-height: 1.72; }
  .map-inner iframe { width: 100%; min-height: 400px; border: 0; }
  .firm-details p { max-width: 600px; margin-top: 18px; }
  .firm-details dl { margin: 0; border-top: 1px solid var(--line); }
  .firm-details dl > div { display: grid; grid-template-columns: 110px 1fr; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .firm-details dt { color: var(--brand); font-size: 0.78rem; text-transform: uppercase; }
  .firm-details dd { margin: 0; color: var(--muted); }
  .firm-details a { color: var(--ink); text-decoration: none; }
  @media (max-width: 900px) { .area-hero-inner, .local-context-inner, .communities-inner, .area-services, .map-inner, .firm-details { grid-template-columns: 1fr; } .area-copy { grid-row: 1; padding-top: 0; } .area-hero :global(.homepage-contact-form) { grid-row: 2; } .landmark-grid { grid-template-columns: 1fr; } .landmark-grid article { min-height: 0; } }
  @media (max-width: 620px) { .area-hero { padding-block: 48px 68px; } .area-hero h1 { font-size: clamp(3.2rem, 15vw, 4.5rem); } .area-intro, .area-services, .firm-details { padding-block: 78px; } .local-context, .communities, .map-section { padding-block: 78px; } .community-list, .service-list { grid-template-columns: 1fr; } .firm-details dl > div { grid-template-columns: 1fr; gap: 6px; } }
</style>
