---
import { site } from "../data/site";

const { title = `${site.businessName} | Baseball Training in Columbus, GA`, description = `Professional baseball training, academy programs, and player development for student-athletes across ${site.serviceArea}.` } = Astro.props;

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="${site.primaryColor}"/><text x="32" y="43" font-family="Arial, Helvetica, sans-serif" font-size="${site.logoText.length > 2 ? 20 : 26}" font-weight="bold" fill="#ffffff" text-anchor="middle">${site.logoText}</text></svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {site.demoMode && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.businessName} />
    {site.siteUrl && <meta property="og:url" content={`${site.siteUrl}${Astro.url.pathname}`} />}
    {site.siteUrl && <meta property="og:image" content={`${site.siteUrl}/assets/tcg-hero.jpg`} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,800&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --primary: #123c7c;
        --ink: #11110f;
        --muted: #686255;
        --line: #ded8ca;
        --surface: #f4efe3;
        --white: #fffdf8;
        --shadow: 0 28px 90px rgba(8, 8, 6, 0.22);
        --eyebrow-heading-gap: 18px;
        --eyebrow-padding-block: 0px;
        --eyebrow-padding-inline: 12px;
      }

      html { scroll-behavior: smooth; }
      body {
        --primary-dark: #090907;
        --primary-soft: color-mix(in srgb, var(--primary) 16%, #fffdf8);
        margin: 0;
        color: var(--ink);
        background: var(--surface);
        font-family: "IBM Plex Sans", ui-sans-serif, sans-serif;
        overflow-x: hidden;
      }

      img { display: block; max-width: 100%; }
      a { color: inherit; }

      h1, h2, h3 {
        margin: 0;
        font-family: "Barlow Condensed", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
        font-weight: 900;
        letter-spacing: -0.02em;
        text-wrap: balance;
        text-transform: uppercase;
      }

      p {
        margin: 0;
        text-wrap: pretty;
      }

      :focus-visible {
        outline: 3px solid var(--primary);
        outline-offset: 4px;
      }

      .container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: var(--eyebrow-padding-block) var(--eyebrow-padding-inline);
        border-radius: 4px;
        background: var(--primary);
        color: #090907;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .eyebrow + :is(h1, h2, h3) {
        margin-top: var(--eyebrow-heading-gap);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 22px;
        border-radius: 2px;
        border: 0;
        background: var(--primary);
        color: #090907;
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      }

      .button:hover,
      .button:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.18);
      }

      ::selection {
        background: var(--primary);
        color: #090907;
      }

      .button.secondary {
        background: var(--white);
        color: var(--primary-dark);
      }

      section { scroll-margin-top: 86px; }

      .section-head {
        display: grid;
        gap: 16px;
        margin-bottom: 42px;
      }

      .section-head h2 {
        max-width: 760px;
        font-size: clamp(2rem, 3.7vw, 3.65rem);
        line-height: 0.94;
      }

      .section-head p {
        max-width: 620px;
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.7;
      }

      @media (max-width: 820px) {
        .container { width: min(100% - 28px, 1180px); }
      }

      @media (max-width: 560px) {
        :root {
          --eyebrow-padding-block: 8px;
          --eyebrow-padding-inline: 16px;
        }

        .eyebrow {
          min-height: 0;
          line-height: 1.25;
        }

        .section-head h2 {
          font-size: clamp(2.55rem, 12vw, 3.05rem);
          line-height: 0.94;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }

        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body style={`--primary: ${site.primaryColor};`}>
    <slot />
  </body>
</html>
