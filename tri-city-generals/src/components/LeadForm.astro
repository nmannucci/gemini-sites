---
import { contact, getServices, site } from "../data/site";

const { title = "Request training info", intro = "Tell us a little about your player and the best way to reach you." } = Astro.props;
const services = getServices();
const hasEndpoint = Boolean(site.formEndpoint);
---
<form
  class="lead-form"
  action={hasEndpoint ? site.formEndpoint : "#"}
  method="POST"
  data-endpoint={site.formEndpoint}
  data-contact-label={contact.label}
>
  <h2>{title}</h2>
  <p>{intro}</p>
  <input type="hidden" name="source" value="house36-site" />
  <input type="hidden" name="business" value={site.businessName} />
  <div class="form-grid">
    <label>
      <span>First name <em>Required</em></span>
      <input name="first_name" autocomplete="given-name" required />
    </label>
    <label>
      <span>Last name <em>Optional</em></span>
      <input name="last_name" autocomplete="family-name" />
    </label>
    <label class="full">
      <span>Email <em>Email or phone required</em></span>
      <input name="email" type="email" autocomplete="email" />
    </label>
    <label class="full">
      <span>Phone <em>Email or phone required</em></span>
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </label>
    <label class="full">
      <span>Training interest <em>Required</em></span>
      <select name="program_interest" required>
        <option value="" disabled selected>Select a program</option>
        <option value="Not sure — help me choose">Not sure — help me choose</option>
        {services.map((service) => <option value={service.name}>{service.name}</option>)}
      </select>
    </label>
    <label class="full message">
      <span>Player goals <em>Optional</em></span>
      <textarea name="message"></textarea>
    </label>
  </div>
  <button type="submit">Send request</button>
  <p class="form-status" role="status" aria-live="polite" data-state="idle"></p>
  <small>By submitting, you agree to be contacted about this request. Your details are used only to respond.</small>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form.lead-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const status = form.querySelector<HTMLElement>(".form-status");
      const email = form.querySelector<HTMLInputElement>('input[name="email"]');
      const phone = form.querySelector<HTMLInputElement>('input[name="phone"]');
      const endpoint = form.dataset.endpoint;
      if (!button || !status || !email || !phone) return;

      const hasContactMethod = Boolean(email.value.trim() || phone.value.trim());
      email.setCustomValidity(hasContactMethod ? "" : "Enter an email or phone number.");

      if (!form.checkValidity()) {
        status.dataset.state = "error";
        status.textContent = "Please complete the required fields and add an email or phone number.";
        form.reportValidity();
        return;
      }

      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        payload[key] = String(value);
      });
      payload.page = window.location.href;
      payload.submitted_at = new Date().toISOString();

      button.disabled = true;
      button.textContent = "Sending…";
      status.dataset.state = "idle";
      status.textContent = "";

      try {
        if (endpoint) {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
        }
        form.reset();
        button.disabled = false;
        button.textContent = "Send another request";
        status.dataset.state = "success";
        status.textContent = "Thanks — your request is in. The academy can follow up with the best next step.";
      } catch {
        button.disabled = false;
        button.textContent = "Send request";
        status.dataset.state = "error";
        status.textContent = `Your request could not be sent. Please try again or use ${form.dataset.contactLabel} instead.`;
      }
    });

    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea").forEach((field) => {
      field.addEventListener("input", () => {
        const email = form.querySelector<HTMLInputElement>('input[name="email"]');
        const phone = form.querySelector<HTMLInputElement>('input[name="phone"]');
        if (email && phone && (email.value.trim() || phone.value.trim())) {
          email.setCustomValidity("");
        }
        if (status.dataset.state === "error") {
          status.dataset.state = "idle";
          status.textContent = "";
        }
      });
    });
  });
</script>

<style>
  .lead-form {
    padding: 28px;
    border-radius: 2px;
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.55rem);
    line-height: 0.95;
  }

  p {
    margin-top: 12px;
    color: var(--muted);
    line-height: 1.6;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
  }

  label {
    display: grid;
    gap: 7px;
  }

  .full { grid-column: 1 / -1; }

  span {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  span em {
    color: var(--muted);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0 12px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--primary);
    outline: 3px solid var(--primary-soft);
    outline-offset: 1px;
  }

  textarea {
    min-height: 92px;
    padding-top: 12px;
    resize: vertical;
  }

  button {
    width: 100%;
    min-height: 52px;
    margin-top: 16px;
    border: 0;
    border-radius: 6px;
    background: var(--primary);
    color: #090907;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.75;
    cursor: default;
  }

  .form-status {
    margin-top: 12px;
    font-weight: 700;
    line-height: 1.5;
  }

  .form-status[data-state="success"] { color: #276134; }
  .form-status[data-state="error"] { color: #9f241d; }

  .form-status:empty {
    display: none;
  }

  small {
    display: block;
    margin-top: 12px;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 520px) {
    .form-grid { grid-template-columns: 1fr; }
  }
</style>
