---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import LeadForm from "../components/LeadForm.astro";
import { defaultImages, getAreas, getFaqs, getServices, site } from "../data/site";

const services = getServices();
const areas = getAreas();
const faqs = getFaqs();
const mapQuery = encodeURIComponent(site.address);
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero">
      <div class="hero-bg">
        <img src={defaultImages.hero} alt="Tri-City Generals athlete training inside the Columbus facility" loading="eager" />
      </div>
      <div class="hero-inner container">
        <div class="hero-copy">
          <span class="eyebrow">Columbus, GA baseball development</span>
          <h1>Train harder.<br />Play prepared.</h1>
          <p>{site.businessName} builds skilled, resilient student-athletes through professional instruction, demanding reps, and a standard that carries beyond the field.</p>
          <div class="hero-actions">
            <a class="button secondary" href="#programs">Find the right program</a>
            <a class="button outline" href={site.registrationUrl} target="_blank" rel="noopener">View current sessions</a>
          </div>
        </div>
      </div>
    </section>

    <section class="quick-proof" aria-label="Summer academy details">
      <div class="proof-item"><strong>Ages 9+</strong><span>2026 summer academy</span></div>
      <div class="proof-item">
        <strong>May 26–Jul 15</strong>
        <span>Summer 2026 session</span>
      </div>
      <div class="proof-item">
        <strong>Monday–Thursday</strong>
        <span>Morning through evening</span>
      </div>
      <div class="proof-item">
        <strong>Columbus, GA</strong>
        <span>In-person facility training</span>
      </div>
    </section>

    <section class="trust container" aria-labelledby="trust-heading">
      <div class="trust-intro">
        <p>What families can expect</p>
        <h2 id="trust-heading">A standard players can carry beyond the field.</h2>
      </div>
      <div class="trust-principles">
        <article>
          <h3>Skill with purpose</h3>
          <p>Every drill connects to a game demand, a physical quality, or a clear next step for the player.</p>
        </article>
        <article>
          <h3>Habits that hold</h3>
          <p>Productive work is repeated with consistency so progress does not depend on a single good session.</p>
        </article>
        <article>
          <h3>Ownership</h3>
          <p>Players are expected to understand the work, respond to coaching, and own their preparation.</p>
        </article>
      </div>
    </section>

    <section class="programs container" id="programs">
      <div class="section-head">
        <h2>Programs built for players ready to work</h2>
        <p>Choose a complete academy experience or a focused path for the skill, position, and physical qualities your athlete needs next.</p>
      </div>
      <div class="program-grid">
        {services.map((service) => (
          <a class="program-card" href={`/services/${service.slug}/`}>
            <img src={service.image} alt={`${service.name} for youth baseball players`} loading="lazy" />
            <div>
              <h3>{service.name}</h3>
              <p>{service.summary}</p>
              <span class="card-link">Learn more <b aria-hidden="true">↗</b></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="training-split" id="training">
      <div class="training-copy">
        <span class="eyebrow">The Generals standard</span>
        <h2>More than reps. A standard players carry with them.</h2>
        <p>Tri-City Generals combines sport-specific instruction with mentorship, conditioning, and a value-based culture built around resilience, discipline, and organization.</p>
        <ul>
          <li>Professional, detail-driven skill instruction</li>
          <li>Mobility, strength, and conditioning built into development</li>
          <li>Accountability on the field, at home, and in the classroom</li>
          <li>Programs for baseball, softball, football, track, and other sports</li>
        </ul>
      </div>
      <img src={defaultImages.fielding} alt="Youth baseball players learning fielding fundamentals" loading="lazy" />
    </section>

    <section class="photo-gallery" id="gallery" aria-labelledby="gallery-heading">
      <div class="gallery-head container">
        <h2 id="gallery-heading">The work. The team. The standard.</h2>
        <p>A closer look at the athletes, training environment, and competitive culture behind Tri-City Generals.</p>
      </div>
      <div class="gallery-grid container">
        <figure class="gallery-photo gallery-photo-1">
          <img src="/assets/tcg-gallery-01.jpg" alt="Tri-City Generals championship trophy" loading="lazy" />
          <figcaption>Earned, not given</figcaption>
        </figure>
        <figure class="gallery-photo gallery-photo-2">
          <img src="/assets/tcg-gallery-02.jpg" alt="Tri-City Generals athletes gathered inside the academy" loading="lazy" />
          <figcaption>Train harder, together</figcaption>
        </figure>
        <figure class="gallery-photo gallery-photo-3">
          <img src="/assets/tcg-gallery-03.jpg" alt="Tri-City Generals championship rings on display" loading="lazy" />
          <figcaption>A standard with history</figcaption>
        </figure>
        <figure class="gallery-photo gallery-photo-4">
          <img src="/assets/tcg-gallery-04.jpg" alt="Tri-City Generals tournament championship team" loading="lazy" />
          <figcaption>Compete prepared</figcaption>
        </figure>
        <figure class="gallery-photo gallery-photo-5">
          <img src="/assets/tcg-gallery-05.jpg" alt="Tri-City Generals baseball team with a trophy" loading="lazy" />
          <figcaption>Team culture</figcaption>
        </figure>
        <figure class="gallery-photo gallery-photo-6">
          <img src="/assets/tcg-gallery-06.jpg" alt="Athletes training together inside the Tri-City Generals facility" loading="lazy" />
          <figcaption>Inside the academy</figcaption>
        </figure>
      </div>
    </section>

    <section class="families container" id="areas">
      <div class="section-head">
        <h2>Training close to home</h2>
        <p>Explore baseball development options for families across Columbus, Phenix City, Fort Moore, and nearby communities.</p>
      </div>
      <div class="page-grid">
        {areas.slice(0, 3).map((area) => (
          <a class="page-card" href={`/areas/${area.slug}/`}>
            <span>Location</span>
            <strong>{area.name}</strong>
            <em>Baseball training options for families looking near {area.name}.</em>
            <span class="card-link">Explore the area <b aria-hidden="true">↗</b></span>
          </a>
        ))}
      </div>
    </section>

    {site.testimonials.length > 0 && (
      <section class="reviews container" id="reviews">
        <div class="section-head">
          <h2>What families say</h2>
          <p>Feedback from parents and players who train with {site.businessName}.</p>
        </div>
        <div class="review-grid">
          {site.testimonials.map((review) => (
            <figure class="review-card">
              <div class="review-stars" aria-hidden="true">★★★★★</div>
              <blockquote>“{review.quote}”</blockquote>
              <figcaption>
                <strong>{review.name}</strong>
                {review.source && <span>{review.source}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="season">
      <img src={defaultImages.pitching} alt="Tri-City Generals pitcher working through a training session" loading="lazy" />
      <div>
        <h2>High-performance summer training starts here</h2>
        <p>The Summer Training Academy runs May 26–July 15 for athletes ages 9+, with morning, afternoon, and evening schedules listed by the academy. Position-specific Legacy programs add focused work for hitters, pitchers, and catchers; availability varies by session.</p>
        <div class="detail-grid">
          <div><span>Academy schedule</span><strong>Monday–Thursday</strong></div>
          <div><span>Address</span><strong>{site.address}</strong></div>
          <div><span>Dates</span><strong>May 26–July 15, 2026</strong></div>
          <div><span>Email</span><strong>{site.email}</strong></div>
        </div>
        <a class="button season-button" href={site.registrationUrl} target="_blank" rel="noopener">View current sessions</a>
      </div>
    </section>

    <section class="find-us" id="find-us">
      <div class="find-copy">
        <h2>Built in Columbus. Serving the Tri-City area.</h2>
        <p>{site.businessName} trains athletes at {site.address}, serving families across Columbus, Phenix City, Fort Moore, and nearby communities.</p>
        <div class="find-areas">
          <span>Baseball training for families in</span>
          <ul>
            {areas.map((area) => (
              <li><a href={`/areas/${area.slug}/`}>{area.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <iframe title={`${site.businessName} map`} loading="lazy" src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}></iframe>
    </section>

    <section class="faq container" id="faq">
      <div class="section-head">
        <h2>Questions parents ask</h2>
        <p>Quick answers before you reach out. Anything else, call or email the academy or send the form below.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="contact-copy">
        <h2>Find the right program for your player.</h2>
        <p>Share what your player wants to improve. The academy can help match their age, schedule, and goals to the right next step.</p>
        <div class="contact-list">
          <div><span>Phone</span><a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a></div>
          <div><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
          <div><span>Address</span><strong>{site.address}</strong></div>
          <div><span>Schedule</span><strong>{site.hours}</strong></div>
        </div>
      </div>
      <LeadForm title="Ask about the right program" intro="Start with the basics. The academy can follow up with the most relevant next step." />
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 720px;
    display: grid;
    align-items: center;
    padding: 66px 0;
    color: var(--white);
    background: var(--primary-dark);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    animation: hero-image-in 1.1s cubic-bezier(.2,.8,.2,1) both;
  }

  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 5, 4, 0.94), rgba(5, 5, 4, 0.74) 52%, rgba(5, 5, 4, 0.28)),
      linear-gradient(0deg, rgba(214,169,40,0.18), transparent 42%);
  }

  .hero::after {
    content: "";
    position: absolute;
    right: -110px;
    bottom: -210px;
    width: 520px;
    height: 520px;
    border: 1px solid rgba(214,169,40,0.34);
    border-radius: 50%;
    box-shadow: 0 0 0 54px rgba(214,169,40,0.035), 0 0 0 108px rgba(214,169,40,0.025);
  }

  @keyframes hero-image-in {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }

  .hero-inner {
    position: relative;
    display: block;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-copy h1 {
    margin-top: var(--eyebrow-heading-gap);
    max-width: 760px;
    font-size: clamp(2.65rem, 5.6vw, 5rem);
    line-height: 0.9;
    font-style: italic;
    letter-spacing: -0.035em;
    animation: hero-copy-in 0.7s 0.12s cubic-bezier(.2,.8,.2,1) both;
  }

  .hero-copy p {
    margin-top: 24px;
    max-width: 610px;
    color: rgba(255,255,255,0.86);
    font-size: clamp(1.04rem, 1.8vw, 1.25rem);
    line-height: 1.7;
    animation: hero-copy-in 0.7s 0.24s cubic-bezier(.2,.8,.2,1) both;
  }

  .hero-copy .eyebrow,
  .hero-actions { animation: hero-copy-in 0.7s 0.04s cubic-bezier(.2,.8,.2,1) both; }

  .hero-actions { animation-delay: 0.36s; }

  @keyframes hero-copy-in {
    from { filter: blur(6px); transform: translateY(18px); }
    to { filter: blur(0); transform: translateY(0); }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .outline {
    border: 2px solid rgba(255,255,255,0.78);
    background: transparent;
    color: var(--white);
  }

  .hero .button.secondary {
    color: #090907;
  }

  .quick-proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--primary-dark);
    color: var(--white);
    border-top: 3px solid var(--primary);
  }

  .proof-item {
    min-height: 150px;
    padding: 30px clamp(18px, 3vw, 42px);
    border-right: 1px solid rgba(255,255,255,0.14);
  }

  .proof-item strong {
    display: block;
    font-family: "Barlow Condensed", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.3rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .proof-item span {
    display: block;
    margin-top: 10px;
    color: rgba(255,255,255,0.64);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .trust {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(44px, 8vw, 112px);
    padding: 88px 0;
  }

  .trust-intro > p {
    color: var(--primary);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .trust-intro h2 {
    margin-top: 14px;
    max-width: 520px;
    font-size: clamp(2.45rem, 4.8vw, 4.5rem);
    line-height: 0.92;
  }

  .trust-principles {
    border-top: 3px solid var(--primary);
  }

  .trust article {
    display: grid;
    grid-template-columns: minmax(150px, 0.55fr) minmax(0, 1fr);
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .trust h3 {
    font-size: 1.75rem;
    line-height: 1;
  }

  .program-card h3 {
    margin-top: 0;
    font-size: 2rem;
    line-height: 1;
  }

  .program-card p {
    margin-top: 12px;
    color: var(--muted);
    line-height: 1.65;
  }

  .trust article p {
    color: var(--muted);
    line-height: 1.65;
  }

  .programs,
  .families {
    padding: 92px 0;
  }

  .program-grid,
  .page-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .program-card,
  .page-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 100%;
    border-radius: 2px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.24s cubic-bezier(.2,.8,.2,1), border-color 0.24s ease;
  }

  .program-card:hover,
  .page-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
  }

  .program-card:active,
  .page-card:active {
    transform: translateY(-1px);
  }

  .program-card:focus-visible,
  .page-card:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 4px;
  }

  .program-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(.2,.8,.2,1), filter 0.3s ease;
  }

  .program-card:hover img {
    transform: scale(1.035);
    filter: contrast(1.04);
  }

  .program-card div {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }

  .photo-gallery {
    position: relative;
    overflow: hidden;
    padding: 96px 0;
    color: var(--white);
    background:
      linear-gradient(120deg, rgba(214,169,40,0.09), transparent 34%),
      var(--primary-dark);
  }

  .photo-gallery::before {
    content: "TCG";
    position: absolute;
    top: -0.24em;
    right: -0.04em;
    color: rgba(255,255,255,0.025);
    font-family: "Barlow Condensed", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(12rem, 28vw, 28rem);
    line-height: 0.8;
    pointer-events: none;
  }

  .gallery-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    align-items: end;
    gap: 42px;
    margin-bottom: 40px;
  }

  .gallery-head h2 {
    max-width: 780px;
    font-size: clamp(2.65rem, 5.8vw, 5.6rem);
    line-height: 0.88;
  }

  .gallery-head p {
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.28);
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
  }

  .gallery-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 220px 220px 280px;
    gap: 8px;
  }

  .gallery-photo {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255,255,255,0.12);
    background: #151511;
  }

  .gallery-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.72), transparent 48%);
    pointer-events: none;
  }

  .gallery-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(.2,.8,.2,1), filter 0.4s ease;
  }

  .gallery-photo:hover img {
    transform: scale(1.045);
    filter: saturate(1.08) contrast(1.04);
  }

  .gallery-photo figcaption {
    position: absolute;
    z-index: 1;
    right: 18px;
    bottom: 16px;
    left: 18px;
    color: var(--white);
    font-size: 0.73rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gallery-photo-1 { grid-column: 1 / span 4; grid-row: 1 / span 2; }
  .gallery-photo-2 { grid-column: 5 / span 5; grid-row: 1; }
  .gallery-photo-3 { grid-column: 10 / span 3; grid-row: 1; }
  .gallery-photo-4 { grid-column: 5 / span 4; grid-row: 2; }
  .gallery-photo-5 { grid-column: 9 / span 4; grid-row: 2; }
  .gallery-photo-6 { grid-column: 1 / -1; grid-row: 3; }

  .reviews {
    padding: 92px 0;
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .review-card {
    margin: 0;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--white);
  }

  .review-stars {
    color: var(--primary);
    font-size: 1.05rem;
    letter-spacing: 0.18em;
  }

  .review-card blockquote {
    margin: 16px 0 0;
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .review-card figcaption {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .review-card figcaption strong {
    display: block;
    font-weight: 850;
  }

  .review-card figcaption span {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .faq {
    padding: 92px 0;
  }

  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 860px;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--white);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 24px;
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 850;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 1.15rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary::after {
    content: "–";
    transform: rotate(180deg);
  }

  .faq-item > p {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--muted);
    line-height: 1.7;
  }

  .training-split,
  .season,
  .find-us,
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .training-copy,
  .season > div,
  .find-copy,
  .contact-copy {
    padding: clamp(52px, 7vw, 92px);
  }

  .training-copy {
    background: var(--primary-dark);
    color: var(--white);
  }

  .training-copy h2,
  .season h2,
  .find-copy h2,
  .contact h2 {
    font-size: clamp(2.05rem, 4vw, 3.75rem);
    line-height: 0.94;
  }

  .training-copy h2 {
    margin-top: var(--eyebrow-heading-gap);
  }

  .training-copy p,
  .season p,
  .find-copy p,
  .contact-copy p {
    margin-top: 18px;
    color: var(--muted);
    line-height: 1.75;
  }

  .training-copy p,
  .training-copy li {
    color: rgba(255,255,255,0.76);
  }

  .training-copy ul {
    display: grid;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .training-copy li {
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.16);
    font-weight: 800;
  }

  .training-split > img,
  .season > img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
  }

  .page-card {
    padding: 26px;
  }

  .page-card span,
  .detail-grid span,
  .contact-list span {
    display: block;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page-card strong {
    display: block;
    margin-top: 18px;
    font-family: "Barlow Condensed", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: 1.85rem;
